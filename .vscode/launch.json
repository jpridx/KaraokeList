{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KaraokeList (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/KaraokeList/bin/Debug/net10.0/KaraokeList.dll",
      "args": [],
      "cwd": "${workspaceFolder}/KaraokeList",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
