<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-KaraokeList-c18b707a-c37e-48aa-8c09-9a1896e75fd1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	    <PackageReference Include="Syncfusion.Blazor.Grid" Version="33.2.4" />
    <PackageReference Include="Syncfusion.Blazor.Calendars" Version="33.2.4" />
    <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="33.2.4" />
    <PackageReference Include="Syncfusion.Blazor.Inputs" Version="33.2.4" />
    <PackageReference Include="Syncfusion.Blazor.Buttons" Version="33.2.4" />
    <PackageReference Include="Syncfusion.Blazor.Navigations" Version="33.2.4" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="33.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KaraokeList.Shared\KaraokeList.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\scripts\azure-sql\*.sql">
      <Link>scripts\azure-sql\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  

</Project>
