@page "/songs"
@attribute [Authorize]
@rendermode InteractiveServer
@using KaraokeList.Data
@using Microsoft.AspNetCore.Authorization
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Inputs
@inject SongService SongService
@inject ArtistLookupService ArtistLookupService

<PageTitle>Songs</PageTitle>

<h3>Songs</h3>
<div class="songs-container">
    @if (isLoading)
    {
        <div>Loading...</div>
    }
    else if (songs.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            <strong>No songs found.</strong> Add artists/genres first, or run the SQLite → SQL migration tool once to seed catalog data.
        </div>
    }

    @if (!isLoading)
    {
        <SfGrid @ref="Grid" DataSource="@songs"
                AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowSelection="true"
                Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel", "Search" })">
            <GridEvents TValue="SongDisplay" OnActionBegin="OnActionBegin"></GridEvents>
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Normal"></GridEditSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
            <GridPageSettings PageSizes="true"></GridPageSettings>
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Type="Syncfusion.Blazor.Grids.ColumnType.CheckBox" Width="50"></GridColumn>
                <GridColumn Field="Id" HeaderText="ID" IsPrimaryKey="true" Visible="false" Width="50" TextAlign="TextAlign.Right" ValidationRules="@(new ValidationRules{ Required=true })" />
                <GridColumn Field="Title" HeaderText="Title" Width="200" ValidationRules="@(new ValidationRules{ Required=true })" />
                <GridColumn Field="ArtistName" HeaderText="Artist" Width="200">
                    <Template Context="context">
                        @{
                            var song = context as SongDisplay;
                        }
                        <span>@song?.ArtistName</span>
                    </Template>
                    <EditTemplate Context="context">
                        @{
                            var song = context as SongDisplay;
                        }
                        <SfAutoComplete TValue="string" TItem="ArtistLookup" DataSource="@artistLookups" @bind-Value="song!.ArtistName" Placeholder="Search artist...">
                            <AutoCompleteFieldSettings Value="Name" Text="Name" />
                        </SfAutoComplete>
                    </EditTemplate>
                </GridColumn>
                <GridColumn Field="Genre" HeaderText="Genre" EditType="EditType.DropDownEdit" Width="150" />
                <GridColumn Field="Year" HeaderText="Year" EditType="EditType.NumericEdit" Width="100" />
                <GridColumn Field="SecondaryArtist" HeaderText="Secondary Artist" EditType="EditType.DropDownEdit" Width="150" />
            </GridColumns>
        </SfGrid>
    }
</div>

<style>
.songs-container {
    max-width: 1200px;
    margin: 32px auto 32px auto;
    padding: 24px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    border-radius: 8px;
}
</style>

@code {
    private List<SongDisplay> songs = new();
    private List<ArtistLookup> artistLookups = new();
    private SfGrid<SongDisplay> Grid = default!;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            artistLookups = await ArtistLookupService.GetArtistLookupsAsync();
            await LoadSongsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSongsAsync()
    {
        var rawSongs = await SongService.GetSongsAsync();
        songs = rawSongs.Select(s => new SongDisplay
        {
            Id = s.Id,
            Title = s.Title,
            Artist = s.Artist,
            ArtistName = artistLookups.FirstOrDefault(a => a.Id == s.Artist)?.Name ?? "",
            Genre = s.Genre,
            Year = s.Year,
            SecondaryArtist = s.SecondaryArtist
        }).ToList();
        StateHasChanged();
        if (Grid is not null)
        {
            await Grid.Refresh();
        }
    }

    private async Task OnActionBegin(ActionEventArgs<SongDisplay> args)
    {
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save)
        {
            if (args.Data != null)
            {
                args.Data.Artist = artistLookups.FirstOrDefault(a => a.Name == args.Data.ArtistName)?.Id;

                if (args.Data.Id <= 0)
                {
                    await SongService.AddSongAsync(args.Data);
                }
                else
                {
                    await SongService.UpdateSongAsync(args.Data);
                }

                await LoadSongsAsync();
            }
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Delete)
        {
            if (args.Data != null)
            {
                await SongService.DeleteSongAsync(args.Data.Id);
                await LoadSongsAsync();
            }
        }
    }

    public class SongDisplay : Song
    {
        public string ArtistName { get; set; } = string.Empty;
    }
}
