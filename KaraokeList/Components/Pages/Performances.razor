@page "/performances"
@attribute [Authorize]
@rendermode InteractiveServer
@using KaraokeList.Data
@using KaraokeList.Shared
@using Microsoft.AspNetCore.Authorization
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.DropDowns
@inject PerformanceService PerformanceService
@inject SingerService SingerService
@inject SongService SongService
@inject VenueService VenueService
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Performances</PageTitle>

<h3>Performances</h3>
<p class="text-muted">Log each time you sing a song. One row per performance — not a running count.</p>

@if (!isLoading)
{
    @if (singers.Count == 0 || songs.Count == 0 || venues.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Setup required:</strong> Create at least one singer, song, and venue before logging performances.
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">About a song (you)</h5>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Song</label>
                        <SfDropDownList TValue="int?" TItem="Song" DataSource="@songs" @bind-Value="summarySongId"
                                        Placeholder="Pick a song" AllowFiltering="true"
                                        FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                            <DropDownListFieldSettings Value="Id" Text="Title" />
                        </SfDropDownList>
                    </div>
                    <div class="col-md-6">
                        <button class="btn btn-outline-primary" disabled="@(summarySongId is null || mySingerId is null)" @onclick="LoadSummaryAsync">Show history</button>
                    </div>
                </div>

                @if (mySingerId is null)
                {
                    <p class="text-muted mt-3 mb-0">Your login is not linked to a singer profile yet.</p>
                }
                else if (summarySongId is null)
                {
                    <p class="text-muted mt-3 mb-0">Choose a song to see your performance history.</p>
                }
                else if (songSummary is { PerformanceCount: > 0 })
                {
                    <ul class="mt-3 mb-2">
                        <li><strong>Times sung:</strong> @songSummary.PerformanceCount</li>
                        <li><strong>Last time:</strong> @songSummary.LastPerformedOn?.ToString("d") at @(songSummary.LastVenueName ?? "unknown venue")</li>
                        <li><strong>Last key:</strong> @KeyChangeFormatting.Describe(songSummary.LastKeyChangeSemitones)</li>
                    </ul>
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Date</th><th>Venue</th><th>Key</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in songSummary.History)
                            {
                                <tr>
                                    <td>@entry.PerformedOn.ToString("d")</td>
                                    <td>@entry.VenueName</td>
                                    <td>@KeyChangeFormatting.Describe(entry.KeyChangeSemitones)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (songSummary is not null)
                {
                    <p class="mt-3 mb-0">No performances logged for this song yet.</p>
                }
            </div>
        </div>

        <div class="performances-container">
            <SfGrid @ref="Grid" DataSource="@performances" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
                    Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel", "Search" })">
                <GridEvents TValue="Performance" OnActionBegin="OnActionBegin"></GridEvents>
                <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Normal"></GridEditSettings>
                <GridColumns>
                    <GridColumn Field="Id" IsPrimaryKey="true" Visible="false" />
                    <GridColumn Field="Singer" HeaderText="Singer" Width="180">
                        <Template Context="context">
                            @{
                                var row = context as Performance;
                                var name = singers.FirstOrDefault(s => s.Id == row?.Singer)?.Name ?? "";
                            }
                            <span>@name</span>
                        </Template>
                        <EditTemplate Context="context">
                            @{
                                var row = (context as Performance)!;
                            }
                            <SfDropDownList TValue="int?" TItem="Singer" DataSource="@singers" @bind-Value="row.Singer"
                                            AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="Song" HeaderText="Song" Width="220">
                        <Template Context="context">
                            @{
                                var row = context as Performance;
                                var title = songs.FirstOrDefault(s => s.Id == row?.Song)?.Title ?? "";
                            }
                            <span>@title</span>
                        </Template>
                        <EditTemplate Context="context">
                            @{
                                var row = (context as Performance)!;
                            }
                            <SfDropDownList TValue="int?" TItem="Song" DataSource="@songs" @bind-Value="row.Song"
                                            AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                                <DropDownListFieldSettings Value="Id" Text="Title" />
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="Venue" HeaderText="Venue" Width="180">
                        <Template Context="context">
                            @{
                                var row = context as Performance;
                                var venueName = venues.FirstOrDefault(v => v.Id == row?.Venue)?.VenueName ?? "";
                            }
                            <span>@venueName</span>
                        </Template>
                        <EditTemplate Context="context">
                            @{
                                var row = (context as Performance)!;
                            }
                            <SfDropDownList TValue="int?" TItem="Venue" DataSource="@venues" @bind-Value="row.Venue"
                                            AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                                <DropDownListFieldSettings Value="Id" Text="VenueName" />
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="PerformedOn" HeaderText="Date" EditType="EditType.DatePickerEdit" Format="d" Type="Syncfusion.Blazor.Grids.ColumnType.Date" Width="120" />
                    <GridColumn Field="KeyChangeSemitones" HeaderText="Key change" Width="160">
                        <Template Context="context">
                            @{
                                var row = context as Performance;
                            }
                            <span>@KeyChangeFormatting.Describe(row?.KeyChangeSemitones)</span>
                        </Template>
                        <EditTemplate Context="context">
                            @{
                                var row = (context as Performance)!;
                            }
                            <SfDropDownList TValue="int?" TItem="PerformanceKeyOption" DataSource="@keyOptions" @bind-Value="row.KeyChangeSemitones">
                                <DropDownListFieldSettings Value="Semitones" Text="Label" />
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    }
}

@code {
    private List<Performance> performances = [];
    private List<Singer> singers = [];
    private List<Song> songs = [];
    private List<Venue> venues = [];
    private IReadOnlyList<PerformanceKeyOption> keyOptions = PerformanceKeyOption.Choices;
    private SfGrid<Performance> Grid = default!;
    private bool isLoading = true;
    private int? mySingerId;
    private int? summarySongId;
    private SongPerformanceSummary? songSummary;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        mySingerId = user?.SingerId;

        singers = await SingerService.GetSingersAsync();
        songs = await SongService.GetSongsAsync();
        venues = await VenueService.GetVenuesAsync();
        performances = await PerformanceService.GetPerformancesAsync(mySingerId);
        isLoading = false;
    }

    private async Task LoadSummaryAsync()
    {
        if (summarySongId is null || mySingerId is null)
        {
            return;
        }

        songSummary = await PerformanceService.GetSongPerformanceSummaryAsync(mySingerId.Value, summarySongId.Value);
        StateHasChanged();
    }

    private async Task OnActionBegin(ActionEventArgs<Performance> args)
    {
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Add && args.Data is not null)
        {
            args.Data.PerformedOn = DateTime.Today;
            if (mySingerId is int singerId)
            {
                args.Data.Singer = singerId;
            }
        }

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save && args.Data is not null)
        {
            if (args.Data.KeyChangeSemitones == 0)
            {
                args.Data.KeyChangeSemitones = null;
            }

            if (args.Data.Id <= 0)
            {
                await PerformanceService.AddPerformanceAsync(args.Data);
            }
            else
            {
                await PerformanceService.UpdatePerformanceAsync(args.Data);
            }

            performances = await PerformanceService.GetPerformancesAsync();
            if (summarySongId == args.Data.Song)
            {
                await LoadSummaryAsync();
            }
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Delete && args.Data is not null)
        {
            await PerformanceService.DeletePerformanceAsync(args.Data.Id);
            performances = await PerformanceService.GetPerformancesAsync();
            if (summarySongId == args.Data.Song)
            {
                await LoadSummaryAsync();
            }
        }
    }
}

<style>
.performances-container {
    max-width: 1400px;
    margin: 32px auto;
    padding: 24px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    border-radius: 8px;
}
</style>
