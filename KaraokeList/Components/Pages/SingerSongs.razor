@page "/singer-songs"
@attribute [Authorize]
@rendermode InteractiveServer
@using KaraokeList.Data
@using Microsoft.AspNetCore.Authorization
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.DropDowns
@inject SingerSongService SingerSongService
@inject SingerService SingerService
@inject SongService SongService
@inject VenueService VenueService

<PageTitle>Singer Songs</PageTitle>

<h3>Singer Songs</h3>
<div class="singer-songs-container">
    @if (!isLoading)
    {
        @if (singers.Count == 0 || songs.Count == 0 || venues.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                <strong>Setup Required:</strong> Please create at least one singer, song, and venue before managing singer songs.
            </div>
        }
        else
        {
            <SfGrid @ref="Grid" DataSource="@singerSongs"
                    AllowPaging="true"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowSelection="true"
                    Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel", "Search" })">
                <GridEvents TValue="SingerSong" OnActionBegin="OnActionBegin"></GridEvents>
                <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Normal"></GridEditSettings>
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
                <GridPageSettings PageSizes="true"></GridPageSettings>
                <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
                <GridColumns>
                    <GridColumn Type="Syncfusion.Blazor.Grids.ColumnType.CheckBox" Width="50"></GridColumn>
                    <GridColumn Field="Id" HeaderText="ID" IsPrimaryKey="true" Visible="false" Width="50" TextAlign="TextAlign.Right" ValidationRules="@(new ValidationRules{ Required=true })" />
                    <GridColumn Field="Singer" HeaderText="Singer" Width="150">
                        <Template Context="context">
                            @{
                                var singerSong = context as SingerSong;
                                var singerName = singers.FirstOrDefault(s => s.Id == singerSong?.Singer)?.Name ?? "";
                            }
                            <span>@singerName</span>
                        </Template>
                        <EditTemplate Context="context">
                            @{
                                var singerSong = (context as SingerSong)!;
                            }
                            <SfDropDownList TValue="int?" TItem="Singer" DataSource="@singers" @bind-Value="singerSong.Singer">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="Song" HeaderText="Song" Width="150">
                        <Template Context="context">
                            @{
                                var singerSong = context as SingerSong;
                                var songTitle = songs.FirstOrDefault(s => s.Id == singerSong?.Song)?.Title ?? "";
                            }
                            <span>@songTitle</span>
                        </Template>
                        <EditTemplate Context="context">
                            @{
                                var singerSong = (context as SingerSong)!;
                            }
                            <SfDropDownList TValue="int?" TItem="Song" DataSource="@songs" @bind-Value="singerSong.Song">
                                <DropDownListFieldSettings Value="Id" Text="Title" />
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="Venue" HeaderText="Venue" Width="150">
                        <Template Context="context">
                            @{
                                var singerSong = context as SingerSong;
                                var venueName = venues.FirstOrDefault(v => v.Id == singerSong?.Venue)?.VenueName ?? "";
                            }
                            <span>@venueName</span>
                        </Template>
                        <EditTemplate Context="context">
                            @{
                                var singerSong = (context as SingerSong)!;
                            }
                            <SfDropDownList TValue="int?" TItem="Venue" DataSource="@venues" @bind-Value="singerSong.Venue">
                                <DropDownListFieldSettings Value="Id" Text="VenueName" />
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="FirstSung" HeaderText="First Sung" EditType="EditType.DatePickerEdit" Format="d" Type="Syncfusion.Blazor.Grids.ColumnType.Date" Width="120" />
                    <GridColumn Field="LastSung" HeaderText="Last Sung" EditType="EditType.DatePickerEdit" Format="d" Type="Syncfusion.Blazor.Grids.ColumnType.Date" Width="120" />
                    <GridColumn Field="Count" HeaderText="Count" EditType="EditType.NumericEdit" Width="80" />
                </GridColumns>
            </SfGrid>
        }
    }
    else
    {
        <div class="text-muted">Loading...</div>
    }
</div>

<style>
.singer-songs-container {
    max-width: 1400px;
    margin: 32px auto 32px auto;
    padding: 24px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    border-radius: 8px;
}
</style>

@code {
    private List<SingerSong> singerSongs = new();
    private List<Singer> singers = new();
    private List<Song> songs = new();
    private List<Venue> venues = new();
    private SfGrid<SingerSong> Grid = default!;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            singerSongs = await SingerSongService.GetSingerSongsAsync();
            singers = await SingerService.GetSingersAsync();
            songs = await SongService.GetSongsAsync();
            venues = await VenueService.GetVenuesAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnActionBegin(ActionEventArgs<SingerSong> args)
    {
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save)
        {
            if (args.Data != null)
            {
                if (args.Data.Id <= 0)
                {
                    await SingerSongService.AddSingerSongAsync(args.Data);
                }
                else
                {
                    await SingerSongService.UpdateSingerSongAsync(args.Data);
                }
                singerSongs = await SingerSongService.GetSingerSongsAsync();
                StateHasChanged();
            }
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Delete)
        {
            if (args.Data != null)
            {
                await SingerSongService.DeleteSingerSongAsync(args.Data.Id);
                singerSongs = await SingerSongService.GetSingerSongsAsync();
                StateHasChanged();
            }
        }
    }
}
