@page "/register"

<PageTitle>Register</PageTitle>

@if (loading)
{
    <p class="text-muted">Loading…</p>
}
else if (registrationInfo is null)
{
    <h3>Register</h3>
    <div class="alert alert-danger">Could not load registration settings. Is the API running?</div>
}
else if (!registrationInfo.IsRegistrationOpen)
{
    <h3>Registration closed</h3>
    <p class="text-muted">New accounts are not being accepted. If you already have an account, <a href="login">sign in</a>.</p>
}
else
{
    <h3>Register</h3>
    <p class="text-muted small mb-3">First sign-in after idle may take up to a minute while the database wakes up.</p>
    @if (registrationInfo.RequiresInviteCode)
    {
        <p class="text-muted">Invite-only. You need the private invite code from the site owner.</p>
    }

    @if (isSubmitting)
    {
        <div class="alert alert-info mb-3">@ApiTransientFailure.ColdStartInProgressMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert @(errorIsTransient ? "alert-warning" : "alert-danger")">@errorMessage</div>
    }

    <EditForm Model="Input" OnValidSubmit="RegisterAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Your name (as a singer)</label>
            <InputText class="form-control" @bind-Value="Input.Name" />
            <ValidationMessage For="@(() => Input.Name)" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="Input.Email" />
        </div>
        @if (registrationInfo.RequiresInviteCode)
        {
            <div class="mb-3">
                <label class="form-label">Invite code</label>
                <InputText class="form-control" @bind-Value="Input.InviteCode" autocomplete="off" />
            </div>
        }
        <div class="mb-3">
            <label class="form-label">Password</label>
            <InputText type="password" class="form-control" @bind-Value="Input.Password" />
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm password</label>
            <InputText type="password" class="form-control" @bind-Value="Input.ConfirmPassword" />
        </div>
        <div class="registration-honeypot" aria-hidden="true">
            <label>Website</label>
            <InputText @bind-Value="Input.Website" />
        </div>
        <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
            @(isSubmitting ? "Creating account…" : "Create account")
        </button>
    </EditForm>

    <ExternalLoginButtons Providers="externalProviders"
                          ApiBaseUrl="@apiBaseUrl"
                          Invite="@Input.InviteCode" />
}

@code {
    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    [Inject]
    private JwtAuthenticationStateProvider AuthProvider { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private HttpClient Http { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Invite { get; set; }

    private RegisterRequest Input { get; set; } = new();
    private RegistrationInfoDto? registrationInfo;
    private ExternalAuthProvidersDto? externalProviders;
    private string apiBaseUrl = string.Empty;
    private string? errorMessage;
    private bool errorIsTransient;
    private bool isSubmitting;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        apiBaseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
        registrationInfo = await Api.GetRegistrationInfoAsync();
        externalProviders = await Api.GetExternalAuthProvidersAsync();
        if (!string.IsNullOrWhiteSpace(Invite))
        {
            Input.InviteCode = Invite;
        }

        loading = false;
    }

    private async Task RegisterAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        errorIsTransient = false;

        try
        {
            var result = await Api.RegisterAsync(Input);
            if (!result.Succeeded || result.Response is null)
            {
                errorMessage = result.ErrorMessage ?? "Registration failed. Check password rules and invite code.";
                errorIsTransient = result.IsTransientFailure;
                return;
            }

            await AuthProvider.MarkUserAsAuthenticatedAsync(result.Response.Token);
            NavigationManager.NavigateTo("/");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
