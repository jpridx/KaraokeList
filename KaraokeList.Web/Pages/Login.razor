@page "/login"

<PageTitle>Login</PageTitle>

<h3>Login</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="Input" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="Input.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText type="password" class="form-control" @bind-Value="Input.Password" />
    </div>
    <button class="btn btn-primary" type="submit">Sign in</button>
</EditForm>

@code {
    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    [Inject]
    private JwtAuthenticationStateProvider AuthProvider { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private LoginRequest Input { get; set; } = new();
    private string? errorMessage;

    private async Task LoginAsync()
    {
        var response = await Api.LoginAsync(Input);
        if (response is null)
        {
            errorMessage = "Invalid login attempt.";
            return;
        }

        await AuthProvider.MarkUserAsAuthenticatedAsync(response.Token);
        NavigationManager.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
    }
}
