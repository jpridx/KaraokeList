@page "/login"

<PageTitle>Login</PageTitle>

<h3>Login</h3>

<p class="text-muted small mb-3">First sign-in after idle may take up to a minute while the database wakes up.</p>

@if (isSubmitting)
{
    <div class="alert alert-info mb-3">@ApiTransientFailure.ColdStartInProgressMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert @(errorIsTransient ? "alert-warning" : "alert-danger")">@errorMessage</div>
}

<EditForm Model="Input" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="Input.Email" disabled="@isSubmitting" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText type="password" class="form-control" @bind-Value="Input.Password" disabled="@isSubmitting" />
    </div>
    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
        @(isSubmitting ? "Signing in…" : "Sign in")
    </button>
</EditForm>

@code {
    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    [Inject]
    private JwtAuthenticationStateProvider AuthProvider { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private LoginRequest Input { get; set; } = new();
    private string? errorMessage;
    private bool errorIsTransient;
    private bool isSubmitting;

    private async Task LoginAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        errorIsTransient = false;

        try
        {
            var result = await Api.LoginAsync(Input);
            if (!result.Succeeded || result.Response is null)
            {
                errorMessage = result.ErrorMessage ?? "Invalid login attempt.";
                errorIsTransient = result.IsTransientFailure;
                return;
            }

            await AuthProvider.MarkUserAsAuthenticatedAsync(result.Response.Token);
            NavigationManager.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
