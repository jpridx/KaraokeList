@page "/my-songs"
@attribute [Authorize]

<SingerGatedPage DocumentTitle="My Songs"
                 Title="My Songs"
                 WithBottomNav="true"
                 OnResolved="LoadListsAsync"
                 @ref="gatedPage">
    <Subtitle>Browse your lists. Tap for details, or <strong>Log</strong> to record a performance.</Subtitle>
    <HeaderContent>
        <StatusAlerts SuccessMessage="@addSongMessage" Small="true" CssClass="mb-0 mt-3" />
    </HeaderContent>
    <ChildContent Context="singerId">
        <MobileLoadingState IsLoading="@isLoading" DetailMessage="@loadingStep" CssClass="mt-3">
                <OfflineCacheNotice UsingOffline="@usingOfflineLists"
                                    HasCachedData="@hasCachedLists"
                                    CachedAt="@listsCachedAt"
                                    ResourceName="lists"
                                    RefreshHint="Connect to refresh or edit lists.">
                    <UnavailableContent>
                        Lists aren't available offline yet. Open My Songs once while online to cache them.
                    </UnavailableContent>
                </OfflineCacheNotice>

                <ChipFilterBar Label="List" Items="@listChipItems" />

                @if (SupportsCatalogAdd && !usingOfflineLists && CurrentList is not null)
                {
                    <div class="mobile-toolbar">
                        <AddSongToListPanel @ref="addSongPanel" @key="listKind"
                                            ListId="@CurrentList.Id" ListDisplayName="@CurrentList.DisplayName"
                                            OnSongAdded="OnSongAddedToListAsync" />
                    </div>
                }

                <MobileSearchToolbar @bind-SearchText="searchText" @bind-SearchText:after="RefreshDisplayList"
                                     Placeholder="Search title or artist"
                                     Count="@displaySongs.Count" CountNoun="song" />

                <MySongsSortToolbar @bind-SortBy="sortBy" SortDir="@sortDir"
                                    OnSortChanged="OnSortFieldChangedAsync"
                                    OnToggleSortDir="ToggleSortDirAsync"
                                    ShowGenreFilters="@showGenreFilters"
                                    OnToggleGenreFilters="ToggleGenreFiltersAsync" />

                @if (showGenreFilters)
                {
                    <ChipFilterBar Label="Genre" Items="@genreChipItems">
                        <FooterContent>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="groupByGenre"
                                       @bind="groupByGenre" @bind:after="ResetGroupedPaging" />
                                <label class="form-check-label" for="groupByGenre">Group by genre</label>
                            </div>
                        </FooterContent>
                    </ChipFilterBar>
                }

                <StatusAlerts ErrorMessage="@loadError" />

                @if (string.IsNullOrEmpty(loadError) && !FilteredSongs.Any())
                {
                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <MobileEmptyState Message="No songs match your search." />
                    }
                    else
                    {
                        <MobileEmptyState Message="@EmptyListMessage">
                            @if (!usingOfflineLists)
                            {
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    @if (listKind == SingerListKind.MyRepertoire)
                                    {
                                        <a class="btn btn-outline-primary btn-sm" href="import-repertoire">Import from spreadsheet</a>
                                    }
                                    @if (SupportsCatalogAdd)
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenAddFromCatalogAsync">
                                            + Add from catalog
                                        </button>
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenAddNewSongAsync">
                                            + New song
                                        </button>
                                    }
                                </div>
                            }
                        </MobileEmptyState>
                    }
                }
                else if (string.IsNullOrEmpty(loadError) && groupByGenre)
                {
                    <MySongsGroupedList PagingView="@groupedPagingView"
                                        TotalCount="@displaySongs.Count"
                                        OnLoadMore="LoadMoreGroupedSongs"
                                        OnHistory="GoToHistoryAsync"
                                        OnLog="GoToLogAsync" />
                }
                else if (string.IsNullOrEmpty(loadError))
                {
                    <Virtualize TItem="RepertoireSongDto" Items="@displaySongs" ItemSize="88" OverscanCount="6">
                        <SongListItem Song="@context" OnHistory="GoToHistoryAsync" OnLog="GoToLogAsync" />
                    </Virtualize>
                }
        </MobileLoadingState>
    </ChildContent>
</SingerGatedPage>
