@page "/my-songs"

@attribute [Authorize]

@inject IKaraokeApiClient Api

@inject IMySongsLocalStore MySongsStore

@inject IMySongsLoader MySongsLoader

@inject NavigationManager Navigation

@using KaraokeList.Shared



<PageTitle>My Songs</PageTitle>



<div class="mobile-page">

    <header class="mobile-page-header">

        <h1 class="h4 mb-1">My Songs</h1>

        <p class="text-muted small mb-0">Browse your lists. Tap for details, or <strong>Log</strong> to record a performance.</p>

    </header>



    @if (isLoading)

    {

        <p class="mt-3">Loading...</p>

    }

    else

    {

        <SingerLinkPanel Visible="needsSingerLink" OnLinked="OnSingerLinkedAsync" />



        @if (!needsSingerLink)

        {

            @if (usingOfflineLists && listsCachedAt is DateTime cachedAt)
            {
                <div class="alert alert-warning small mb-3" role="status">
                    Using cached lists from @cachedAt.ToLocalTime().ToString("g").
                    Connect to refresh or edit lists.
                </div>
            }
            else if (usingOfflineLists && !hasCachedLists)
            {
                <div class="alert alert-warning small mb-3" role="status">
                    Lists aren't available offline yet. Open My Songs once while online to cache them.
                </div>
            }

            <div class="mobile-toolbar">

                <label class="form-label small text-muted mb-1">List</label>

                <div class="genre-chips">

                    @foreach (var list in singerLists)

                    {

                        <button type="button" class="genre-chip @(listKind == list.Kind ? "active" : "")"

                                @onclick="() => SetListKindAsync(list.Kind)">@list.DisplayName</button>

                    }

                </div>

            </div>

            @if (SupportsCatalogAdd && !usingOfflineLists)
            {
                <div class="mobile-toolbar">
                    @if (!showAddSong)
                    {
                        <button type="button" class="btn btn-link btn-sm ps-0" @onclick="OpenAddSongPanelAsync">+ Add song</button>
                    }
                    else
                    {
                        <CatalogSongPicker Items="catalogPickerItems" @bind-SelectedSongId="addSongId" />
                        @if (!string.IsNullOrEmpty(addSongError))
                        {
                            <p class="small text-danger mt-2 mb-0">@addSongError</p>
                        }
                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-primary btn-sm" disabled="@(addSongId is null || isAddingSong)" @onclick="ConfirmAddSongAsync">Add to list</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseAddSongPanel">Cancel</button>
                        </div>
                    }
                </div>
            }

            <div class="mobile-toolbar">

                <input class="form-control" placeholder="Search title or artist"

                       @bind="searchText" @bind:event="oninput" @bind:after="RefreshDisplayList" />

                @if (displaySongs.Count > 0)

                {

                    <p class="small text-muted mb-0 mt-2">@displaySongs.Count song@(displaySongs.Count == 1 ? "" : "s")</p>

                }

            </div>



            <div class="mobile-toolbar">

                <label class="form-label small text-muted mb-1">Sort</label>

                <select class="form-select" @bind="sortBy" @bind:after="ReloadAsync">

                    <option value="lastPerformed">Last performed</option>

                    <option value="title">Song title</option>

                    <option value="artist">Artist</option>

                    <option value="genre">Genre</option>

                </select>

                <button type="button" class="btn btn-outline-secondary btn-sm mt-2"

                        @onclick="ToggleSortDirAsync" title="Toggle sort direction">

                    @(sortDir == "desc" ? "↓ Newest / Z–A" : "↑ Oldest / A–Z")

                </button>

            </div>



            <div class="mobile-toolbar">

                <button type="button" class="btn btn-link btn-sm ps-0" @onclick="ToggleGenreFiltersAsync">

                    @(showGenreFilters ? "Hide genre filters" : "Show genre filters")

                </button>

            </div>



            @if (showGenreFilters)

            {

                <div class="mobile-toolbar">

                    <label class="form-label small text-muted mb-1">Genre</label>

                    <div class="genre-chips">

                        <button type="button" class="genre-chip @(filterGenreId is null ? "active" : "")"

                                @onclick="() => SetGenreFilterAsync(null)">All</button>

                        @foreach (var genre in filterGenres)

                        {

                            <button type="button" class="genre-chip @(filterGenreId == genre.Id ? "active" : "")"

                                    @onclick="() => SetGenreFilterAsync(genre.Id)">@genre.GenreName</button>

                        }

                    </div>

                    <div class="form-check mt-2">

                        <input class="form-check-input" type="checkbox" id="groupByGenre"

                               @bind="groupByGenre" @bind:after="ResetGroupedPaging" />

                        <label class="form-check-label" for="groupByGenre">Group by genre</label>

                    </div>

                </div>

            }



            @if (!string.IsNullOrEmpty(loadError))

            {

                <p class="text-danger">@loadError</p>

            }

            else if (!FilteredSongs.Any())

            {

                <div class="empty-state">

                    @if (!string.IsNullOrWhiteSpace(searchText))

                    {

                        <p>No songs match your search.</p>

                    }

                    else

                    {

                        <p>@EmptyListMessage</p>
                        @if (SupportsCatalogAdd && !usingOfflineLists)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="OpenAddSongPanelAsync">
                                Search catalog to add
                            </button>
                        }

                    }

                </div>

            }

            else if (groupByGenre)

            {

                @foreach (var group in VisibleGroupedSongs)

                {

                    <h2 class="repertoire-group-heading">@group.Key</h2>

                    @foreach (var song in group.Songs)

                    {

                        <SongListItem Song="song" OnHistory="GoToHistoryAsync" OnLog="GoToLogAsync" />

                    }

                }

                @if (HasMoreGroupedSongs)

                {

                    <button type="button" class="btn btn-outline-primary w-100 mt-2" @onclick="LoadMoreGroupedSongs">

                        Load more (@VisibleGroupedSongCount of @displaySongs.Count)

                    </button>

                }

            }

            else

            {

                <Virtualize TItem="RepertoireSongDto" Items="displaySongs" ItemSize="88" OverscanCount="6">

                    <SongListItem Song="context" OnHistory="GoToHistoryAsync" OnLog="GoToLogAsync" />

                </Virtualize>

            }

        }

    }

</div>



@code {

    private bool isLoading = true;

    private bool needsSingerLink;

    private bool usingOfflineLists;

    private bool hasCachedLists;

    private DateTime? listsCachedAt;

    private string? loadError;

    private List<RepertoireSongDto> songs = [];

    private List<SingerListDto> singerLists = [];

    private List<GenreDto> filterGenres = [];

    private string searchText = string.Empty;

    private string sortBy = "lastPerformed";

    private string sortDir = "desc";

    private int? filterGenreId;

    private bool groupByGenre;

    private bool showGenreFilters;

    private SingerListKind listKind = SingerListKind.MyRepertoire;

    private List<RepertoireSongDto> displaySongs = [];

    private int visibleGroupedLimit = PageSize;

    private bool showAddSong;
    private bool isAddingSong;
    private int? addSongId;
    private string? addSongError;
    private List<LogSongPickItem> catalogPickerItems = [];

    private const int PageSize = 40;

    private bool SupportsCatalogAdd =>
        listKind is SingerListKind.WantToSing or SingerListKind.WorkingUp;



    private IEnumerable<RepertoireSongDto> FilteredSongs =>

        RepertoireSearch.Filter(songs, searchText);



    private string EmptyListMessage => listKind switch

    {

        SingerListKind.WantToSing => "No songs on your want-to-sing list yet.",

        SingerListKind.WorkingUp => "No songs on your working-up list yet.",

        _ => "No songs on your repertoire yet."

    };



    private IEnumerable<IGrouping<string, RepertoireSongDto>> GroupedSongs =>

        displaySongs.GroupBy(s => string.IsNullOrWhiteSpace(s.GenreName) ? "(No genre)" : s.GenreName)

            .OrderBy(g => g.Key);



    private IReadOnlyList<GroupedSongSection> VisibleGroupedSongs

    {

        get

        {

            var sections = new List<GroupedSongSection>();

            var remaining = visibleGroupedLimit;



            foreach (var group in GroupedSongs)

            {

                if (remaining <= 0)

                {

                    break;

                }



                var groupSongs = group.Take(remaining).ToList();

                if (groupSongs.Count == 0)

                {

                    continue;

                }



                sections.Add(new GroupedSongSection(group.Key, groupSongs));

                remaining -= groupSongs.Count;

            }



            return sections;

        }

    }



    private int VisibleGroupedSongCount => VisibleGroupedSongs.Sum(g => g.Songs.Count);



    private bool HasMoreGroupedSongs => VisibleGroupedSongCount < displaySongs.Count;



    protected override async Task OnInitializedAsync()

    {

        showGenreFilters = await MySongsStore.GetShowGenreFiltersAsync();

        listKind = await MySongsStore.GetListKindAsync();

        await ReloadAsync();

    }



    private async Task OnSingerLinkedAsync(int? singerId)

    {

        needsSingerLink = false;

        await ReloadAsync();

    }



    private async Task ReloadAsync()

    {

        isLoading = true;

        loadError = null;

        usingOfflineLists = false;

        hasCachedLists = false;

        listsCachedAt = null;



        var result = await MySongsLoader.LoadAsync(listKind, sortBy, sortDir, filterGenreId);

        usingOfflineLists = result.FromCache;

        hasCachedLists = result.HasCache;

        listsCachedAt = result.CachedAtUtc;



        if (result.NeedsSingerLink)

        {

            needsSingerLink = true;

            loadError = result.ErrorMessage;

            isLoading = false;

            return;

        }



        if (!string.IsNullOrEmpty(result.ErrorMessage))

        {

            loadError = result.ErrorMessage;

            isLoading = false;

            return;

        }



        singerLists = result.Lists.ToList();

        var selectedList = singerLists.FirstOrDefault(l => l.Kind == listKind)

            ?? singerLists.FirstOrDefault(l => l.Kind == SingerListKind.MyRepertoire);

        if (selectedList is null)

        {

            loadError = "Could not load your singer lists.";

            isLoading = false;

            return;

        }



        listKind = selectedList.Kind;

        songs = result.Songs.ToList();

        needsSingerLink = false;



        if (filterGenreId is null)

        {

            filterGenres = result.FilterGenres.ToList();

        }



        RefreshDisplayList();

        isLoading = false;

    }



    private void RefreshDisplayList()

    {

        displaySongs = FilteredSongs.ToList();

        visibleGroupedLimit = PageSize;

    }



    private void LoadMoreGroupedSongs() => visibleGroupedLimit += PageSize;



    private void ResetGroupedPaging() => visibleGroupedLimit = PageSize;



    private async Task ToggleGenreFiltersAsync()

    {

        showGenreFilters = !showGenreFilters;

        await MySongsStore.SetShowGenreFiltersAsync(showGenreFilters);

    }



    private async Task ToggleSortDirAsync()

    {

        sortDir = sortDir == "desc" ? "asc" : "desc";

        await ReloadAsync();

    }



    private async Task SetGenreFilterAsync(int? genreId)

    {

        filterGenreId = genreId;

        await ReloadAsync();

    }



    private async Task SetListKindAsync(SingerListKind newKind)

    {

        if (listKind == newKind)

        {

            return;

        }



        listKind = newKind;
        showAddSong = false;
        addSongId = null;
        addSongError = null;

        await MySongsStore.SetListKindAsync(newKind);

        await ReloadAsync();

    }



    private sealed record GroupedSongSection(string Key, IReadOnlyList<RepertoireSongDto> Songs);



    private void GoToHistoryAsync(RepertoireSongDto song) =>

        Navigation.NavigateTo($"my-songs/{song.SongId}");



    private void GoToLogAsync(RepertoireSongDto song) =>

        Navigation.NavigateTo($"log?songId={song.SongId}");

    private async Task OpenAddSongPanelAsync()
    {
        addSongError = null;
        showAddSong = true;
        if (catalogPickerItems.Count > 0)
        {
            return;
        }

        var songs = await Api.GetSongsAsync();
        var artists = await Api.GetArtistLookupsAsync();
        var artistNames = artists.ToDictionary(a => a.Id, a => a.Name);
        catalogPickerItems = songs
            .Select(s => new LogSongPickItem(
                s.Id,
                s.Title,
                s.Artist is int artistId && artistNames.TryGetValue(artistId, out var name) ? name : string.Empty,
                false))
            .OrderBy(s => s.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void CloseAddSongPanel()
    {
        showAddSong = false;
        addSongId = null;
        addSongError = null;
    }

    private async Task ConfirmAddSongAsync()
    {
        if (addSongId is not int songId)
        {
            return;
        }

        var list = singerLists.FirstOrDefault(l => l.Kind == listKind);
        if (list is null)
        {
            addSongError = "List was not found.";
            return;
        }

        isAddingSong = true;
        addSongError = null;
        var result = await Api.AddListSongAsync(list.Id, songId);
        if (!result.Succeeded)
        {
            addSongError = result.ErrorMessage;
            isAddingSong = false;
            return;
        }

        CloseAddSongPanel();
        isAddingSong = false;
        await ReloadAsync();
    }

}

