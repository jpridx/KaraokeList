@page "/venues"
@attribute [Authorize(Roles = KaraokeRoles.Admin)]
@inject IKaraokeApiClient Api

<PageTitle>Venues</PageTitle>

<h3>Venues</h3>
<div class="catalog-container">
    <CatalogCrudGrid TItem="VenueDto"
                     Items="@venues"
                     IsLoading="@isLoading"
                     ShowLoadingMessage="true"
                     UseFilterBar="true"
                     UsePageSizes="true"
                     @bind-ErrorMessage="gridError"
                     GetId="@(venue => venue.Id)"
                     OnSaveAsync="SaveVenueAsync"
                     OnDeleteAsync="DeleteVenueAsync"
                     OnReload="ReloadAsync">
        <Columns>
            <GridColumn Field="@nameof(VenueDto.Id)" HeaderText="ID" IsPrimaryKey="true" Visible="false" />
            <GridColumn Field="@nameof(VenueDto.VenueName)" HeaderText="Venue Name" Width="300" />
        </Columns>
    </CatalogCrudGrid>
</div>

@code {
    private List<VenueDto> venues = [];
    private bool isLoading = true;
    private string? gridError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        venues = await Api.GetVenuesAsync();
        isLoading = false;
    }

    private Task<CatalogMutateResult> SaveVenueAsync(VenueDto venue, bool isNew) =>
        isNew ? Api.TryCreateVenueAsync(venue) : Api.TryUpdateVenueAsync(venue);

    private Task<CatalogMutateResult> DeleteVenueAsync(VenueDto venue) =>
        Api.TryDeleteVenueAsync(venue.Id);
}
