@page "/artists"
@attribute [Authorize(Roles = KaraokeRoles.Admin)]
@inject IKaraokeApiClient Api

<PageTitle>Artists</PageTitle>

<div class="catalog-container">
    <MobilePageHeader Title="Artists" BackHref="/admin/catalog" BackText="← Catalog maintenance" />
    <CatalogCrudGrid TItem="ArtistDto"
                     Items="@artists"
                     IsLoading="@isLoading"
                     @bind-ErrorMessage="gridError"
                     GetId="@(artist => artist.Id)"
                     OnSaveAsync="SaveArtistAsync"
                     OnDeleteAsync="DeleteArtistAsync"
                     OnReload="ReloadAsync">
        <Columns>
            <GridColumn Field="@nameof(ArtistDto.Id)" IsPrimaryKey="true" Visible="false" />
            <GridColumn Field="@nameof(ArtistDto.Name)" HeaderText="Name" Width="200" />
            <GridColumn Field="@nameof(ArtistDto.SortableName)" HeaderText="Sortable Name" Width="200" />
            <GridColumn Field="@nameof(ArtistDto.Mbid)" HeaderText="Artist MBID" Width="220" AllowEditing="false" />
            <GridColumn Field="@nameof(ArtistDto.MainGenre)" HeaderText="Main Genre" Width="180">
                <Template Context="context">
                    @{
                        var artist = (ArtistDto)context!;
                        var genreName = genres.FirstOrDefault(g => g.Id == artist.MainGenre)?.GenreName ?? "";
                    }
                    <span>@genreName</span>
                </Template>
                <EditTemplate Context="context">
                    @{
                        var artist = (ArtistDto)context!;
                    }
                    <SfDropDownList TValue="int?" TItem="GenreDto" DataSource="@genres" @bind-Value="artist.MainGenre"
                                    Placeholder="Select genre" AllowFiltering="true"
                                    FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                        <DropDownListFieldSettings Value="Id" Text="GenreName" />
                    </SfDropDownList>
                </EditTemplate>
            </GridColumn>
        </Columns>
    </CatalogCrudGrid>
</div>

@code {
    private List<ArtistDto> artists = [];
    private List<GenreDto> genres = [];
    private bool isLoading = true;
    private string? gridError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        genres = await Api.GetGenresAsync();
        artists = await Api.GetArtistsAsync();
        isLoading = false;
    }

    private Task<CatalogMutateResult> SaveArtistAsync(ArtistDto artist, bool isNew) =>
        isNew ? Api.TryCreateArtistAsync(artist) : Api.TryUpdateArtistAsync(artist);

    private Task<CatalogMutateResult> DeleteArtistAsync(ArtistDto artist) =>
        Api.TryDeleteArtistAsync(artist.Id);
}
