@page "/songs"
@attribute [Authorize]
@inject IKaraokeApiClient Api

<PageTitle>Songs</PageTitle>

<h3>Songs</h3>
<div class="catalog-container">
    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else if (songs.Count == 0)
    {
        <div class="alert alert-warning">No songs found. Add artists and songs to get started.</div>
    }

    @if (!isLoading)
    {
        <SfGrid DataSource="@songs" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
                Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel", "Search" })">
            <GridEvents TValue="SongDisplay" OnActionBegin="OnActionBegin"></GridEvents>
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Normal"></GridEditSettings>
            <GridColumns>
                <GridColumn Field="@nameof(SongDisplay.Id)" IsPrimaryKey="true" Visible="false" />
                <GridColumn Field="@nameof(SongDisplay.Title)" HeaderText="Title" Width="200" />
                <GridColumn Field="@nameof(SongDisplay.ArtistName)" HeaderText="Artist" Width="200">
                    <EditTemplate Context="context">
                        @{
                            var song = (SongDisplay)context!;
                        }
                        <SfAutoComplete TValue="string" TItem="ArtistLookupDto" DataSource="@artistLookups" @bind-Value="song.ArtistName"
                                        Placeholder="Search artist...">
                            <AutoCompleteFieldSettings Value="Name" Text="Name" />
                        </SfAutoComplete>
                    </EditTemplate>
                </GridColumn>
                <GridColumn Field="@nameof(SongDisplay.GenreName)" HeaderText="Genre" Width="150">
                    <EditTemplate Context="context">
                        @{
                            var song = (SongDisplay)context!;
                        }
                        <SfDropDownList TValue="int?" TItem="GenreDto" DataSource="@genres" @bind-Value="song.Genre"
                                        Placeholder="Select genre" AllowFiltering="true"
                                        FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                            <DropDownListFieldSettings Value="Id" Text="GenreName" />
                        </SfDropDownList>
                    </EditTemplate>
                </GridColumn>
                <GridColumn Field="@nameof(SongDisplay.SecondaryArtistName)" HeaderText="Secondary Artist" Width="200">
                    <EditTemplate Context="context">
                        @{
                            var song = (SongDisplay)context!;
                        }
                        <SfAutoComplete TValue="string" TItem="ArtistLookupDto" DataSource="@artistLookups" @bind-Value="song.SecondaryArtistName"
                                        Placeholder="Search artist...">
                            <AutoCompleteFieldSettings Value="Name" Text="Name" />
                        </SfAutoComplete>
                    </EditTemplate>
                </GridColumn>
                <GridColumn Field="@nameof(SongDisplay.Year)" HeaderText="Year" Width="100" />
            </GridColumns>
        </SfGrid>
    }
</div>

@code {
    private List<SongDisplay> songs = [];
    private List<ArtistLookupDto> artistLookups = [];
    private List<GenreDto> genres = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        artistLookups = await Api.GetArtistLookupsAsync();
        genres = await Api.GetGenresAsync();
        var raw = await Api.GetSongsAsync();
        songs = raw.Select(s => new SongDisplay
        {
            Id = s.Id,
            Title = s.Title,
            Artist = s.Artist,
            ArtistName = artistLookups.FirstOrDefault(a => a.Id == s.Artist)?.Name ?? "",
            Genre = s.Genre,
            GenreName = genres.FirstOrDefault(g => g.Id == s.Genre)?.GenreName ?? "",
            Year = s.Year,
            SecondaryArtist = s.SecondaryArtist,
            SecondaryArtistName = artistLookups.FirstOrDefault(a => a.Id == s.SecondaryArtist)?.Name ?? ""
        }).ToList();
        isLoading = false;
    }

    private async Task OnActionBegin(ActionEventArgs<SongDisplay> args)
    {
        if (args.RequestType == Action.Save && args.Data is not null)
        {
            args.Data.Artist = artistLookups.FirstOrDefault(a => a.Name == args.Data.ArtistName)?.Id;
            args.Data.SecondaryArtist = string.IsNullOrWhiteSpace(args.Data.SecondaryArtistName)
                ? null
                : artistLookups.FirstOrDefault(a => a.Name == args.Data.SecondaryArtistName)?.Id;
            if (args.Data.Id <= 0) await Api.CreateSongAsync(args.Data);
            else await Api.UpdateSongAsync(args.Data);
            await ReloadAsync();
        }
        else if (args.RequestType == Action.Delete && args.Data is not null)
        {
            await Api.DeleteSongAsync(args.Data.Id);
            await ReloadAsync();
        }
    }

    private sealed class SongDisplay : SongDto
    {
        public string ArtistName { get; set; } = string.Empty;
        public string GenreName { get; set; } = string.Empty;
        public string SecondaryArtistName { get; set; } = string.Empty;
    }
}
