@page "/songs"
@attribute [Authorize(Roles = KaraokeRoles.Admin)]
@inject IKaraokeApiClient Api

<PageTitle>Songs</PageTitle>

<div class="catalog-container">
    <MobilePageHeader Title="Songs" BackHref="/admin/catalog" BackText="← Catalog maintenance" />
    @if (!isLoading && songs.Count == 0)
    {
        <div class="alert alert-warning">No songs found. Add artists and songs to get started.</div>
    }

    <CatalogCrudGrid TItem="SongDisplay"
                     Items="@songs"
                     IsLoading="@isLoading"
                     @bind-ErrorMessage="gridError"
                     GetId="@(song => song.Id)"
                     OnSaveAsync="SaveSongAsync"
                     OnDeleteAsync="DeleteSongAsync"
                     OnReload="ReloadAsync"
                     OnActionBeginExtra="OnGridActionBeginAsync">
        <Columns>
            <GridColumn Field="@nameof(SongDisplay.Id)" IsPrimaryKey="true" Visible="false" />
            <GridColumn Field="@nameof(SongDisplay.Title)" HeaderText="Title" Width="200" />
            <GridColumn Field="@nameof(SongDisplay.ArtistDisplay)" HeaderText="Artists" Width="260">
                <EditTemplate Context="context">
                    @{
                        var song = (SongDisplay)context!;
                    }
                    <SongArtistsEditor ArtistNames="@GetEditableArtistNames(song)"
                                       ArtistNamesChanged="@(names => OnArtistNamesChanged(song, names))"
                                       ArtistLookups="@artistLookups" />
                </EditTemplate>
            </GridColumn>
            <GridColumn Field="@nameof(SongDisplay.RecordingMbid)" HeaderText="Recording MBID" Width="220" AllowEditing="false" />
            <GridColumn Field="@nameof(SongDisplay.GenreName)" HeaderText="Genre" Width="150">
                <EditTemplate Context="context">
                    @{
                        var song = (SongDisplay)context!;
                    }
                    <SfDropDownList TValue="int?" TItem="GenreDto" DataSource="@genres" @bind-Value="song.Genre"
                                    Placeholder="Select genre" AllowFiltering="true"
                                    FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                        <DropDownListFieldSettings Value="Id" Text="GenreName" />
                    </SfDropDownList>
                </EditTemplate>
            </GridColumn>
            <GridColumn Field="@nameof(SongDisplay.Year)" HeaderText="Year" Width="100" />
        </Columns>
    </CatalogCrudGrid>

    @if (editingSong is not null)
    {
        <div class="border rounded p-3 mt-3 bg-body-tertiary">
            <h4 class="h6 mb-2">Canonical name check</h4>
            <p class="small text-muted mb-2">
                Editing <strong>@editingSong.Title</strong> — @editingSong.ArtistDisplay
            </p>
            <CanonicalNameCheck Title="@editingSong.Title" TitleChanged="OnEditingTitleChangedAsync"
                                ArtistName="@editingSong.PrimaryArtistName" ArtistNameChanged="OnEditingArtistChangedAsync"
                                OnCanonicalApplied="OnEditingCanonicalAppliedAsync" />
        </div>
    }
</div>

@code {
    private List<SongDisplay> songs = [];
    private List<ArtistLookupDto> artistLookups = [];
    private List<GenreDto> genres = [];
    private bool isLoading = true;
    private string? gridError;
    private SongDisplay? editingSong;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnGridActionBeginAsync(ActionEventArgs<SongDisplay> args)
    {
        if (args.RequestType == Action.BeginEdit || args.RequestType == Action.Add)
        {
            editingSong = args.Data;
            if (editingSong is not null && editingSong.Artists.Count == 0)
            {
                editingSong.Artists.Add(new SongArtistDto { DisplayOrder = 0, Name = string.Empty });
            }
        }
        else if (args.RequestType is Action.Save or Action.Cancel)
        {
            editingSong = null;
        }

        await Task.CompletedTask;
    }

    private List<string> GetEditableArtistNames(SongDisplay song) =>
        song.Artists.Count == 0
            ? [string.Empty]
            : song.Artists.OrderBy(a => a.DisplayOrder).Select(a => a.Name).ToList();

    private Task OnArtistNamesChanged(SongDisplay song, List<string> names)
    {
        song.Artists = names
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Select((name, index) => new SongArtistDto
            {
                DisplayOrder = index,
                Name = name.Trim()
            })
            .ToList();
        return Task.CompletedTask;
    }

    private Task OnEditingTitleChangedAsync(string value)
    {
        if (editingSong is not null)
        {
            editingSong.Title = value;
        }

        return Task.CompletedTask;
    }

    private Task OnEditingArtistChangedAsync(string value)
    {
        if (editingSong is not null)
        {
            if (editingSong.Artists.Count == 0)
            {
                editingSong.Artists.Add(new SongArtistDto { DisplayOrder = 0, Name = value });
            }
            else
            {
                editingSong.Artists[0].Name = value;
            }
        }

        return Task.CompletedTask;
    }

    private Task OnEditingCanonicalAppliedAsync(CanonicalAppliedEventArgs args)
    {
        if (editingSong is not null)
        {
            editingSong.Title = args.Title;
            editingSong.RecordingMbid = args.RecordingMbid;
            editingSong.ArtistCreditDisplay = args.ArtistCreditDisplay;
            var names = args.ArtistNames?.ToList() ?? [args.ArtistName];
            editingSong.Artists = names
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .Select((name, index) => new SongArtistDto
                {
                    DisplayOrder = index,
                    Name = name.Trim()
                })
                .ToList();

            if (args.Year is int year)
            {
                editingSong.Year = year;
            }

            if (!string.IsNullOrWhiteSpace(args.SuggestedGenreName))
            {
                editingSong.Genre = LogGenrePicker.ResolveGenreId(args.SuggestedGenreName, genres);
                editingSong.GenreName = args.SuggestedGenreName;
            }
        }

        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        artistLookups = await Api.GetArtistLookupsAsync();
        genres = await Api.GetGenresAsync();
        var raw = await Api.GetSongsAsync();
        songs = SongDisplayMapper.ToDisplayList(raw, artistLookups, genres);
        isLoading = false;
    }

    private async Task<CatalogMutateResult> SaveSongAsync(SongDisplay song, bool isNew)
    {
        var dto = SongDisplayMapper.ToDto(song, artistLookups);
        return isNew
            ? await Api.TryCreateSongAsync(dto)
            : await Api.TryUpdateSongAsync(dto);
    }

    private Task<CatalogMutateResult> DeleteSongAsync(SongDisplay song) =>
        Api.TryDeleteSongAsync(song.Id);
}
