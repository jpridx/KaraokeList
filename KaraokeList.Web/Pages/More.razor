@page "/more"
@attribute [Authorize]
@inject IAppUpdateService UpdateService
@inject ICatalogSyncService CatalogSync
@inject ILogPerformanceLocalStore LogStore
@inject IMySongsLocalStore MySongsStore

<PageTitle>More</PageTitle>

<div class="mobile-page mobile-page-with-nav">
    <MobilePageHeader Title="More">
        <Subtitle>Catalog and account tools.</Subtitle>
    </MobilePageHeader>

    <StatusAlerts SuccessMessage="@syncSuccessMessage" ErrorMessage="@syncErrorMessage" CssClass="mt-2" />

    <section class="more-section">
        <h2 class="more-section-title">Tonight</h2>
        <a class="more-link" href="log">Log performance</a>
        <a class="more-link" href="my-songs">My Songs</a>
        <a class="more-link" href="import-repertoire">Import to list</a>
        <a class="more-link" href="my-performances">My performances</a>
        <a class="more-link" href="my-stats">My stats</a>
    </section>

    <AuthorizeView Roles="@KaraokeRoles.Admin">
        <Authorized>
            <section class="more-section">
                <h2 class="more-section-title">Admin</h2>
                <a class="more-link" href="admin/users">Users</a>
            </section>

            <section class="more-section">
                <h2 class="more-section-title">Catalog</h2>
                <a class="more-link" href="admin/catalog">Catalog maintenance</a>
            </section>
        </Authorized>
    </AuthorizeView>

    <section class="more-section">
        <h2 class="more-section-title">Account</h2>
        <a class="more-link" href="invite-friends">Invite friends</a>
        <a class="more-link" href="account/change-password">Change password</a>
        <a class="more-link" href="account/preferences">Preferences</a>
        <a class="more-link" href="">Home</a>
    </section>

    <section class="more-section">
        <h2 class="more-section-title">App</h2>
        <button type="button" class="more-link more-link-button" @onclick="SyncFromServerAsync"
                disabled="@isSyncing">
            @(isSyncing ? "Syncing…" : "Sync from server")
        </button>
        <p class="more-hint">Fetch latest songs, repertoire, and performance dates from the server.</p>
        <button type="button" class="more-link more-link-button" @onclick="ClearCacheAsync"
                disabled="@isClearing">
            @(isClearing ? "Reloading…" : "Reload app")
        </button>
        <p class="more-hint">Use this if the app looks outdated after an update.</p>
        <a class="more-link" href="about">About</a>
    </section>
</div>

@code {
    private bool isClearing;
    private bool isSyncing;
    private string? syncSuccessMessage;
    private string? syncErrorMessage;

    private async Task SyncFromServerAsync()
    {
        if (isSyncing)
        {
            return;
        }

        isSyncing = true;
        syncSuccessMessage = null;
        syncErrorMessage = null;
        try
        {
            var result = await CatalogSync.SyncFromServerAsync();
            if (result.Succeeded)
            {
                syncSuccessMessage = "Data synced from server.";
            }
            else
            {
                syncErrorMessage = result.ErrorMessage ?? "Could not sync from server.";
            }
        }
        finally
        {
            isSyncing = false;
        }
    }

    private async Task ClearCacheAsync()
    {
        if (isClearing) return;
        isClearing = true;
        try
        {
            await LogStore.ClearCatalogCacheAsync();
            await MySongsStore.ClearCatalogCacheAsync();
            await UpdateService.ClearCacheAndReloadAsync();
        }
        catch
        {
            // The JS interop call is interrupted when the page reloads — swallow that.
            // If the JS threw before reaching reload(), reset so the user can try again.
            isClearing = false;
        }
    }
}
