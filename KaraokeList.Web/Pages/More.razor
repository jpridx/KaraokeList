@page "/more"
@attribute [Authorize]

<PageTitle>More</PageTitle>

<div class="mobile-page">
    <header class="mobile-page-header">
        <h1 class="h4 mb-1">More</h1>
        <p class="text-muted small mb-0">Catalog and account tools.</p>
    </header>

    <section class="more-section">
        <h2 class="more-section-title">Tonight</h2>
        <a class="more-link" href="log">Log performance</a>
        <a class="more-link" href="my-songs">My Songs</a>
        <a class="more-link" href="my-performances">My performances</a>
        <a class="more-link" href="my-stats">My stats</a>
    </section>

    <AuthorizeView Roles="@KaraokeRoles.Admin">
        <Authorized>
            <section class="more-section">
                <h2 class="more-section-title">Admin</h2>
                <a class="more-link" href="admin/users">Users</a>
            </section>

            <section class="more-section">
                <h2 class="more-section-title">Catalog</h2>
                <a class="more-link" href="songs">Songs</a>
                <a class="more-link" href="artists">Artists</a>
                <a class="more-link" href="genres">Genres</a>
                <a class="more-link" href="singers">Singers</a>
                <a class="more-link" href="venues">Venues</a>
                <a class="more-link" href="performances">Performances (grid)</a>
            </section>
        </Authorized>
    </AuthorizeView>

    <section class="more-section">
        <h2 class="more-section-title">Account</h2>
        <a class="more-link" href="invite-friends">Invite friends</a>
        <a class="more-link" href="account/change-password">Change password</a>
        <a class="more-link" href="">Home</a>
    </section>
</div>
