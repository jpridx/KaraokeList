@page "/reset-password"

<PageTitle>Reset password</PageTitle>

@if (loading)
{
    <p class="text-muted">Loading…</p>
}
else if (registrationInfo is null)
{
    <h3>Reset password</h3>
    <div class="alert alert-danger">Could not load settings. Is the API running?</div>
}
else if (!registrationInfo.IsPasswordRecoveryAllowed)
{
    <h3>Reset password</h3>
    <p class="text-muted">Password recovery is not available. <a href="login">Sign in</a>.</p>
}
else if (string.IsNullOrEmpty(Code))
{
    <h3>Invalid reset link</h3>
    <p class="text-muted">This reset link is missing or invalid. Request a new one from <a href="forgot-password">forgot password</a>.</p>
}
else
{
    <h3>Reset your password</h3>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <EditForm Model="Input" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="Input.Email" disabled="@isSubmitting" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label class="form-label">New password</label>
            <InputText type="password" class="form-control" @bind-Value="Input.Password" disabled="@isSubmitting" autocomplete="new-password" />
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm new password</label>
            <InputText type="password" class="form-control" @bind-Value="Input.ConfirmPassword" disabled="@isSubmitting" autocomplete="new-password" />
        </div>
        <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
            @(isSubmitting ? "Saving…" : "Reset password")
        </button>
    </EditForm>
}

@code {
    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    private ResetPasswordRequest Input { get; set; } = new();
    private RegistrationInfoDto? registrationInfo;
    private bool loading = true;
    private bool isSubmitting;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        registrationInfo = await Api.GetRegistrationInfoAsync();

        if (!string.IsNullOrEmpty(Email))
        {
            Input.Email = Email;
        }

        if (!string.IsNullOrEmpty(Code))
        {
            Input.Code = Code;
        }

        loading = false;
    }

    private async Task SubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await Api.ResetPasswordAsync(Input);
            if (!result.Succeeded)
            {
                errorMessage = result.ErrorMessage ?? "Could not reset password.";
                return;
            }

            NavigationManager.NavigateTo("reset-password-confirmation");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
