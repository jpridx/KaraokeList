@page "/about"
@using System.Reflection
@using KaraokeList.Shared
@inject IKaraokeApiClient ApiClient

<PageTitle>About</PageTitle>

<h3>About KaraokeList</h3>

<p><strong>Web version:</strong> @WebVersion</p>
<p><strong>API version:</strong> @(FormatVersion(ApiInfo?.InformationalVersion ?? ApiInfo?.ApiVersion) ?? "loading...")</p>
<p><strong>Database migration:</strong> @(ApiInfo?.LatestMigration ?? "loading...")</p>

@if (ApiInfo is not null)
{
    @if (ApiInfo.DatabaseAvailable)
    {
        <p><strong>Songs in catalog:</strong> @ApiInfo.SongCount</p>
        <p><strong>Cache tag:</strong> <code>@ApiInfo.CacheTag</code></p>
    }
    else
    {
        <p class="text-danger"><strong>Database:</strong> unavailable@(ApiInfo.DatabaseError is not null ? $" — {ApiInfo.DatabaseError}" : "")</p>
    }
}

@code {
    private AppVersionDto? ApiInfo;

    private string WebVersion =>
        FormatVersion(
            Assembly.GetExecutingAssembly()
                .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
                .InformationalVersion
            ?? Assembly.GetExecutingAssembly().GetName().Version?.ToString())
        ?? "unknown";

    /// Shortens "2.0.0+abc1234567890..." to "2.0.0+abc1234" (7-char SHA).
    private static string? FormatVersion(string? version)
    {
        if (version is null) return null;
        var plus = version.IndexOf('+');
        if (plus < 0 || plus + 8 > version.Length) return version;
        return version[..(plus + 8)];
    }

    protected override async Task OnInitializedAsync()
    {
        ApiInfo = await ApiClient.GetAppVersionAsync();
    }
}
