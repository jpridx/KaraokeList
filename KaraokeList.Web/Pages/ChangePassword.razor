@page "/account/change-password"
@attribute [Authorize]

<PageTitle>Change password</PageTitle>

<div class="mobile-page">
    <MobilePageHeader Title="Change password">
        <Subtitle>Update the password you use to sign in.</Subtitle>
    </MobilePageHeader>

    <StatusAlerts SuccessMessage="@successMessage" ErrorMessage="@errorMessage" CssClass="mt-3" />

    <section class="mobile-panel mt-3">
        <EditForm Model="Input" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Current password</label>
                <InputText type="password" class="form-control" @bind-Value="Input.CurrentPassword" disabled="@isSubmitting" />
            </div>
            <div class="mb-3">
                <label class="form-label">New password</label>
                <InputText type="password" class="form-control" @bind-Value="Input.NewPassword" disabled="@isSubmitting" />
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm new password</label>
                <InputText type="password" class="form-control" @bind-Value="Input.ConfirmPassword" disabled="@isSubmitting" />
            </div>
            <button class="btn btn-primary w-100" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Saving…" : "Change password")
            </button>
        </EditForm>
    </section>

    <MobileBackLink />
</div>

@code {
    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    private ChangePasswordRequest Input { get; set; } = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting;

    private async Task SubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await Api.ChangePasswordAsync(Input);
            if (!result.Succeeded)
            {
                errorMessage = result.ErrorMessage ?? "Could not change password.";
                return;
            }

            successMessage = "Your password has been changed.";
            Input = new ChangePasswordRequest();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
