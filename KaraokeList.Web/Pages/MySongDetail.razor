@page "/my-songs/{SongId:int}"
@attribute [Authorize]
@inject IKaraokeApiClient Api
@inject NavigationManager Navigation

<PageTitle>Song history</PageTitle>

<div class="mobile-page">
    <MobilePageHeader Title="@(songMeta?.Title ?? "Song history")" TitleClass="mb-0">
        <LeadingContent>
            <button type="button" class="btn btn-link btn-sm ps-0" @onclick="GoBack">← My Songs</button>
        </LeadingContent>
        <Subtitle>@(songMeta?.ArtistName)</Subtitle>
    </MobilePageHeader>

    <SingerProfileGate @ref="singerGate" OnResolved="LoadSongDetailAsync">
        <ChildContent Context="singerId">
            @if (isLoading)
            {
                <p>Loading...</p>
            }
            else if (!string.IsNullOrEmpty(loadError))
            {
                <p class="text-danger">@loadError</p>
            }
            else if (summary is null || songMeta is null)
            {
                <p>Could not load song.</p>
                <a href="my-songs">Back to My Songs</a>
            }
            else
            {
                <SongPerformanceSummaryPanel Summary="summary" GenreName="@songMeta.GenreName" />

                <SongListMembershipPanel SongId="SongId" PerformanceCount="summary.PerformanceCount"
                                         OnMembershipChanged="ReloadSongDetailAsync" />

                <TicklerExclusionPanel SongId="SongId" OnExclusionChanged="ReloadSongDetailAsync" />

                @if (summary.PerformanceCount == 0)
                {
                    <div class="song-detail-empty-state mobile-panel">
                        <p class="mb-0">Log your first performance below — venue, date, and key are saved for next time.</p>
                    </div>

                    <QuickLogPerformance SongId="SongId" Title="@songMeta.Title" ArtistName="@songMeta.ArtistName"
                                         SingerId="singerId" SaveButtonText="Log performance"
                                         OnPerformanceSaved="OnPerformanceSavedAsync" />
                }
                else
                {
                    <CoPerformersEditor PrimarySingerId="singerId" @bind-OtherPerformers="hostCoPerformers" />

                    <HostMessagePanel Title="@songMeta.Title" ArtistName="@songMeta.ArtistName"
                                      KeyChangeSemitones="hostKeyChangeSemitones" ShowKeyPicker="false"
                                      CoPerformerNames="hostCoPerformerNames" />

                    <details class="mobile-panel history-details mt-2" open>
                        <summary class="history-details-summary">
                            Performance history (@summary.PerformanceCount)
                        </summary>
                        <EditablePerformanceList SingerId="singerId"
                                                 Variant="EditablePerformanceListVariant.History"
                                                 Entries="historyEntries"
                                                 OnChanged="OnHistoryChangedAsync" />
                    </details>

                    <details class="mobile-panel log-again-details mt-2">
                        <summary class="history-details-summary">Log again</summary>
                        <div class="log-again-form mt-2">
                            <QuickLogPerformance SongId="SongId" Title="@songMeta.Title" ArtistName="@songMeta.ArtistName"
                                                 SingerId="singerId" SaveButtonText="Log again"
                                                 OtherPerformers="hostCoPerformers" ShowCoPerformersEditor="false"
                                                 ShowHostMessagePanel="false"
                                                 @bind-KeyChangeSemitones="hostKeyChangeSemitones"
                                                 OnPerformanceSaved="OnPerformanceSavedAsync" />
                        </div>
                    </details>
                }
            }
        </ChildContent>
    </SingerProfileGate>
</div>

@code {
    [Parameter]
    public int SongId { get; set; }

    private SingerProfileGate? singerGate;
    private bool isLoading = true;
    private int? loadedForSongId;
    private string? loadError;
    private SongPerformanceSummaryDto? summary;
    private RepertoireSongDto? songMeta;
    private List<SingerDto> singers = [];
    private List<CoPerformerInputDto> hostCoPerformers = [];
    private int? hostKeyChangeSemitones;

    private IReadOnlyList<string> hostCoPerformerNames =>
        CoPerformerFormatting.GetDisplayNames(hostCoPerformers, singers);

    private IReadOnlyList<EditablePerformanceEntry> historyEntries =>
        summary?.History.Select(entry => EditablePerformanceEntry.FromHistory(entry, SongId)).ToList() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        if (loadedForSongId is int previousSongId && previousSongId != SongId)
        {
            await ReloadSongDetailAsync();
        }
    }

    private Task LoadSongDetailAsync(int singerId) => ReloadSongDetailAsync();

    private async Task OnPerformanceSavedAsync(string? _) => await ReloadSongDetailAsync();

    private async Task OnHistoryChangedAsync() => await ReloadSongDetailAsync();

    private async Task ReloadSongDetailAsync()
    {
        isLoading = true;
        loadError = null;
        summary = null;
        hostCoPerformers = [];
        hostKeyChangeSemitones = null;

        try
        {
            singers = await Api.GetSingersAsync();
        }
        catch
        {
            singers = [];
        }

        var repertoire = await Api.GetMyRepertoireAsync(includeAll: true);
        if (repertoire.Succeeded)
        {
            songMeta = repertoire.Songs.FirstOrDefault(s => s.SongId == SongId);
        }

        var result = await Api.GetMySongSummaryAsync(SongId);
        if (result.Succeeded && result.Summary is not null)
        {
            summary = result.Summary;
        }
        else
        {
            loadError = result.ErrorMessage;
            singerGate.RequireLinkIfNotLinked(result.ErrorMessage);
        }

        loadedForSongId = SongId;
        isLoading = false;
    }

    private void GoBack() => Navigation.NavigateTo("my-songs");
}
