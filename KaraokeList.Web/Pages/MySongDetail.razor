@page "/my-songs/{SongId:int}"
@attribute [Authorize]
@inject IKaraokeApiClient Api
@inject NavigationManager Navigation

<PageTitle>Song history</PageTitle>

<div class="mobile-page">
    <header class="mobile-page-header">
        <button type="button" class="btn btn-link btn-sm ps-0" @onclick="GoBack">← My Songs</button>
        @if (songMeta is not null)
        {
            <h1 class="h4 mb-0">@songMeta.Title</h1>
            <p class="text-muted mb-0">@songMeta.ArtistName</p>
        }
    </header>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <p class="text-danger">@loadError</p>
        <SingerLinkPanel Visible="needsSingerLink" OnLinked="OnSingerLinkedAsync" />
    }
    else if (summary is null || songMeta is null)
    {
        <p>Could not load song.</p>
        <a href="my-songs">Back to My Songs</a>
    }
    else
    {
        <section class="mobile-panel song-stats-panel">
            @if (!string.IsNullOrWhiteSpace(songMeta.GenreName))
            {
                <p class="song-stats-genre small text-muted mb-2">@songMeta.GenreName</p>
            }

            @if (summary.PerformanceCount > 0)
            {
                <dl class="song-stats-list mb-0">
                    <div class="song-stats-row">
                        <dt>Times sung</dt>
                        <dd>@summary.PerformanceCount</dd>
                    </div>
                    <div class="song-stats-row">
                        <dt>Last performance</dt>
                        <dd>
                            @summary.LastPerformedOn?.ToString("d")
                            @if (!string.IsNullOrEmpty(summary.LastVenueName))
                            {
                                <text> · @summary.LastVenueName</text>
                            }
                            · @KeyChangeFormatting.Describe(summary.LastKeyChangeSemitones)
                        </dd>
                    </div>
                </dl>
            }
            else
            {
                <p class="song-stats-first-time mb-0">You haven't logged this song yet.</p>
            }
        </section>

        <SongListMembershipPanel SongId="SongId" PerformanceCount="summary.PerformanceCount"
                                 OnMembershipChanged="LoadAsync" />

        @if (mySingerId is null)
        {
            <SingerLinkPanel Visible="true" OnLinked="OnSingerLinkedAsync" />
        }
        else if (summary.PerformanceCount == 0)
        {
            <div class="song-detail-empty-state mobile-panel">
                <p class="mb-0">Log your first performance below — venue, date, and key are saved for next time.</p>
            </div>

            <QuickLogPerformance SongId="SongId" Title="@songMeta.Title" ArtistName="@songMeta.ArtistName"
                                 SingerId="mySingerId" SaveButtonText="Log performance"
                                 OnPerformanceSaved="OnPerformanceSavedAsync" />
        }
        else
        {
            <CoPerformersEditor PrimarySingerId="mySingerId.Value" @bind-OtherPerformers="hostCoPerformers" />

            <HostMessagePanel Title="@songMeta.Title" ArtistName="@songMeta.ArtistName"
                              KeyChangeSemitones="summary.LastKeyChangeSemitones" ShowKeyPicker="false"
                              CoPerformerNames="hostCoPerformerNames" />

            <details class="mobile-panel history-details mt-2" open>
                <summary class="history-details-summary">
                    Performance history (@summary.PerformanceCount)
                </summary>
                <PerformanceHistoryList SongId="SongId" SingerId="mySingerId.Value"
                                        History="summary.History" OnChanged="OnHistoryChangedAsync" />
            </details>

            <details class="mobile-panel log-again-details mt-2">
                <summary class="history-details-summary">Log again</summary>
                <div class="log-again-form mt-2">
                    <QuickLogPerformance SongId="SongId" Title="@songMeta.Title" ArtistName="@songMeta.ArtistName"
                                         SingerId="mySingerId" SaveButtonText="Log again"
                                         OtherPerformers="hostCoPerformers" ShowCoPerformersEditor="false"
                                         OnPerformanceSaved="OnPerformanceSavedAsync" />
                </div>
            </details>
        }
    }
</div>

@code {
    [Parameter]
    public int SongId { get; set; }

    private bool isLoading = true;
    private bool needsSingerLink;
    private string? loadError;
    private SongPerformanceSummaryDto? summary;
    private RepertoireSongDto? songMeta;
    private int? mySingerId;
    private List<SingerDto> singers = [];
    private List<CoPerformerInputDto> hostCoPerformers = [];

    private IReadOnlyList<string> hostCoPerformerNames => hostCoPerformers
        .Select(p => p.SingerId is int singerId
            ? singers.FirstOrDefault(s => s.Id == singerId)?.Name ?? string.Empty
            : p.DisplayName?.Trim() ?? string.Empty)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .ToList();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task OnSingerLinkedAsync(int? singerId)
    {
        mySingerId = singerId;
        needsSingerLink = false;
        await LoadAsync();
    }

    private async Task OnPerformanceSavedAsync(string? _) => await LoadAsync();

    private async Task OnHistoryChangedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        summary = null;
        hostCoPerformers = [];

        var profile = await Api.GetProfileAsync();
        mySingerId = profile?.SingerId;

        try
        {
            singers = await Api.GetSingersAsync();
        }
        catch
        {
            singers = [];
        }

        var repertoire = await Api.GetMyRepertoireAsync(includeAll: true);
        if (repertoire.Succeeded)
        {
            songMeta = repertoire.Songs.FirstOrDefault(s => s.SongId == SongId);
        }

        var result = await Api.GetMySongSummaryAsync(SongId);
        if (result.Succeeded && result.Summary is not null)
        {
            summary = result.Summary;
            needsSingerLink = false;
        }
        else
        {
            loadError = result.ErrorMessage;
            if (result.ErrorMessage?.Contains("not linked", StringComparison.OrdinalIgnoreCase) == true)
            {
                needsSingerLink = true;
            }
        }

        isLoading = false;
    }

    private void GoBack() => Navigation.NavigateTo("my-songs");
}
