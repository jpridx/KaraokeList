@page "/"

<PageTitle>KaraokeList</PageTitle>

<h1>KaraokeList</h1>
<p>Manage songs, venues, and performance history.</p>

<AuthorizeView>
    <Authorized>
        <p>Signed in as <strong>@context.User.Identity?.Name</strong>.</p>
        <ul>
            <li><a href="songs">Songs</a></li>
            <li><a href="venues">Venues</a></li>
            <li><a href="singer-songs">Singer Songs</a></li>
        </ul>
    </Authorized>
    <NotAuthorized>
        <p><a href="login">Sign in</a> or <a href="register">register</a> to manage catalog data.</p>
    </NotAuthorized>
</AuthorizeView>
