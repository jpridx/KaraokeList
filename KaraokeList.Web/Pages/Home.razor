@page "/"
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager

<PageTitle>KaraokeList</PageTitle>

<h1>KaraokeList</h1>
<p>Manage songs, venues, and performance history.</p>

<AuthorizeView>
    <Authorized>
        <p>Signed in as <strong>@context.User.Identity?.Name</strong>.
            <button type="button" class="btn btn-link p-0 align-baseline" @onclick="LogoutAsync">Sign out</button>
        </p>
        <div class="home-actions d-md-none">
            <a class="btn btn-primary btn-lg w-100 mb-2" href="log">Log performance</a>
            <a class="btn btn-outline-primary btn-lg w-100" href="my-songs">My Songs</a>
        </div>
        <p class="mt-3"><a href="more">Catalog &amp; settings</a></p>
    </Authorized>
    <NotAuthorized>
        <p><a href="login">Sign in</a> or <a href="register">register</a> to manage catalog data.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        await AuthProvider.MarkUserAsLoggedOutAsync();
        NavigationManager.NavigateTo("/login");
    }
}
