@page "/"
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager

<PageTitle>My Karaoke</PageTitle>

<h1>My Karaoke</h1>
<p class="d-none d-md-block">Manage songs, venues, and performance history.</p>

<AuthorizeView>
    <Authorized>
        <InviteFriendsBanner />

        <p class="mb-3">Signed in as <strong>@context.User.Identity?.Name</strong>.
            <button type="button" class="btn btn-link p-0 align-baseline" @onclick="LogoutAsync">Sign out</button>
        </p>

        <div class="d-md-none">
            <TonightDashboard />
        </div>

        <StaleSongsSection />

        <div class="home-actions d-none d-md-block mt-3">
            <a class="btn btn-primary me-2" href="log">Log performance</a>
            <a class="btn btn-outline-primary me-2" href="my-songs">My Songs</a>
            <a class="btn btn-outline-secondary" href="more">Catalog &amp; settings</a>
        </div>

        <p class="mt-3 d-md-none"><a href="more">Catalog &amp; settings</a></p>
    </Authorized>
    <NotAuthorized>
        <p><a href="login">Sign in</a> or <a href="register">register</a> to manage catalog data.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        await AuthProvider.MarkUserAsLoggedOutAsync();
        NavigationManager.NavigateTo("/login");
    }
}
