@page "/forgot-password"

<PageTitle>Forgot password</PageTitle>

@if (loading)
{
    <p class="text-muted">Loading…</p>
}
else if (registrationInfo is null)
{
    <h3>Forgot password</h3>
    <div class="alert alert-danger">Could not load settings. Is the API running?</div>
}
else if (!registrationInfo.IsPasswordRecoveryAllowed)
{
    <h3>Forgot password</h3>
    <p class="text-muted">Password recovery is not available. <a href="login">Sign in</a> or contact the site owner.</p>
}
else
{
    <h3>Forgot your password?</h3>
    <p class="text-muted small mb-3">Enter your email and we will send a reset link if an account exists.</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <EditForm Model="Input" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="Input.Email" disabled="@isSubmitting" autocomplete="username" />
        </div>
        <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
            @(isSubmitting ? "Sending…" : "Send reset link")
        </button>
    </EditForm>

    <p class="mt-3 mb-0"><a href="login">Back to sign in</a></p>
}

@code {
    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private ForgotPasswordRequest Input { get; set; } = new();
    private RegistrationInfoDto? registrationInfo;
    private bool loading = true;
    private bool isSubmitting;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        registrationInfo = await Api.GetRegistrationInfoAsync();
        loading = false;
    }

    private async Task SubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await Api.ForgotPasswordAsync(Input);
            if (!result.Succeeded)
            {
                errorMessage = result.ErrorMessage ?? "Could not send reset link.";
                return;
            }

            NavigationManager.NavigateTo("forgot-password-confirmation");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
