@page "/my-performances"
@attribute [Authorize]
@inject IKaraokeApiClient Api

<PageTitle>My performances</PageTitle>

<div class="mobile-page mobile-page-with-nav">
    <MobilePageHeader Title="My performances">
        <Subtitle>Every time you've logged a song — newest first by default.</Subtitle>
    </MobilePageHeader>

    <SingerProfileGate @ref="singerGate" OnResolved="LoadPerformancesAsync">
        <ChildContent Context="singerId">
            @if (isLoading)
            {
                <p class="mt-3">Loading...</p>
            }
            else
            {
                <div class="mobile-toolbar">
                    <input class="form-control" placeholder="Search song, artist, or venue"
                           @bind="searchText" @bind:event="oninput" @bind:after="RefreshDisplayList" />
                    @if (displayPerformances.Count > 0)
                    {
                        <p class="small text-muted mb-0 mt-2">
                            @displayPerformances.Count performance@(displayPerformances.Count == 1 ? "" : "s")
                        </p>
                    }
                </div>

                @if (venueFilters.Count > 0)
                {
                    <div class="mobile-toolbar">
                        <label class="form-label small text-muted mb-1">Venue</label>
                        <div class="genre-chips">
                            <button type="button" class="genre-chip @(filterVenueId is null ? "active" : "")"
                                    @onclick="() => SetVenueFilterAsync(null)">All</button>
                            @foreach (var venue in venueFilters)
                            {
                                <button type="button" class="genre-chip @(filterVenueId == venue.Id ? "active" : "")"
                                        @onclick="() => SetVenueFilterAsync(venue.Id)">@venue.Name</button>
                            }
                        </div>
                    </div>
                }

                <div class="mobile-toolbar">
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            @onclick="ToggleSortDirAsync" title="Toggle sort direction">
                        @(sortDir == "desc" ? "↓ Newest first" : "↑ Oldest first")
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(loadError))
                {
                    <p class="text-danger">@loadError</p>
                }
                else if (performances.Count == 0)
                {
                    <div class="empty-state">
                        <p>No performances logged yet.</p>
                        <a href="log" class="btn btn-primary">Log a performance</a>
                    </div>
                }
                else if (!displayPerformances.Any())
                {
                    <div class="empty-state">
                        <p>No performances match your search.</p>
                    </div>
                }
                else
                {
                    <PerformanceBrowseList SingerId="singerId"
                                           Entries="VisiblePerformances"
                                           OnChanged="ReloadPerformancesAsync" />
                    @if (HasMorePerformances)
                    {
                        <button type="button" class="btn btn-outline-primary w-100 mt-2" @onclick="LoadMore">
                            Load more (@VisiblePerformances.Count of @displayPerformances.Count)
                        </button>
                    }
                }
            }
        </ChildContent>
    </SingerProfileGate>
</div>

@code {
    private SingerProfileGate? singerGate;
    private bool isLoading = true;
    private string? loadError;
    private List<MyPerformanceEntryDto> performances = [];
    private List<MyPerformanceEntryDto> displayPerformances = [];
    private List<VenueFilterOption> venueFilters = [];
    private string searchText = string.Empty;
    private string sortDir = "desc";
    private int? filterVenueId;
    private int visibleLimit = PageSize;

    private const int PageSize = 40;

    private IReadOnlyList<MyPerformanceEntryDto> VisiblePerformances =>
        displayPerformances.Take(visibleLimit).ToList();

    private bool HasMorePerformances => visibleLimit < displayPerformances.Count;

    private Task LoadPerformancesAsync(int singerId) => ReloadPerformancesAsync();

    private async Task ReloadPerformancesAsync()
    {
        isLoading = true;
        loadError = null;

        var result = await Api.GetMyPerformancesAsync(filterVenueId, sortDir);
        if (!result.Succeeded)
        {
            loadError = result.ErrorMessage;
            if (result.ErrorMessage?.Contains("not linked", StringComparison.OrdinalIgnoreCase) == true)
            {
                singerGate?.RequireSingerLink();
            }

            isLoading = false;
            return;
        }

        performances = result.Performances;
        if (filterVenueId is null)
        {
            venueFilters = performances
                .Where(p => p.VenueId is not null && !string.IsNullOrWhiteSpace(p.VenueName))
                .GroupBy(p => p.VenueId!.Value)
                .Select(g => new VenueFilterOption(g.Key, g.First().VenueName))
                .OrderBy(v => v.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        RefreshDisplayList();
        isLoading = false;
    }

    private void RefreshDisplayList()
    {
        displayPerformances = MyPerformancesSearch.Filter(performances, searchText).ToList();
        visibleLimit = PageSize;
    }

    private void LoadMore() => visibleLimit += PageSize;

    private async Task ToggleSortDirAsync()
    {
        sortDir = sortDir == "desc" ? "asc" : "desc";
        await ReloadPerformancesAsync();
    }

    private async Task SetVenueFilterAsync(int? venueId)
    {
        filterVenueId = venueId;
        await ReloadPerformancesAsync();
    }

    private sealed record VenueFilterOption(int Id, string Name);
}
