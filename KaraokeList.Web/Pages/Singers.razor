@page "/singers"
@attribute [Authorize(Roles = KaraokeRoles.Admin)]
@inject IKaraokeApiClient Api

<PageTitle>Singers</PageTitle>

<h3>Singers</h3>
<div class="catalog-container">
    <CatalogCrudGrid TItem="SingerDto"
                     Items="@singers"
                     IsLoading="@isLoading"
                     @bind-ErrorMessage="gridError"
                     GetId="@(singer => singer.Id)"
                     OnSaveAsync="SaveSingerAsync"
                     OnDeleteAsync="DeleteSingerAsync"
                     OnReload="ReloadAsync">
        <Columns>
            <GridColumn Field="@nameof(SingerDto.Id)" IsPrimaryKey="true" Visible="false" />
            <GridColumn Field="@nameof(SingerDto.Name)" HeaderText="Name" Width="300" />
        </Columns>
    </CatalogCrudGrid>
</div>

@code {
    private List<SingerDto> singers = [];
    private bool isLoading = true;
    private string? gridError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        singers = await Api.GetSingersAsync();
        isLoading = false;
    }

    private Task<CatalogMutateResult> SaveSingerAsync(SingerDto singer, bool isNew) =>
        isNew ? Api.TryCreateSingerAsync(singer) : Api.TryUpdateSingerAsync(singer);

    private Task<CatalogMutateResult> DeleteSingerAsync(SingerDto singer) =>
        Api.TryDeleteSingerAsync(singer.Id);
}
