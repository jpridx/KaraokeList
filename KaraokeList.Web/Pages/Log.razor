@page "/log"
@attribute [Authorize]
@inject IKaraokeApiClient Api
@inject ILogPerformanceLocalStore LogStore
@inject ILogCatalogLoader CatalogLoader

<PageTitle>Log performance</PageTitle>

<div class="mobile-page mobile-page-with-nav">
    <MobilePageHeader Title="Log performance">
        <Subtitle>Pick a song, or open one from <a href="my-songs">My Songs</a>.</Subtitle>
    </MobilePageHeader>

    <SingerProfileGate OnResolved="LoadCatalogAsync">
        <ChildContent Context="singerId">
            <MobileLoadingState IsLoading="isLoading">
                <OfflineCacheNotice UsingOffline="usingOfflineCatalog"
                                    HasCachedData="hasCachedCatalog"
                                    CachedAt="catalogCachedAt"
                                    ResourceName="songs"
                                    RefreshHint="Connect to refresh the catalog.">
                    <UnavailableContent>
                        Song catalog isn't available offline yet. Pick from <strong>Recently logged</strong> below,
                        or open Log once while online to cache songs.
                    </UnavailableContent>
                </OfflineCacheNotice>

                <StatusAlerts SuccessMessage="@saveMessage" ErrorMessage="@saveError" />

                <div class="mobile-panel">
                    <label class="form-label">Song</label>
                    @if (songPickerItems.Count == 0)
                    {
                        <p class="text-muted small mb-0">No songs in the catalog yet. Use + New song below.</p>
                    }
                    else
                    {
                        <CatalogSongPicker Items="songPickerItems" @bind-SelectedSongId="selectedSongId"
                                           @bind-SelectedSongId:after="OnSongSelectedAsync"
                                           Enabled="@(!showNewSong)" />
                        <p class="small text-muted mt-1 mb-0">@songPickerItems.Count songs · ★ = on My repertoire · 🎯 = working up</p>
                    }
                    @if (selectedSongId is int songId && songHint is not null)
                    {
                        <p class="small text-muted mt-2 mb-0">@songHint</p>
                    }
                    @if (selectedSongId is int workingUpSongId && !usingOfflineCatalog)
                    {
                        <AddToWorkingUpButton SongId="workingUpSongId"
                                              SingerLists="singerLists"
                                              AlreadyOnWorkingUp="workingUpSongIds.Contains(workingUpSongId)"
                                              OnAdded="OnAddedToWorkingUpAsync" />
                    }

                    @if (!usingOfflineCatalog)
                    {
                        @if (!showNewSong)
                        {
                            <button type="button" class="btn btn-link btn-sm ps-0 mt-2" @onclick="OpenNewSongPanel">
                                + New song
                            </button>
                        }
                        else
                        {
                            <AddSongPanel OnSongAdded="OnNewSongAddedAsync"
                                          OnCancelled="CloseNewSongPanel" />
                        }
                    }
                </div>

                @if (SelectedSong is not null)
                {
                    <QuickLogPerformance SongId="SelectedSong.Id" Title="@SelectedSong.Title"
                                         ArtistName="@SelectedSong.ArtistName" SingerId="singerId"
                                         OnPerformanceSaved="OnPerformanceSavedAsync" />
                }

                @if (recentLogs.Count > 0)
                {
                    <div class="mobile-panel recent-logs-panel">
                        <RecentLogList Items="recentLogs"
                                       Heading="Recently logged"
                                       HeadingSuffix="@(usingOfflineCatalog && !hasCachedCatalog ? " — tap to pick a song" : string.Empty)"
                                       IncludeKeyInMeta="true"
                                       OnItemSelected="SelectSongAsync" />
                    </div>
                }
            </MobileLoadingState>
        </ChildContent>
    </SingerProfileGate>
</div>

@code {
    [SupplyParameterFromQuery]
    public int? SongId { get; set; }

    private bool isLoading = true;
    private bool usingOfflineCatalog;
    private bool hasCachedCatalog;
    private DateTime? catalogCachedAt;
    private HashSet<int> repertoireSongIds = [];
    private HashSet<int> workingUpSongIds = [];
    private List<SingerListDto> singerLists = [];
    private List<LogSongPickItem> songPickerItems = [];

    private int? selectedSongId;
    private string? songHint;
    private string? saveMessage;
    private string? saveError;

    private bool showNewSong;
    private IReadOnlyList<RecentLoggedPerformance> recentLogs = [];

    private LogSongPickItem? SelectedSong
    {
        get
        {
            if (selectedSongId is not int id)
            {
                return null;
            }

            var fromPicker = songPickerItems.FirstOrDefault(s => s.Id == id);
            if (fromPicker is not null)
            {
                return fromPicker;
            }

            var fromRecent = recentLogs.FirstOrDefault(r => r.SongId == id);
            return fromRecent is null
                ? null
                : new LogSongPickItem(
                    fromRecent.SongId,
                    fromRecent.Title,
                    fromRecent.ArtistName,
                    repertoireSongIds.Contains(id),
                    workingUpSongIds.Contains(id));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SongId is int id && !isLoading && selectedSongId != id)
        {
            selectedSongId = id;
            await OnSongChangedAsync(id);
        }
    }

    private async Task LoadCatalogAsync(int singerId)
    {
        isLoading = true;
        saveError = null;
        usingOfflineCatalog = false;
        hasCachedCatalog = false;
        catalogCachedAt = null;

        var catalog = await CatalogLoader.LoadAsync();
        usingOfflineCatalog = catalog.FromCache;
        hasCachedCatalog = catalog.HasCatalog;
        catalogCachedAt = catalog.CachedAtUtc;
        songPickerItems = catalog.Songs.ToList();
        repertoireSongIds = catalog.RepertoireSongIds;
        workingUpSongIds = catalog.WorkingUpSongIds;

        if (!catalog.FromCache)
        {
            var listsResult = await SingerListResolver.LoadListsAsync(Api);
            if (listsResult.Succeeded)
            {
                singerLists = listsResult.Lists;
            }
        }

        recentLogs = await LogStore.GetRecentLogsAsync();
        isLoading = false;

        if (SongId is int querySongId)
        {
            selectedSongId = querySongId;
            await OnSongChangedAsync(querySongId);
        }
    }

    private async Task OnSongSelectedAsync() => await OnSongChangedAsync(selectedSongId);

    private async Task OnSongChangedAsync(int? songId)
    {
        songHint = null;
        if (songId is null)
        {
            return;
        }

        if (usingOfflineCatalog)
        {
            songHint = repertoireSongIds.Contains(songId.Value)
                ? "Ready to log (offline — using cached catalog)."
                : "Ready to log.";
            return;
        }

        songHint = await SongSummaryHints.LoadForSongAsync(Api, songId.Value);
    }

    private async Task OnPerformanceSavedAsync(string? message)
    {
        selectedSongId = null;
        songHint = null;
        saveMessage = message;
        saveError = null;
        recentLogs = await LogStore.GetRecentLogsAsync();

        if (!usingOfflineCatalog)
        {
            var catalog = await CatalogLoader.LoadAsync();
            songPickerItems = catalog.Songs.ToList();
            repertoireSongIds = catalog.RepertoireSongIds;
            workingUpSongIds = catalog.WorkingUpSongIds;
            usingOfflineCatalog = catalog.FromCache;
            hasCachedCatalog = catalog.HasCatalog;
            catalogCachedAt = catalog.CachedAtUtc;
        }
    }

    private async Task SelectSongAsync(int songId)
    {
        selectedSongId = songId;
        await OnSongChangedAsync(songId);
    }

    private async Task OnAddedToWorkingUpAsync()
    {
        if (selectedSongId is int songId)
        {
            workingUpSongIds.Add(songId);
        }
    }

    private void OpenNewSongPanel()
    {
        saveError = null;
        showNewSong = true;
    }

    private void CloseNewSongPanel() => showNewSong = false;

    private async Task OnNewSongAddedAsync(SongAddedEventArgs args)
    {
        saveError = null;
        var catalog = await CatalogLoader.LoadAsync();
        songPickerItems = catalog.Songs.ToList();
        repertoireSongIds = catalog.RepertoireSongIds;
        workingUpSongIds = catalog.WorkingUpSongIds;

        var created = CatalogSongMapper.FindCreatedPickItem(
            songPickerItems,
            args.Title,
            args.ArtistName);

        if (created is not null)
        {
            selectedSongId = created.Id;
            await OnSongChangedAsync(created.Id);
        }

        showNewSong = false;
        saveMessage = "Song added.";
    }
}
