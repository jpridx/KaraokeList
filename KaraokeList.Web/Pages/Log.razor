@page "/log"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@inject IKaraokeApiClient Api
@inject ILogPerformanceLocalStore LogStore
@inject ILogCatalogLoader CatalogLoader
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Log performance</PageTitle>

<div class="mobile-page mobile-page-with-nav">
    <header class="mobile-page-header">
        <h1 class="h4 mb-1">Log performance</h1>
        <p class="text-muted small mb-0">Pick a song, or open one from <a href="my-songs">My Songs</a>.</p>
    </header>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <SingerLinkPanel Visible="needsSingerLink" OnLinked="OnSingerLinkedAsync" />

        @if (!needsSingerLink)
        {
            @if (usingOfflineCatalog && catalogCachedAt is DateTime cachedAt)
            {
                <div class="alert alert-warning small mb-3" role="status">
                    Using cached songs from @cachedAt.ToLocalTime().ToString("g").
                    Connect to refresh the catalog.
                </div>
            }
            else if (usingOfflineCatalog && !hasCachedCatalog)
            {
                <div class="alert alert-warning small mb-3" role="status">
                    Song catalog isn't available offline yet. Pick from <strong>Recently logged</strong> below,
                    or open Log once while online to cache songs.
                </div>
            }

            @if (!string.IsNullOrEmpty(saveMessage))
            {
                <div class="alert alert-success">@saveMessage</div>
            }
            @if (!string.IsNullOrEmpty(saveError))
            {
                <div class="alert alert-danger">@saveError</div>
            }

            <div class="mobile-panel">
                <label class="form-label">Song</label>
                @if (songPickerItems.Count == 0)
                {
                    <p class="text-muted small mb-0">No songs in the catalog yet. Use + New song below.</p>
                }
                else
                {
                    <SfComboBox TValue="int?" TItem="LogSongPickItem" DataSource="@songPickerItems"
                                @bind-Value="selectedSongId" @bind-Value:after="OnSongSelectedAsync"
                                Placeholder="Search songs..." AllowFiltering="true" ShowClearButton="true"
                                Enabled="@(!showNewSong)"
                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                PopupHeight="280px">
                        <ComboBoxFieldSettings Value="Id" Text="Display" />
                    </SfComboBox>
                    <p class="small text-muted mt-1 mb-0">@songPickerItems.Count songs · ★ = on My repertoire · 🎯 = working up</p>
                }
                @if (selectedSongId is int songId && songHint is not null)
                {
                    <p class="small text-muted mt-2 mb-0">@songHint</p>
                }
                @if (selectedSongId is int workingUpSongId && !usingOfflineCatalog && !workingUpSongIds.Contains(workingUpSongId))
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" disabled="@isAddingToWorkingUp"
                            @onclick="AddToWorkingUpAsync">
                        Add to working up
                    </button>
                    @if (!string.IsNullOrEmpty(workingUpMessage))
                    {
                        <p class="small text-success mt-1 mb-0">@workingUpMessage</p>
                    }
                    @if (!string.IsNullOrEmpty(workingUpError))
                    {
                        <p class="small text-danger mt-1 mb-0">@workingUpError</p>
                    }
                }

                @if (!usingOfflineCatalog)
                {
                    @if (!showNewSong)
                    {
                        <button type="button" class="btn btn-link btn-sm ps-0 mt-2" @onclick="OpenNewSongPanel">
                            + New song
                        </button>
                    }
                    else
                    {
                        <AddSongPanel OnSongAdded="OnNewSongAddedAsync"
                                      OnCancelled="CloseNewSongPanel" />
                    }
                }
            </div>

            @if (SelectedSong is not null && mySingerId is not null)
            {
                <QuickLogPerformance SongId="SelectedSong.Id" Title="@SelectedSong.Title"
                                     ArtistName="@SelectedSong.ArtistName" SingerId="mySingerId"
                                     OnPerformanceSaved="OnPerformanceSavedAsync" />
            }

            @if (recentLogs.Count > 0)
            {
                <div class="mobile-panel recent-logs-panel">
                    <h2 class="h6 mb-2">Recently logged@(usingOfflineCatalog && !hasCachedCatalog ? " — tap to pick a song" : "")</h2>
                    <ul class="recent-log-list">
                        @foreach (var entry in recentLogs)
                        {
                            <li>
                                <button type="button" class="recent-log-item" @onclick="() => SelectSongAsync(entry.SongId)">
                                    <span class="recent-log-title">
                                        @ShowHostMessageFormatting.Format(entry.Title, entry.ArtistName, entry.KeyChangeSemitones)
                                    </span>
                                    <span class="recent-log-meta">
                                        @entry.PerformedOn.ToString("d") · @entry.VenueName · @KeyChangeFormatting.Describe(entry.KeyChangeSemitones)
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int? SongId { get; set; }

    private bool isLoading = true;
    private bool needsSingerLink;
    private bool usingOfflineCatalog;
    private bool hasCachedCatalog;
    private DateTime? catalogCachedAt;
    private int? mySingerId;
    private HashSet<int> repertoireSongIds = [];
    private HashSet<int> workingUpSongIds = [];
    private List<SingerListDto> singerLists = [];
    private List<LogSongPickItem> songPickerItems = [];

    private int? selectedSongId;
    private string? songHint;
    private string? saveMessage;
    private string? saveError;

    private bool showNewSong;
    private bool isAddingToWorkingUp;
    private string? workingUpMessage;
    private string? workingUpError;
    private IReadOnlyList<RecentLoggedPerformance> recentLogs = [];

    private LogSongPickItem? SelectedSong
    {
        get
        {
            if (selectedSongId is not int id)
            {
                return null;
            }

            var fromPicker = songPickerItems.FirstOrDefault(s => s.Id == id);
            if (fromPicker is not null)
            {
                return fromPicker;
            }

            var fromRecent = recentLogs.FirstOrDefault(r => r.SongId == id);
            return fromRecent is null
                ? null
                : new LogSongPickItem(
                    fromRecent.SongId,
                    fromRecent.Title,
                    fromRecent.ArtistName,
                    repertoireSongIds.Contains(id),
                    workingUpSongIds.Contains(id));
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (SongId is int id && !isLoading && selectedSongId != id)
        {
            selectedSongId = id;
            await OnSongChangedAsync(id);
        }
    }

    private async Task OnSingerLinkedAsync(int? singerId)
    {
        mySingerId = singerId;
        needsSingerLink = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        saveError = null;
        usingOfflineCatalog = false;
        hasCachedCatalog = false;
        catalogCachedAt = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        mySingerId = authState.User.GetSingerId();
        if (mySingerId is null)
        {
            try
            {
                var profile = await Api.GetProfileAsync();
                mySingerId = profile?.SingerId;
            }
            catch (Exception ex) when (ApiTransientFailure.IsTransient(ex) || ex is HttpRequestException)
            {
                // Offline: rely on singer claim from JWT when profile API is unreachable.
            }
        }

        needsSingerLink = mySingerId is null;

        if (needsSingerLink)
        {
            isLoading = false;
            return;
        }

        var catalog = await CatalogLoader.LoadAsync();
        usingOfflineCatalog = catalog.FromCache;
        hasCachedCatalog = catalog.HasCatalog;
        catalogCachedAt = catalog.CachedAtUtc;
        songPickerItems = catalog.Songs.ToList();
        repertoireSongIds = catalog.RepertoireSongIds;
        workingUpSongIds = catalog.WorkingUpSongIds;

        if (!catalog.FromCache)
        {
            var listsResult = await Api.GetMyListsAsync();
            if (listsResult.Succeeded)
            {
                singerLists = listsResult.Lists;
            }
        }

        recentLogs = await LogStore.GetRecentLogsAsync();
        isLoading = false;

        if (SongId is int querySongId)
        {
            selectedSongId = querySongId;
            await OnSongChangedAsync(querySongId);
        }
    }

    private async Task OnSongSelectedAsync() => await OnSongChangedAsync(selectedSongId);

    private async Task OnSongChangedAsync(int? songId)
    {
        songHint = null;
        workingUpMessage = null;
        workingUpError = null;
        if (songId is null)
        {
            return;
        }

        if (usingOfflineCatalog)
        {
            songHint = repertoireSongIds.Contains(songId.Value)
                ? "Ready to log (offline — using cached catalog)."
                : "Ready to log.";
            return;
        }

        try
        {
            var result = await Api.GetMySongSummaryAsync(songId.Value);
            if (!result.Succeeded || result.Summary is null)
            {
                songHint = "Ready to log.";
                return;
            }

            var summary = result.Summary;
            if (summary.PerformanceCount > 0)
            {
                songHint = $"You've sung this {summary.PerformanceCount} time(s). Last: {summary.LastPerformedOn:d} · {KeyChangeFormatting.Describe(summary.LastKeyChangeSemitones)}";
            }
            else
            {
                songHint = "First time logging this song for you.";
            }
        }
        catch (Exception ex) when (ApiTransientFailure.IsTransient(ex) || ex is HttpRequestException)
        {
            songHint = "Ready to log (offline).";
        }
    }

    private async Task OnPerformanceSavedAsync(string? message)
    {
        selectedSongId = null;
        songHint = null;
        saveMessage = message;
        saveError = null;
        recentLogs = await LogStore.GetRecentLogsAsync();

        if (!usingOfflineCatalog)
        {
            var catalog = await CatalogLoader.LoadAsync();
            songPickerItems = catalog.Songs.ToList();
            repertoireSongIds = catalog.RepertoireSongIds;
            workingUpSongIds = catalog.WorkingUpSongIds;
            usingOfflineCatalog = catalog.FromCache;
            hasCachedCatalog = catalog.HasCatalog;
            catalogCachedAt = catalog.CachedAtUtc;
        }
    }

    private async Task SelectSongAsync(int songId)
    {
        selectedSongId = songId;
        await OnSongChangedAsync(songId);
    }

    private void OpenNewSongPanel()
    {
        saveError = null;
        showNewSong = true;
    }

    private void CloseNewSongPanel() => showNewSong = false;

    private async Task OnNewSongAddedAsync(SongAddedEventArgs args)
    {
        saveError = null;
        var catalog = await CatalogLoader.LoadAsync();
        songPickerItems = catalog.Songs.ToList();
        repertoireSongIds = catalog.RepertoireSongIds;
        workingUpSongIds = catalog.WorkingUpSongIds;

        var created = LogArtistPicker.FindCreatedSong(
            songPickerItems,
            args.Title,
            args.ArtistName,
            s => s.Title,
            s => s.ArtistName);

        if (created is not null)
        {
            selectedSongId = created.Id;
            await OnSongChangedAsync(created.Id);
        }

        showNewSong = false;
        saveMessage = "Song added.";
    }

    private async Task AddToWorkingUpAsync()
    {
        if (selectedSongId is not int songId)
        {
            return;
        }

        var workingUpList = singerLists.FirstOrDefault(l => l.Kind == SingerListKind.WorkingUp);
        if (workingUpList is null)
        {
            workingUpError = "Working up list was not found.";
            return;
        }

        isAddingToWorkingUp = true;
        workingUpError = null;
        workingUpMessage = null;

        var result = await Api.AddListSongAsync(workingUpList.Id, songId);
        if (!result.Succeeded)
        {
            workingUpError = result.ErrorMessage;
            isAddingToWorkingUp = false;
            return;
        }

        workingUpSongIds.Add(songId);
        workingUpMessage = "Added to working up.";
        isAddingToWorkingUp = false;
    }
}
