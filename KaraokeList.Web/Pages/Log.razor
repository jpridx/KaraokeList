@page "/log"
@attribute [Authorize]

<SingerGatedPage DocumentTitle="Log performance"
                 Title="Log performance"
                 WithBottomNav="true"
                 OnResolved="LoadCatalogAsync">
    <Subtitle>Pick a song, or open one from <a href="my-songs">My Songs</a>.</Subtitle>
    <ChildContent Context="singerId">
        <MobileLoadingState IsLoading="@isLoading" DetailMessage="@loadingStep">
                <OfflineCacheNotice UsingOffline="@catalogState.UsingOfflineCatalog"
                                    HasCachedData="@catalogState.HasCachedCatalog"
                                    CachedAt="@catalogState.CatalogCachedAt"
                                    ResourceName="songs"
                                    RefreshHint="Connect to refresh the catalog.">
                    <UnavailableContent>
                        Song catalog isn't available offline yet. Pick from <strong>Recently logged</strong> below,
                        or open Log once while online to cache songs.
                    </UnavailableContent>
                </OfflineCacheNotice>

                <StatusAlerts SuccessMessage="@saveMessage" ErrorMessage="@saveError" />

                <LogSongPickerPanel Items="@catalogState.SongPickerItems"
                                    @bind-SelectedSongId="selectedSongId"
                                    OnSelectedSongIdAfter="OnSongSelectedAsync"
                                    SongHint="@songHint"
                                    UsingOfflineCatalog="@catalogState.UsingOfflineCatalog"
                                    SingerLists="@singerLists"
                                    WorkingUpSongIds="@catalogState.WorkingUpSongIds"
                                    OnAddedToWorkingUp="OnAddedToWorkingUpAsync"
                                    OnSongAdded="OnNewSongAddedAsync" />

                @if (SelectedSong is not null)
                {
                    <section class="mobile-panel music-service-panel">
                        <h2 class="h6 mb-2">Listen</h2>
                        <MusicServiceListenLink Title="@SelectedSong.Title" ArtistName="@SelectedSong.ArtistName" />
                    </section>

                    <QuickLogPerformance SongId="@SelectedSong.Id" Title="@SelectedSong.Title"
                                         ArtistName="@SelectedSong.ArtistName" SingerId="@singerId"
                                         OnPerformanceSaved="OnPerformanceSavedAsync" />
                }

                @if (recentLogs.Count > 0)
                {
                    <div class="mobile-panel recent-logs-panel">
                        <RecentLogList Items="@recentLogs"
                                       Heading="Recently logged"
                                       HeadingSuffix="@(catalogState.UsingOfflineCatalog && !catalogState.HasCachedCatalog ? " — tap to pick a song" : string.Empty)"
                                       IncludeKeyInMeta="true"
                                       OnItemSelected="SelectSongAsync" />
                    </div>
                }
            </MobileLoadingState>
    </ChildContent>
</SingerGatedPage>
