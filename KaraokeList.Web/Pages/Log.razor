@page "/log"
@attribute [Authorize]
@inject IKaraokeApiClient Api
@inject ILogPerformanceLocalStore LogStore

<PageTitle>Log performance</PageTitle>

<div class="mobile-page mobile-page-with-nav">
    <header class="mobile-page-header">
        <h1 class="h4 mb-1">Log performance</h1>
        <p class="text-muted small mb-0">Pick a song, or open one from <a href="my-songs">My Songs</a>.</p>
    </header>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <SingerLinkPanel Visible="needsSingerLink" OnLinked="OnSingerLinkedAsync" />

        @if (!needsSingerLink)
        {
            @if (!string.IsNullOrEmpty(saveMessage))
            {
                <div class="alert alert-success">@saveMessage</div>
            }
            @if (!string.IsNullOrEmpty(saveError))
            {
                <div class="alert alert-danger">@saveError</div>
            }

            <div class="mobile-panel">
                <label class="form-label">Song</label>
                @if (songPickerItems.Count == 0)
                {
                    <p class="text-muted small mb-0">No songs in the catalog yet. Use + New song below.</p>
                }
                else
                {
                    <SfComboBox TValue="int?" TItem="SongPickItem" DataSource="@songPickerItems"
                                @bind-Value="selectedSongId" @bind-Value:after="OnSongSelectedAsync"
                                Placeholder="Search songs..." AllowFiltering="true" ShowClearButton="true"
                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                PopupHeight="280px">
                        <ComboBoxFieldSettings Value="Id" Text="Display" />
                    </SfComboBox>
                    <p class="small text-muted mt-1 mb-0">@songPickerItems.Count songs · ★ = you've sung it before</p>
                }
                @if (selectedSongId is int songId && songHint is not null)
                {
                    <p class="small text-muted mt-2 mb-0">@songHint</p>
                }

                <button type="button" class="btn btn-link btn-sm ps-0 mt-2" @onclick="ToggleNewSong">
                    @(showNewSong ? "Hide new song" : "+ New song")
                </button>
                @if (showNewSong)
                {
                    <div class="border-top pt-3 mt-2">
                        <label class="form-label">Title</label>
                        <input class="form-control mb-2" @bind="newSongTitle" />
                        <label class="form-label">Artist</label>
                        <SfDropDownList TValue="int?" TItem="ArtistLookupDto" DataSource="@artistLookups"
                                        @bind-Value="newSongArtistId" Placeholder="Select artist"
                                        AllowFiltering="true"
                                        FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                        <label class="form-label mt-2">Genre (optional)</label>
                        <SfDropDownList TValue="int?" TItem="GenreDto" DataSource="@genres" @bind-Value="newSongGenreId"
                                        Placeholder="Select genre" AllowFiltering="true"
                                        FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                            <DropDownListFieldSettings Value="Id" Text="GenreName" />
                        </SfDropDownList>
                        <button type="button" class="btn btn-outline-primary w-100 mt-3" @onclick="SaveNewSongAsync">
                            Add song
                        </button>
                    </div>
                }
            </div>

            @if (SelectedSong is not null && mySingerId is not null)
            {
                <QuickLogPerformance SongId="SelectedSong.Id" Title="@SelectedSong.Title"
                                     ArtistName="@SelectedSong.ArtistName" SingerId="mySingerId"
                                     OnPerformanceSaved="OnPerformanceSavedAsync" />
            }

            @if (recentLogs.Count > 0)
            {
                <div class="mobile-panel recent-logs-panel">
                    <h2 class="h6 mb-2">Recently logged</h2>
                    <ul class="recent-log-list">
                        @foreach (var entry in recentLogs)
                        {
                            <li>
                                <button type="button" class="recent-log-item" @onclick="() => SelectSongAsync(entry.SongId)">
                                    <span class="recent-log-title">
                                        @ShowHostMessageFormatting.Format(entry.Title, entry.ArtistName, entry.KeyChangeSemitones)
                                    </span>
                                    <span class="recent-log-meta">
                                        @entry.PerformedOn.ToString("d") · @entry.VenueName · @KeyChangeFormatting.Describe(entry.KeyChangeSemitones)
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int? SongId { get; set; }

    private bool isLoading = true;
    private bool needsSingerLink;
    private int? mySingerId;
    private List<SongDto> songs = [];
    private List<ArtistLookupDto> artistLookups = [];
    private List<GenreDto> genres = [];
    private HashSet<int> repertoireSongIds = [];
    private List<SongPickItem> songPickerItems = [];

    private int? selectedSongId;
    private string? songHint;
    private string? saveMessage;
    private string? saveError;

    private bool showNewSong;
    private string newSongTitle = string.Empty;
    private int? newSongArtistId;
    private int? newSongGenreId;
    private IReadOnlyList<RecentLoggedPerformance> recentLogs = [];

    private SongPickItem? SelectedSong =>
        selectedSongId is int id ? songPickerItems.FirstOrDefault(s => s.Id == id) : null;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (SongId is int id && !isLoading && selectedSongId != id)
        {
            selectedSongId = id;
            await OnSongChangedAsync(id);
        }
    }

    private async Task OnSingerLinkedAsync(int? singerId)
    {
        mySingerId = singerId;
        needsSingerLink = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        saveError = null;

        var profile = await Api.GetProfileAsync();
        mySingerId = profile?.SingerId;
        needsSingerLink = mySingerId is null;

        if (needsSingerLink)
        {
            isLoading = false;
            return;
        }

        songs = await Api.GetSongsAsync();
        artistLookups = await Api.GetArtistLookupsAsync();
        genres = await Api.GetGenresAsync();

        var repertoire = await Api.GetMyRepertoireAsync();
        if (repertoire.Succeeded)
        {
            repertoireSongIds = repertoire.Songs.Select(s => s.SongId).ToHashSet();
        }

        RebuildSongPicker();
        recentLogs = await LogStore.GetRecentLogsAsync();
        isLoading = false;

        if (SongId is int querySongId)
        {
            selectedSongId = querySongId;
            await OnSongChangedAsync(querySongId);
        }
    }

    private void RebuildSongPicker()
    {
        var artistNames = artistLookups.ToDictionary(a => a.Id, a => a.Name);
        songPickerItems = songs
            .Select(s => new SongPickItem
            {
                Id = s.Id,
                Title = s.Title,
                ArtistName = s.Artist is int artistId && artistNames.TryGetValue(artistId, out var name) ? name : "",
                InRepertoire = repertoireSongIds.Contains(s.Id)
            })
            .OrderByDescending(s => s.InRepertoire)
            .ThenBy(s => s.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task OnSongSelectedAsync() => await OnSongChangedAsync(selectedSongId);

    private async Task OnSongChangedAsync(int? songId)
    {
        songHint = null;
        if (songId is null)
        {
            return;
        }

        var result = await Api.GetMySongSummaryAsync(songId.Value);
        if (!result.Succeeded || result.Summary is null)
        {
            songHint = "Ready to log.";
            return;
        }

        var summary = result.Summary;
        if (summary.PerformanceCount > 0)
        {
            songHint = $"You've sung this {summary.PerformanceCount} time(s). Last: {summary.LastPerformedOn:d}";
        }
        else
        {
            songHint = "First time logging this song for you.";
        }
    }

    private async Task OnPerformanceSavedAsync()
    {
        selectedSongId = null;
        songHint = null;
        saveMessage = "Performance saved.";
        recentLogs = await LogStore.GetRecentLogsAsync();

        var repertoire = await Api.GetMyRepertoireAsync();
        if (repertoire.Succeeded)
        {
            repertoireSongIds = repertoire.Songs.Select(s => s.SongId).ToHashSet();
            RebuildSongPicker();
        }
    }

    private async Task SelectSongAsync(int songId)
    {
        selectedSongId = songId;
        await OnSongChangedAsync(songId);
    }

    private async Task SaveNewSongAsync()
    {
        saveError = null;
        if (string.IsNullOrWhiteSpace(newSongTitle) || newSongArtistId is null)
        {
            saveError = "Song title and artist are required.";
            return;
        }

        try
        {
            await Api.CreateSongAsync(new SongDto
            {
                Title = newSongTitle.Trim(),
                Artist = newSongArtistId,
                Genre = newSongGenreId
            });

            songs = await Api.GetSongsAsync();
            RebuildSongPicker();
            var created = songs.FirstOrDefault(s =>
                s.Title.Equals(newSongTitle.Trim(), StringComparison.OrdinalIgnoreCase)
                && s.Artist == newSongArtistId);
            if (created is not null)
            {
                selectedSongId = created.Id;
                await OnSongChangedAsync(created.Id);
            }

            newSongTitle = string.Empty;
            newSongArtistId = null;
            newSongGenreId = null;
            showNewSong = false;
            saveMessage = "Song added.";
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
    }

    private void ToggleNewSong() => showNewSong = !showNewSong;

    private sealed class SongPickItem
    {
        public int Id { get; init; }
        public string Title { get; init; } = string.Empty;
        public string ArtistName { get; init; } = string.Empty;
        public bool InRepertoire { get; init; }
        public string Display => InRepertoire ? $"{Title} - {ArtistName} ★" : $"{Title} - {ArtistName}";
    }
}
