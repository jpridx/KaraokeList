@page "/my-stats"
@attribute [Authorize]
@inject IKaraokeApiClient Api

<SingerGatedPage DocumentTitle="My stats"
                 Title="My stats"
                 OnResolved="LoadStatsAsync"
                 @ref="gatedPage">
    <Subtitle>Your karaoke performance history at a glance.</Subtitle>
    <ChildContent Context="_">
        <MobileLoadingState IsLoading="@loading" Message="@ApiTransientFailure.DatabaseWakingUpMessage" CssClass="text-muted small mt-3">
            <StatusAlerts ErrorMessage="@errorMessage" InlineError="true" Small="true" CssClass="mt-3" />

            @if (string.IsNullOrWhiteSpace(errorMessage))
            {
                @if (stats is null or { TotalPerformances: 0 })
                {
                    <NoPerformancesEmptyState ActionText="Log your first performance"
                                              ActionButtonClass="btn btn-primary btn-sm"
                                              CssClass="mobile-panel mt-3"
                                              MessageClass="mb-2" />
                }
                else
                {
                    <SingerStatsDisplay Stats="@stats" CssClass="mt-3 mobile-panel"
                                        Subtitle="Totals, favorites, and recent additions to your repertoire." />
                }
            }
        </MobileLoadingState>
    </ChildContent>
</SingerGatedPage>

@code {
    private const int DefaultTopVenues = 5;
    private const int DefaultTopSongs = 10;
    private const int DefaultTopArtists = 10;
    private const int DefaultNewRepertoireDays = 30;

    private SingerGatedPage? gatedPage;
    private bool loading = true;
    private SingerStatsDto? stats;
    private string? errorMessage;

    private Task LoadStatsAsync(int singerId) => ReloadStatsAsync();

    private async Task ReloadStatsAsync()
    {
        loading = true;
        errorMessage = null;

        var result = await Api.GetMySingerStatsAsync(
            topVenues: DefaultTopVenues,
            topSongs: DefaultTopSongs,
            topArtists: DefaultTopArtists,
            newRepertoireDays: DefaultNewRepertoireDays);

        if (result.Succeeded)
        {
            stats = result.Stats;
        }
        else
        {
            errorMessage = result.ErrorMessage;
            gatedPage.RequireLinkIfNotLinked(result.ErrorMessage);
        }

        loading = false;
    }
}
