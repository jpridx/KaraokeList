@page "/import-repertoire"
@attribute [Authorize]
@inject IKaraokeApiClient Api
@inject IMySongsLocalStore MySongsStore
@inject IMyListsLoader MyListsLoader
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Import to list</PageTitle>

<div class="mobile-page">
    <MobilePageHeader Title="Import to list" BackHref="/more" BackText="← More" />

    <p class="text-muted small mb-3">
        Upload a spreadsheet of songs you've sung or want to track.
        Each row is matched to the shared catalog by <strong>title</strong> and <strong>artist</strong>.
        Songs not in the catalog are skipped — ask an admin to import them first.
    </p>

    @if (!string.IsNullOrEmpty(pageError))
    {
        <StatusAlerts ErrorMessage="@pageError" />
    }

    <section class="more-section">
        <h2 class="more-section-title">Target list</h2>
        <select class="form-select form-select-sm" @bind="listKind">
            <option value="@SingerListKind.MyRepertoire">My repertoire</option>
            <option value="@SingerListKind.WantToSing">Want to sing</option>
            <option value="@SingerListKind.WorkingUp">Working up</option>
        </select>
        @if (listKind == SingerListKind.WantToSing)
        {
            <p class="text-muted small mt-2 mb-0">
                Want to sing only accepts songs you haven't performed and aren't already on My repertoire.
            </p>
        }
    </section>

    <section class="more-section">
        <h2 class="more-section-title">Upload file</h2>
        <p class="text-muted small mb-2">
            Accepts <strong>.csv</strong>, <strong>.tsv</strong>, and <strong>.xlsx</strong>.
            Default column order: <em>Song, Artist, Genre, Year</em> — or include a header row to use any order.
        </p>
        <InputFile OnChange="OnFileSelectedAsync" accept=".csv,.tsv,.txt,.xlsx,.xls"
                   class="form-control form-control-sm mb-2" />
        <button type="button" class="btn btn-primary btn-sm"
                @onclick="ImportFileAsync"
                disabled="@(selectedFile is null || isImporting)">
            @(isImporting && importMode == ImportMode.File ? "Importing…" : "Import file")
        </button>
    </section>

    <section class="more-section">
        <h2 class="more-section-title">Google Sheets</h2>
        <p class="text-muted small mb-2">
            Paste the sharing URL of a Google Sheet with public view access.
            The first sheet tab is imported.
        </p>
        <input type="url" @bind="sheetUrl" @bind:event="oninput"
               class="form-control form-control-sm mb-2"
               placeholder="https://docs.google.com/spreadsheets/d/…" />
        <button type="button" class="btn btn-primary btn-sm"
                @onclick="ImportGSheetAsync"
                disabled="@(string.IsNullOrWhiteSpace(sheetUrl) || isImporting)">
            @(isImporting && importMode == ImportMode.GSheet ? "Importing…" : "Import from Google Sheets")
        </button>
    </section>

    @if (importResult is not null)
    {
        <section class="more-section">
            <h2 class="more-section-title">Import results</h2>
            <dl class="row mb-2 small">
                <dt class="col-6">Total rows</dt><dd class="col-6">@importResult.TotalRows</dd>
                <dt class="col-6">Matched catalog</dt><dd class="col-6">@importResult.Matched</dd>
                <dt class="col-6">Not in catalog</dt><dd class="col-6">@importResult.NotFound</dd>
                <dt class="col-6">Added to list</dt><dd class="col-6">@importResult.Added</dd>
                <dt class="col-6">Already on list</dt><dd class="col-6">@importResult.Skipped</dd>
                <dt class="col-6">Rejected</dt><dd class="col-6">@importResult.Rejected</dd>
                <dt class="col-6">Errors</dt><dd class="col-6">@importResult.Errors.Count</dd>
            </dl>
            @if (importResult.Errors.Count > 0)
            {
                <details>
                    <summary class="small text-muted">Show @importResult.Errors.Count error(s)</summary>
                    <table class="table table-sm mt-2">
                        <thead><tr><th>Row</th><th>Error</th></tr></thead>
                        <tbody>
                            @foreach (var err in importResult.Errors)
                            {
                                <tr><td>@err.Row</td><td>@err.Message</td></tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
            @if (importResult.Added > 0)
            {
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="GoToMySongsAsync">
                    View @ListDisplayName
                </button>
            }
        </section>
    }
</div>

@code {
    private enum ImportMode { None, File, GSheet }

    private IBrowserFile? selectedFile;
    private string sheetUrl = string.Empty;
    private SingerListKind listKind = SingerListKind.MyRepertoire;
    private bool isImporting;
    private ImportMode importMode = ImportMode.None;
    private ImportSingerListFromFileResponse? importResult;
    private string? pageError;

    private string ListDisplayName => SingerListKindNames.DisplayName(listKind);

    private async Task GoToMySongsAsync()
    {
        await MySongsStore.SetListKindAsync(listKind);
        Navigation.NavigateTo("my-songs");
    }

    private void OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        importResult = null;
        pageError = null;
    }

    private async Task ImportFileAsync()
    {
        if (selectedFile is null || isImporting) return;
        isImporting = true;
        importMode = ImportMode.File;
        importResult = null;
        pageError = null;

        try
        {
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            var result = await Api.ImportListSongsFromFileAsync(stream, selectedFile.Name, listKind);
            if (result.Succeeded && result.Response is not null)
            {
                importResult = result.Response;
                await ClearListCacheAsync();
            }
            else
            {
                importResult = result.Response;
                pageError = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            pageError = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            importMode = ImportMode.None;
        }
    }

    private async Task ImportGSheetAsync()
    {
        if (string.IsNullOrWhiteSpace(sheetUrl) || isImporting) return;
        isImporting = true;
        importMode = ImportMode.GSheet;
        importResult = null;
        pageError = null;

        try
        {
            var result = await Api.ImportListSongsFromGSheetAsync(new ImportSingerListFromGSheetRequest
            {
                SheetUrl = sheetUrl,
                ListKind = listKind
            });
            if (result.Succeeded && result.Response is not null)
            {
                importResult = result.Response;
                await ClearListCacheAsync();
            }
            else
            {
                importResult = result.Response;
                pageError = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            pageError = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            importMode = ImportMode.None;
        }
    }

    private async Task ClearListCacheAsync()
    {
        try
        {
            await MyListsLoader.InvalidateAndReloadAsync();
        }
        catch
        {
            // Cache clear/refresh is best-effort after import.
        }
    }
}
