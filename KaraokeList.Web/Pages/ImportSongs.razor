@page "/admin/import-songs"
@attribute [Authorize(Roles = KaraokeRoles.Admin)]
@inject IKaraokeApiClient Api
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Catalog tools</PageTitle>

<div class="mobile-page">
    <MobilePageHeader Title="Catalog tools" BackHref="/admin/catalog" BackText="← Catalog maintenance" />

    @if (!string.IsNullOrEmpty(pageError))
    {
        <StatusAlerts ErrorMessage="@pageError" />
    }

    @if (isLoadingCatalog)
    {
        <p class="text-muted small mb-2" role="status" aria-live="polite">Loading catalog…</p>
    }

    @* ── Verify existing catalog ──────────────────────────────────── *@
    <section id="verify" class="more-section">
        <h2 class="more-section-title">Verify existing catalog</h2>
        <p class="text-muted small mb-2">
            Check songs against MusicBrainz and apply canonical title, artist, year, and genre.
            Processes up to 10 songs per batch (about 2 seconds per song) to avoid browser timeouts.
        </p>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="verifyUnverifiedOnly" @bind="verifyUnverifiedOnly" />
            <label class="form-check-label small" for="verifyUnverifiedOnly">
                Only songs without a MusicBrainz match
            </label>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm"
                @onclick="() => VerifyCatalogAsync(advanceBatch: false)"
                disabled="@isVerifying">
            @(isVerifying ? "Verifying…" : verifyResult is null ? "Verify batch" : "Restart verification")
        </button>

        @if (verifyResult is not null)
        {
            <dl class="row mb-2 small mt-2">
                <dt class="col-6">@(verifyUnverifiedOnly ? "Unverified songs" : "Songs in catalog")</dt><dd class="col-6">@verifyResult.TotalMatching</dd>
                <dt class="col-6">Scanned this batch</dt><dd class="col-6">@verifyResult.Scanned</dd>
            </dl>

            @if (verifyResult.Items.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm mt-2">
                        <thead>
                            <tr>
                                <th>Current</th>
                                <th>MusicBrainz</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in verifyResult.Items)
                            {
                                <tr>
                                    <td>
                                        <div>@item.CurrentTitle — @item.CurrentArtistDisplay</div>
                                        @if (item.CurrentYear is int year || !string.IsNullOrWhiteSpace(item.CurrentGenreName))
                                        {
                                            <div class="text-muted small">
                                                @if (item.CurrentYear is int currentYear)
                                                {
                                                    <span>@currentYear</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.CurrentGenreName))
                                                {
                                                    <span class="@(item.CurrentYear is int ? "ms-1" : null)">@item.CurrentGenreName</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Suggestion is not null)
                                        {
                                            <span>@item.Suggestion.Title — @item.Suggestion.ArtistCreditDisplay</span>
                                            @if (item.Suggestion.Year is int suggestedYear || !string.IsNullOrWhiteSpace(item.Suggestion.SuggestedGenreName))
                                            {
                                                <div class="text-muted small">
                                                    @if (item.Suggestion.Year is int suggestedYearValue)
                                                    {
                                                        <span>@suggestedYearValue</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.Suggestion.SuggestedGenreName))
                                                    {
                                                        <span class="@(item.Suggestion.Year is int ? "ms-1" : null)">@item.Suggestion.SuggestedGenreName</span>
                                                    }
                                                </div>
                                            }
                                            @if (item.NamesMatch)
                                            {
                                                <span class="badge bg-success ms-1">match</span>
                                            }
                                            @if (item.Alternatives.Count > 0)
                                            {
                                                <details class="small mt-1">
                                                    <summary class="text-muted">@item.Alternatives.Count other match@(item.Alternatives.Count == 1 ? "" : "es"), oldest first</summary>
                                                    <ul class="list-unstyled mb-0 mt-1">
                                                        @foreach (var alt in item.Alternatives)
                                                        {
                                                            <li class="mb-1">
                                                                <div>@alt.Title — @alt.ArtistCreditDisplay</div>
                                                                @if (alt.Year is int altYear)
                                                                {
                                                                    <span class="text-muted">@altYear</span>
                                                                }
                                                                <button type="button" class="btn btn-link btn-sm p-0 ms-1"
                                                                        disabled="@(applyingSongId == item.SongId)"
                                                                        @onclick="() => ApplyAlternativeAsync(item, alt)">
                                                                    Use this
                                                                </button>
                                                            </li>
                                                        }
                                                    </ul>
                                                </details>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No match</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Suggestion is not null && (!item.NamesMatch || item.MetadataNeedsApply))
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm"
                                                    disabled="@(applyingSongId == item.SongId)"
                                                    @onclick="() => ApplyVerifiedAsync(item)">
                                                @(applyingSongId == item.SongId ? "Applying…" : "Apply")
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (verifyResult.HasMore)
            {
                <button type="button" class="btn btn-link btn-sm p-0"
                        @onclick="() => VerifyCatalogAsync(advanceBatch: true)" disabled="@isVerifying">
                    Verify next batch
                </button>
            }
        }
    </section>

    @* ── Reset MusicBrainz matches ────────────────────────────────── *@
    <section class="more-section">
        <h2 class="more-section-title">Reset MusicBrainz matches</h2>
        <p class="text-muted small mb-2">
            Clear stored MusicBrainz recording IDs so you can re-verify the catalog from scratch.
            Song titles, artists, and performances are not changed.
        </p>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="clearYearsToo" @bind="clearYearsToo" />
            <label class="form-check-label small" for="clearYearsToo">
                Also clear release years (recommended when fixing wrong dates)
            </label>
        </div>
        <button type="button" class="btn btn-outline-danger btn-sm"
                @onclick="ClearMatchesAsync"
                disabled="@isClearingMatches">
            @(isClearingMatches ? "Clearing…" : "Clear all MusicBrainz matches")
        </button>
        @if (!string.IsNullOrEmpty(clearMatchesMessage))
        {
            <p class="mt-2 small @(clearMatchesSuccess ? "text-success" : "text-danger")">@clearMatchesMessage</p>
        }
    </section>

    @* ── Merge duplicate songs ────────────────────────────────────── *@
    <section class="more-section">
        <h2 class="more-section-title">Merge duplicate songs</h2>
        <p class="text-muted small mb-2">
            Combines two catalog entries into one.
            All performances, lists, and exclusions are updated to use the <strong>target</strong> song.
            The source song is deleted.
        </p>

        <div class="mb-2">
            <label class="form-label small fw-semibold">Source song (will be deleted)</label>
            <input type="text" @bind="mergeSourceSearch" @bind:event="oninput"
                   class="form-control form-control-sm mb-1"
                   placeholder="Search title or artist…" />
            @if (MergeSourceResults.Count > 0 && mergeSource is null)
            {
                <div class="list-group list-group-flush border rounded small" style="max-height:160px;overflow-y:auto">
                    @foreach (var s in MergeSourceResults)
                    {
                        <button type="button" class="list-group-item list-group-item-action py-1"
                                @onclick="() => SelectMergeSource(s)">
                            @s.Title — @GetArtistDisplay(s)
                        </button>
                    }
                </div>
            }
            @if (mergeSource is not null)
            {
                <span class="badge bg-secondary">@mergeSource.Title — @GetArtistDisplay(mergeSource) <button type="button" class="btn-close btn-close-white ms-1" style="font-size:0.6rem" @onclick="() => mergeSource = null"></button></span>
            }
        </div>

        <div class="mb-2">
            <label class="form-label small fw-semibold">Target song (kept)</label>
            <input type="text" @bind="mergeTargetSearch" @bind:event="oninput"
                   class="form-control form-control-sm mb-1"
                   placeholder="Search title or artist…" />
            @if (MergeTargetResults.Count > 0 && mergeTarget is null)
            {
                <div class="list-group list-group-flush border rounded small" style="max-height:160px;overflow-y:auto">
                    @foreach (var s in MergeTargetResults)
                    {
                        <button type="button" class="list-group-item list-group-item-action py-1"
                                @onclick="() => SelectMergeTarget(s)">
                            @s.Title — @GetArtistDisplay(s)
                        </button>
                    }
                </div>
            }
            @if (mergeTarget is not null)
            {
                <span class="badge bg-primary">@mergeTarget.Title — @GetArtistDisplay(mergeTarget) <button type="button" class="btn-close btn-close-white ms-1" style="font-size:0.6rem" @onclick="() => mergeTarget = null"></button></span>
            }
        </div>

        <button type="button" class="btn btn-warning btn-sm"
                @onclick="MergeSongsAsync"
                disabled="@(mergeSource is null || mergeTarget is null || isMerging)">
            @(isMerging ? "Merging…" : "Merge songs")
        </button>

        @if (!string.IsNullOrEmpty(mergeMessage))
        {
            <p class="mt-2 small @(mergeSuccess ? "text-success" : "text-danger")">@mergeMessage</p>
        }
    </section>

    @* ── Import ───────────────────────────────────────────────────── *@
    <section class="more-section">
        <h2 class="more-section-title">Import catalog</h2>
        <p class="text-muted small mb-2">
            Add songs from a file or Google Sheet. Accepts <strong>.csv</strong>, <strong>.tsv</strong>, and <strong>.xlsx</strong>.
            Default column order: <em>Song, Artist, Genre, Year</em> — or include a header row to use any order.
        </p>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="canonicizeImport" @bind="canonicizeOnImport" />
            <label class="form-check-label small" for="canonicizeImport">
                Canonicize names via MusicBrainz (about 1 second per row)
            </label>
        </div>
    </section>

    <section class="more-section">
        <h2 class="more-section-title">Upload file</h2>
        <InputFile OnChange="OnFileSelectedAsync" accept=".csv,.tsv,.txt,.xlsx,.xls"
                   class="form-control form-control-sm mb-2" />
        <button type="button" class="btn btn-primary btn-sm"
                @onclick="ImportFileAsync"
                disabled="@(selectedFile is null || isImporting)">
            @(GetImportButtonLabel(ImportMode.File))
        </button>
        @if (isImporting && importMode == ImportMode.File && !string.IsNullOrEmpty(importProgressMessage))
        {
            <p class="small text-muted mt-2 mb-0">@importProgressMessage</p>
        }
    </section>

    <section class="more-section">
        <h2 class="more-section-title">Google Sheets</h2>
        <p class="text-muted small mb-2">
            Paste the sharing URL of a Google Sheet with public view access.
            The first sheet tab is imported.
        </p>
        <input type="url" @bind="sheetUrl" @bind:event="oninput"
               class="form-control form-control-sm mb-2"
               placeholder="https://docs.google.com/spreadsheets/d/…" />
        <button type="button" class="btn btn-primary btn-sm"
                @onclick="ImportGSheetAsync"
                disabled="@(string.IsNullOrWhiteSpace(sheetUrl) || isImporting)">
            @(GetImportButtonLabel(ImportMode.GSheet))
        </button>
        @if (isImporting && importMode == ImportMode.GSheet && !string.IsNullOrEmpty(importProgressMessage))
        {
            <p class="small text-muted mt-2 mb-0">@importProgressMessage</p>
        }
    </section>

    @if (importResult is not null)
    {
        <section class="more-section">
            <h2 class="more-section-title">Import results</h2>
            <dl class="row mb-2 small">
                <dt class="col-6">Total rows</dt><dd class="col-6">@importResult.TotalRows</dd>
                <dt class="col-6">Added</dt><dd class="col-6">@importResult.Added</dd>
                <dt class="col-6">Skipped (already exist)</dt><dd class="col-6">@importResult.Skipped</dd>
                <dt class="col-6">Canonicized</dt><dd class="col-6">@importResult.Canonicized</dd>
                <dt class="col-6">Errors</dt><dd class="col-6">@importResult.Errors.Count</dd>
            </dl>
            @if (importResult.Errors.Count > 0)
            {
                <details>
                    <summary class="small text-muted">Show @importResult.Errors.Count error(s)</summary>
                    <table class="table table-sm mt-2">
                        <thead><tr><th>Row</th><th>Error</th></tr></thead>
                        <tbody>
                            @foreach (var err in importResult.Errors)
                            {
                                <tr><td>@err.Row</td><td>@err.Message</td></tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
        </section>
    }
</div>

@code {
    private enum ImportMode { None, File, GSheet }

    private IBrowserFile? selectedFile;
    private string sheetUrl = string.Empty;
    private bool canonicizeOnImport = true;
    private bool isImporting;
    private ImportMode importMode = ImportMode.None;
    private string? importProgressMessage;
    private CatalogImportResultDto? importResult;
    private string? pageError;
    private bool isLoadingCatalog = true;

    private bool isVerifying;
    private bool verifyUnverifiedOnly = true;
    private int verifyOffset;
    private CatalogVerifyResultDto? verifyResult;
    private int? applyingSongId;

    private bool isClearingMatches;
    private bool clearYearsToo = true;
    private string? clearMatchesMessage;
    private bool clearMatchesSuccess;

    private List<SongDto> allSongs = [];
    private List<ArtistLookupDto> allArtists = [];
    private string mergeSourceSearch = string.Empty;
    private string mergeTargetSearch = string.Empty;
    private SongDto? mergeSource;
    private SongDto? mergeTarget;
    private bool isMerging;
    private string? mergeMessage;
    private bool mergeSuccess;

    private IReadOnlyList<SongDto> MergeSourceResults =>
        string.IsNullOrWhiteSpace(mergeSourceSearch) || mergeSource is not null
            ? []
            : allSongs
                .Where(s => s.Title.Contains(mergeSourceSearch, StringComparison.OrdinalIgnoreCase)
                         || GetArtistDisplay(s).Contains(mergeSourceSearch, StringComparison.OrdinalIgnoreCase))
                .Take(10)
                .ToList();

    private IReadOnlyList<SongDto> MergeTargetResults =>
        string.IsNullOrWhiteSpace(mergeTargetSearch) || mergeTarget is not null
            ? []
            : allSongs
                .Where(s => s.Title.Contains(mergeTargetSearch, StringComparison.OrdinalIgnoreCase)
                         || GetArtistDisplay(s).Contains(mergeTargetSearch, StringComparison.OrdinalIgnoreCase))
                .Take(10)
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        var loadTask = LoadCatalogAsync();

        if (await Task.WhenAny(loadTask, Task.Delay(ApiSlowRequestNotifier.PageLoadTimeout)) != loadTask)
        {
            pageError = ApiTransientFailure.ColdStartInProgressMessage;
            isLoadingCatalog = false;
            StateHasChanged();

            _ = loadTask.ContinueWith(async t =>
            {
                if (t.IsCompletedSuccessfully)
                {
                    await InvokeAsync(() =>
                    {
                        ApplyCatalogLoad(t.Result);
                        isLoadingCatalog = false;
                        StateHasChanged();
                    });
                }
                else if (t.IsFaulted)
                {
                    await InvokeAsync(() =>
                    {
                        HandleCatalogLoadFailure(t.Exception?.GetBaseException());
                        isLoadingCatalog = false;
                        StateHasChanged();
                    });
                }
            });
            return;
        }

        try
        {
            ApplyCatalogLoad(await loadTask);
        }
        catch (Exception ex)
        {
            HandleCatalogLoadFailure(ex);
        }
        finally
        {
            isLoadingCatalog = false;
        }
    }

    private async Task<(List<SongDto> Songs, List<ArtistLookupDto> Artists)> LoadCatalogAsync()
    {
        var songsTask = Api.GetSongsAsync();
        var artistsTask = Api.GetArtistLookupsAsync();
        await Task.WhenAll(songsTask, artistsTask);
        return (await songsTask, await artistsTask);
    }

    private void ApplyCatalogLoad((List<SongDto> Songs, List<ArtistLookupDto> Artists) result)
    {
        allSongs = result.Songs;
        allArtists = result.Artists;
        pageError = null;
    }

    private void HandleCatalogLoadFailure(Exception? ex)
    {
        pageError = ex is not null && ApiTransientFailure.IsTransient(ex)
            ? ApiTransientFailure.ColdStartInProgressMessage
            : "Could not load the song catalog. Some features may be unavailable.";
    }

    private void OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        importResult = null;
        importProgressMessage = null;
        pageError = null;
    }

    private string GetImportButtonLabel(ImportMode mode) =>
        isImporting && importMode == mode
            ? (canonicizeOnImport ? "Canonicizing…" : "Importing…")
            : mode == ImportMode.GSheet ? "Import from Google Sheets" : "Import file";

    private IProgress<string> CreateImportProgress() =>
        new Progress<string>(message =>
        {
            importProgressMessage = message;
            InvokeAsync(StateHasChanged);
        });

    private async Task ImportFileAsync()
    {
        if (selectedFile is null || isImporting) return;
        isImporting = true;
        importMode = ImportMode.File;
        importResult = null;
        pageError = null;
        importProgressMessage = null;

        try
        {
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            var result = await Api.ImportCatalogFileAsync(
                stream,
                selectedFile.Name,
                canonicizeOnImport,
                CreateImportProgress());
            if (result.Succeeded)
            {
                importResult = result.Response;
                await RefreshSongsAsync();
            }
            else
            {
                pageError = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            pageError = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            importMode = ImportMode.None;
            importProgressMessage = null;
        }
    }

    private async Task ImportGSheetAsync()
    {
        if (string.IsNullOrWhiteSpace(sheetUrl) || isImporting) return;
        isImporting = true;
        importMode = ImportMode.GSheet;
        importResult = null;
        pageError = null;
        importProgressMessage = null;

        try
        {
            var result = await Api.ImportCatalogFromGSheetAsync(
                new GSheetImportRequest { SheetUrl = sheetUrl },
                canonicizeOnImport,
                CreateImportProgress());
            if (result.Succeeded)
            {
                importResult = result.Response;
                await RefreshSongsAsync();
            }
            else
            {
                pageError = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            pageError = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            importMode = ImportMode.None;
            importProgressMessage = null;
        }
    }

    private async Task VerifyCatalogAsync(bool advanceBatch)
    {
        if (isVerifying) return;
        isVerifying = true;
        pageError = null;

        if (!advanceBatch)
        {
            verifyOffset = 0;
        }

        try
        {
            var result = await Api.VerifyCatalogAsync(new CatalogVerifyRequest
            {
                Offset = verifyOffset,
                Limit = CatalogVerifyRequest.RecommendedBatchSize,
                UnverifiedOnly = verifyUnverifiedOnly
            });

            if (result is null)
            {
                pageError = "Catalog verification failed — the request may have timed out. Try again with a smaller catalog batch or check your connection.";
                return;
            }

            verifyResult = result;
            verifyOffset = result.Offset + result.Scanned;
        }
        catch (TaskCanceledException)
        {
            pageError = "Catalog verification timed out. Each batch checks up to 10 songs (~20 seconds). Click Verify next batch to continue.";
        }
        catch (Exception ex)
        {
            pageError = $"Verification failed: {ex.Message}";
        }
        finally
        {
            isVerifying = false;
        }
    }

    private async Task ApplyVerifiedAsync(CatalogVerifyItemDto item)
    {
        if (item.Suggestion is null || applyingSongId is not null) return;
        await ApplyMatchAsync(item, item.Suggestion);
    }

    private async Task ApplyAlternativeAsync(CatalogVerifyItemDto item, CanonicalMatchDto alternative)
    {
        if (applyingSongId is not null) return;
        item.Suggestion = alternative;
        await ApplyMatchAsync(item, alternative);
    }

    private async Task ApplyMatchAsync(CatalogVerifyItemDto item, CanonicalMatchDto match)
    {
        applyingSongId = item.SongId;

        try
        {
            var applied = await Api.ApplyCanonicalAsync(new ApplyCanonicalRequest
            {
                SongId = item.SongId,
                Title = match.Title,
                ArtistName = match.ArtistName,
                ArtistCreditDisplay = match.ArtistCreditDisplay,
                RecordingMbid = match.RecordingMbid,
                ArtistMbid = match.ArtistMbid,
                ArtistCredits = match.ArtistCredits,
                Year = match.Year,
                GenreName = match.SuggestedGenreName
            });

            if (applied is null)
            {
                pageError = $"Could not apply canonical names for song #{item.SongId}.";
                return;
            }

            await RefreshSongsAsync();
            allArtists = await Api.GetArtistLookupsAsync();
            item.NamesMatch = true;
            item.MetadataNeedsApply = false;
            item.CurrentTitle = applied.Title;
            item.CurrentArtistDisplay = applied.ArtistCreditDisplay;
            item.CurrentYear = applied.Year;
            item.CurrentGenreName = applied.GenreName;
            item.RecordingMbid = applied.RecordingMbid;
        }
        catch (Exception ex)
        {
            pageError = $"Apply failed: {ex.Message}";
        }
        finally
        {
            applyingSongId = null;
        }
    }

    private async Task ClearMatchesAsync()
    {
        if (isClearingMatches) return;
        isClearingMatches = true;
        clearMatchesMessage = null;
        pageError = null;

        try
        {
            var result = await Api.ClearCanonicalMatchesAsync(new CatalogClearMatchesRequest
            {
                ClearAll = true,
                ClearYears = clearYearsToo
            });

            if (result is null)
            {
                clearMatchesSuccess = false;
                clearMatchesMessage = "Could not clear MusicBrainz matches.";
                return;
            }

            clearMatchesSuccess = true;
            clearMatchesMessage = result.ClearedCount == 0
                ? "No MusicBrainz matches were stored."
                : $"Cleared {result.ClearedCount} MusicBrainz match{(result.ClearedCount == 1 ? "" : "es")}.";
            verifyResult = null;
            verifyOffset = 0;
            await RefreshSongsAsync();
        }
        catch (Exception ex)
        {
            clearMatchesSuccess = false;
            clearMatchesMessage = $"Clear failed: {ex.Message}";
        }
        finally
        {
            isClearingMatches = false;
        }
    }

    private async Task MergeSongsAsync()
    {
        if (mergeSource is null || mergeTarget is null || isMerging) return;
        isMerging = true;
        mergeMessage = null;

        try
        {
            var result = await Api.MergeSongsAsync(mergeSource.Id, mergeTarget.Id);
            if (result.Succeeded)
            {
                mergeSuccess = true;
                mergeMessage = $"Merged \"{mergeSource.Title}\" into \"{mergeTarget.Title}\" successfully.";
                mergeSource = null;
                mergeTarget = null;
                mergeSourceSearch = string.Empty;
                mergeTargetSearch = string.Empty;
                await RefreshSongsAsync();
            }
            else
            {
                mergeSuccess = false;
                mergeMessage = result.ErrorMessage ?? "Merge failed.";
            }
        }
        catch (Exception ex)
        {
            mergeSuccess = false;
            mergeMessage = $"Merge failed: {ex.Message}";
        }
        finally
        {
            isMerging = false;
        }
    }

    private async Task RefreshSongsAsync()
    {
        try { allSongs = await Api.GetSongsAsync(); } catch { }
    }

    private void SelectMergeSource(SongDto song)
    {
        mergeSource = song;
        mergeSourceSearch = string.Empty;
    }

    private void SelectMergeTarget(SongDto song)
    {
        mergeTarget = song;
        mergeTargetSearch = string.Empty;
    }

    private string GetArtistDisplay(SongDto song) =>
        SongArtistFormatting.FormatDisplay(
            song.ArtistCreditDisplay,
            song.Artists.OrderBy(a => a.DisplayOrder).Select(GetArtistNameFromCredit));

    private string GetArtistNameFromCredit(SongArtistDto credit) =>
        !string.IsNullOrWhiteSpace(credit.Name)
            ? credit.Name
            : allArtists.FirstOrDefault(a => a.Id == credit.ArtistId)?.Name ?? $"#{credit.ArtistId}";
}
