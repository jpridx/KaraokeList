@page "/genres"
@attribute [Authorize(Roles = KaraokeRoles.Admin)]
@inject IKaraokeApiClient Api

<PageTitle>Genres</PageTitle>

<h3>Genres</h3>
<div class="catalog-container">
    <CatalogCrudGrid TItem="GenreDto"
                     Items="@genres"
                     IsLoading="@isLoading"
                     @bind-ErrorMessage="gridError"
                     GetId="@(genre => genre.Id)"
                     OnSaveAsync="SaveGenreAsync"
                     OnDeleteAsync="DeleteGenreAsync"
                     OnReload="ReloadAsync">
        <Columns>
            <GridColumn Field="@nameof(GenreDto.Id)" IsPrimaryKey="true" Visible="false" />
            <GridColumn Field="@nameof(GenreDto.GenreName)" HeaderText="Genre" Width="300" />
        </Columns>
    </CatalogCrudGrid>
</div>

@code {
    private List<GenreDto> genres = [];
    private bool isLoading = true;
    private string? gridError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        genres = await Api.GetGenresAsync();
        isLoading = false;
    }

    private Task<CatalogMutateResult> SaveGenreAsync(GenreDto genre, bool isNew) =>
        isNew ? Api.TryCreateGenreAsync(genre) : Api.TryUpdateGenreAsync(genre);

    private Task<CatalogMutateResult> DeleteGenreAsync(GenreDto genre) =>
        Api.TryDeleteGenreAsync(genre.Id);
}
