@page "/invite-friends"
@attribute [Authorize]
@inject IKaraokeApiClient Api
@inject NavigationManager Navigation

<PageTitle>Invite friends</PageTitle>

<div class="mobile-page">
    <MobilePageHeader Title="Invite friends">
        <Subtitle>Copy a registration link or message for text or email.</Subtitle>
    </MobilePageHeader>

    <MobileLoadingState IsLoading="@loading" CssClass="text-muted mt-3">
        @if (content.Share is null)
        {
            <StatusAlerts ErrorMessage="Could not load invite settings. Is the API running?" />
            <MobileBackLink CssClass="more-link d-inline-block mt-2" />
        }
        else if (!content.CanShareInvite)
        {
            <StatusAlerts InfoMessage="@(content.Share.UnavailableReason ?? "Invite sharing is not available right now.")" />
            <MobileBackLink CssClass="more-link d-inline-block mt-2" />
        }
        else
        {
            <InviteSharePanel Layout="InviteSharePanelLayout.Full"
                              RegisterUrl="@content.RegisterUrl"
                              ShareMessage="@content.ShareMessage" />

            <p class="text-muted small mb-0">
                Send through a private text or email. Anyone signed in can view this page — share only with people you trust.
            </p>
            <MobileBackLink />
        }
    </MobileLoadingState>
</div>

@code {
    private InviteShareContent content = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        content = await InviteShareLoader.LoadAsync(Api, Navigation.BaseUri);
        loading = false;
    }
}
