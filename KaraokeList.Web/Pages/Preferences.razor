@page "/account/preferences"
@page "/account/tickler-settings"
@attribute [Authorize]

<PageTitle>Preferences</PageTitle>

<div class="mobile-page">
    <MobilePageHeader Title="Preferences">
        <Subtitle>
            Control Home tickler suggestions, appearance, and your preferred music app for one-tap search.
        </Subtitle>
    </MobilePageHeader>

    <MobileLoadingState IsLoading="@isLoading" Message="Loading preferences…" CssClass="text-muted small mt-3">
        @if (!string.IsNullOrEmpty(loadError))
        {
            <StatusAlerts ErrorMessage="@loadError" CssClass="mt-3" />
        }
        else
        {
            <StatusAlerts SuccessMessage="@successMessage" ErrorMessage="@errorMessage" CssClass="mt-3" />

            <section class="mobile-panel mt-3">
                <h2 class="h6 mb-3">Appearance</h2>
                <div class="mb-3">
                    <label class="form-label" for="theme-preference">Theme</label>
                    <InputSelect id="theme-preference" class="form-select" @bind-Value="ThemeInput.Preference" @bind-Value:after="OnThemeChangedAsync" disabled="@isSubmitting">
                        @foreach (var theme in ThemePreferenceCatalog.SelectablePreferences)
                        {
                            <option value="@theme">@ThemePreferenceCatalog.GetDisplayName(theme)</option>
                        }
                    </InputSelect>
                    <div class="form-text">
                        Choose light or dark, or match your device setting with System.
                    </div>
                </div>
            </section>

            <section class="mobile-panel mt-3">
                <h2 class="h6 mb-3">Haven't sung in a while</h2>
                <EditForm Model="TicklerInput" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label" for="stale-after-days">Days since last performance</label>
                        <InputNumber id="stale-after-days" class="form-control" @bind-Value="TicklerInput.StaleAfterDays" disabled="@isSubmitting" />
                        <div class="form-text">
                            Show songs you haven't sung in at least this many days (@TicklerSettingsLimits.MinStaleAfterDays–@TicklerSettingsLimits.MaxStaleAfterDays).
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="song-limit">Maximum songs to show</label>
                        <InputNumber id="song-limit" class="form-control" @bind-Value="TicklerInput.SongLimit" disabled="@isSubmitting" />
                        <div class="form-text">
                            How many suggestions appear on Home (@TicklerSettingsLimits.MinSongLimit–@TicklerSettingsLimits.MaxSongLimit).
                        </div>
                    </div>

                    <h2 class="h6 mb-3">Music app</h2>
                    <div class="mb-3">
                        <label class="form-label" for="music-service">Open searches in</label>
                        <InputSelect id="music-service" class="form-select" @bind-Value="MusicServiceInput.Service" disabled="@isSubmitting">
                            <option value="@MusicService.None">Not set</option>
                            @foreach (var service in MusicServiceCatalog.SelectableServices)
                            {
                                <option value="@service">@MusicServiceCatalog.GetDisplayName(service)</option>
                            }
                        </InputSelect>
                        <div class="form-text">
                            Adds a one-tap link on song pages to search the artist and title in your music app.
                        </div>
                    </div>

                    <button class="btn btn-primary w-100" type="submit" disabled="@isSubmitting">
                        @(isSubmitting ? "Saving…" : "Save preferences")
                    </button>
                </EditForm>
            </section>
        }
    </MobileLoadingState>

    <MobileBackLink />
</div>

@code {
    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    [Inject]
    private IThemeService ThemeService { get; set; } = default!;

    private UpdateTicklerSettingsRequest TicklerInput { get; set; } = new();
    private UpdateMusicServicePreferenceRequest MusicServiceInput { get; set; } = new();
    private UpdateThemePreferenceRequest ThemeInput { get; set; } = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string? loadError;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        var ticklerTask = Api.GetTicklerSettingsAsync();
        var musicTask = Api.GetMusicServicePreferenceAsync();
        var themeTask = Api.GetThemePreferenceAsync();
        await Task.WhenAll(ticklerTask, musicTask, themeTask);

        var ticklerResult = await ticklerTask;
        var musicResult = await musicTask;
        var themeResult = await themeTask;

        if (ticklerResult.Succeeded && ticklerResult.Settings is not null)
        {
            TicklerInput = new UpdateTicklerSettingsRequest
            {
                StaleAfterDays = ticklerResult.Settings.StaleAfterDays,
                SongLimit = ticklerResult.Settings.SongLimit
            };
        }
        else
        {
            loadError = ticklerResult.ErrorMessage ?? "Could not load preferences.";
        }

        if (musicResult.Succeeded && musicResult.Preference is not null)
        {
            MusicServiceInput = new UpdateMusicServicePreferenceRequest
            {
                Service = musicResult.Preference.Service
            };
        }
        else if (loadError is null)
        {
            loadError = musicResult.ErrorMessage ?? "Could not load preferences.";
        }

        if (themeResult.Succeeded && themeResult.Preference is not null)
        {
            ThemeInput = new UpdateThemePreferenceRequest
            {
                Preference = themeResult.Preference.Preference
            };
        }
        else if (loadError is null)
        {
            loadError = themeResult.ErrorMessage ?? "Could not load preferences.";
        }

        isLoading = false;
    }

    private async Task OnThemeChangedAsync()
    {
        await ThemeService.ApplyPreferenceAsync(ThemeInput.Preference);
    }

    private async Task SubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Save sequentially to avoid Identity concurrency stamp races on AspNetUsers.
            var ticklerResult = await Api.UpdateTicklerSettingsAsync(TicklerInput);

            if (!ticklerResult.Succeeded)
            {
                errorMessage = ticklerResult.ErrorMessage ?? "Could not save tickler settings.";
                return;
            }

            var musicResult = await Api.UpdateMusicServicePreferenceAsync(MusicServiceInput);
            if (!musicResult.Succeeded)
            {
                errorMessage = musicResult.ErrorMessage ?? "Could not save music service preference.";
                return;
            }

            var themeResult = await Api.UpdateThemePreferenceAsync(ThemeInput);
            if (!themeResult.Succeeded)
            {
                errorMessage = themeResult.ErrorMessage ?? "Could not save theme preference.";
                return;
            }

            successMessage = "Preferences saved.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
