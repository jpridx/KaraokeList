@page "/account/preferences"
@page "/account/tickler-settings"
@attribute [Authorize]

<PageTitle>Preferences</PageTitle>

<div class="mobile-page">
    <MobilePageHeader Title="Preferences">
        <Subtitle>
            Control the <strong>Haven't sung in a while</strong> section on Home.
        </Subtitle>
    </MobilePageHeader>

    <MobileLoadingState IsLoading="isLoading" Message="Loading preferences…" CssClass="text-muted small mt-3">
        @if (!string.IsNullOrEmpty(loadError))
        {
            <StatusAlerts ErrorMessage="@loadError" CssClass="mt-3" />
        }
        else
        {
            <StatusAlerts SuccessMessage="@successMessage" ErrorMessage="@errorMessage" CssClass="mt-3" />

            <section class="mobile-panel mt-3">
                <EditForm Model="Input" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label" for="stale-after-days">Days since last performance</label>
                        <InputNumber id="stale-after-days" class="form-control" @bind-Value="Input.StaleAfterDays" disabled="@isSubmitting" />
                        <div class="form-text">
                            Show songs you haven't sung in at least this many days (@TicklerSettingsLimits.MinStaleAfterDays–@TicklerSettingsLimits.MaxStaleAfterDays).
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="song-limit">Maximum songs to show</label>
                        <InputNumber id="song-limit" class="form-control" @bind-Value="Input.SongLimit" disabled="@isSubmitting" />
                        <div class="form-text">
                            How many suggestions appear on Home (@TicklerSettingsLimits.MinSongLimit–@TicklerSettingsLimits.MaxSongLimit).
                        </div>
                    </div>
                    <button class="btn btn-primary w-100" type="submit" disabled="@isSubmitting">
                        @(isSubmitting ? "Saving…" : "Save preferences")
                    </button>
                </EditForm>
            </section>
        }
    </MobileLoadingState>

    <MobileBackLink />
</div>

@code {
    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    private UpdateTicklerSettingsRequest Input { get; set; } = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string? loadError;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetTicklerSettingsAsync();
        if (result.Succeeded && result.Settings is not null)
        {
            Input = new UpdateTicklerSettingsRequest
            {
                StaleAfterDays = result.Settings.StaleAfterDays,
                SongLimit = result.Settings.SongLimit
            };
        }
        else
        {
            loadError = result.ErrorMessage ?? "Could not load preferences.";
        }

        isLoading = false;
    }

    private async Task SubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await Api.UpdateTicklerSettingsAsync(Input);
            if (!result.Succeeded)
            {
                errorMessage = result.ErrorMessage ?? "Could not save preferences.";
                return;
            }

            successMessage = "Preferences saved. Home will use these values on your next visit.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
