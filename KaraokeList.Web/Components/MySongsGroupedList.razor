@foreach (var group in PagingView.Sections)
{
    <h2 class="repertoire-group-heading">@group.Key</h2>
    @foreach (var subGroup in group.SubSections)
    {
        @if (UseNestedHeadings)
        {
            <h3 class="repertoire-subgroup-heading">@subGroup.Key</h3>
        }
        @foreach (var song in subGroup.Songs)
        {
            <SongListItem Song="@song" OnHistory="@OnHistory" OnLog="@OnLog" />
        }
    }
}
@if (PagingView.HasMore)
{
    <LoadMoreButton Visible="@PagingView.HasMore"
                    VisibleCount="@PagingView.VisibleCount"
                    TotalCount="@TotalCount"
                    OnClick="@OnClick" />
}

@code {
    [Parameter, EditorRequired]
    public GroupedPagingView PagingView { get; set; } = new([], 0, false);

    [Parameter, EditorRequired]
    public int TotalCount { get; set; }

    [Parameter]
    public bool UseNestedHeadings { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnLoadMore { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<RepertoireSongDto> OnHistory { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<RepertoireSongDto> OnLog { get; set; }

    private EventCallback OnClick => OnLoadMore;
}
