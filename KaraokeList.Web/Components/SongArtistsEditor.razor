@using KaraokeList.Shared

<div class="song-artists-editor">
    @for (var i = 0; i < ArtistNames.Count; i++)
    {
        var index = i;
        <div class="d-flex gap-2 align-items-center mb-2">
            <SfAutoComplete TValue="string" TItem="ArtistLookupDto" DataSource="@ArtistLookups"
                            Value="@ArtistNames[index]"
                            ValueChanged="@(value => OnArtistNameChanged(index, value))"
                            Placeholder="Search artist..." Enabled="@(!Disabled)">
                <AutoCompleteFieldSettings Value="Name" Text="Name" />
            </SfAutoComplete>
            @if (ArtistNames.Count > 1)
            {
                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@Disabled"
                        @onclick="() => RemoveArtist(index)">
                    Remove
                </button>
            }
        </div>
    }
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@Disabled" @onclick="AddArtist">
        + Add artist
    </button>
</div>

@code {
    [Parameter]
    public List<string> ArtistNames { get; set; } = [];

    [Parameter]
    public EventCallback<List<string>> ArtistNamesChanged { get; set; }

    [Parameter]
    public IReadOnlyList<ArtistLookupDto> ArtistLookups { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    private Task OnArtistNameChanged(int index, string value)
    {
        ArtistNames[index] = value;
        return ArtistNamesChanged.InvokeAsync(ArtistNames);
    }

    private Task AddArtist()
    {
        ArtistNames.Add(string.Empty);
        return ArtistNamesChanged.InvokeAsync(ArtistNames);
    }

    private Task RemoveArtist(int index)
    {
        if (ArtistNames.Count <= 1)
        {
            return Task.CompletedTask;
        }

        ArtistNames.RemoveAt(index);
        return ArtistNamesChanged.InvokeAsync(ArtistNames);
    }
}
