@using KaraokeList.Shared

<div class="song-artists-editor">
    @for (var i = 0; i < ArtistNames.Count; i++)
    {
        var index = i;
        <div class="d-flex gap-2 align-items-start mb-2">
            <div class="flex-grow-1">
                <AddArtistField ArtistLookups="@ArtistLookups"
                                ArtistName="@ArtistNames[index]"
                                ArtistNameChanged="@(value => OnArtistNameChanged(index, value))"
                                ArtistLookupsChanged="OnArtistLookupsChangedAsync"
                                Disabled="@Disabled"
                                ShowGuidance="@(index == 0)" />
            </div>
            @if (ArtistNames.Count > 1)
            {
                <button type="button" class="btn btn-outline-danger btn-sm mt-1" disabled="@Disabled"
                        @onclick="() => RemoveArtist(index)">
                    Remove
                </button>
            }
        </div>
    }
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@Disabled" @onclick="AddArtist">
        + Add another artist
    </button>
</div>

@code {
    [Parameter]
    public List<string> ArtistNames { get; set; } = [];

    [Parameter]
    public EventCallback<List<string>> ArtistNamesChanged { get; set; }

    [Parameter]
    public IReadOnlyList<ArtistLookupDto> ArtistLookups { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<ArtistLookupDto>> ArtistLookupsChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task OnArtistNameChanged(int index, string value)
    {
        ArtistNames[index] = value;
        return ArtistNamesChanged.InvokeAsync(ArtistNames);
    }

    private Task OnArtistLookupsChangedAsync(IReadOnlyList<ArtistLookupDto> refreshed) =>
        ArtistLookupsChanged.InvokeAsync(refreshed);

    private Task AddArtist()
    {
        ArtistNames.Add(string.Empty);
        return ArtistNamesChanged.InvokeAsync(ArtistNames);
    }

    private Task RemoveArtist(int index)
    {
        if (ArtistNames.Count <= 1)
        {
            return Task.CompletedTask;
        }

        ArtistNames.RemoveAt(index);
        return ArtistNamesChanged.InvokeAsync(ArtistNames);
    }
}
