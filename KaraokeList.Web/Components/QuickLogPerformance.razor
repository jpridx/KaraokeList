@inject IKaraokeApiClient Api
@inject ILogPerformanceLocalStore LogStore
@inject ILogCatalogLoader CatalogLoader

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="alert alert-success">@saveMessage</div>
}
@if (!string.IsNullOrEmpty(saveWarning))
{
    <div class="alert alert-warning">@saveWarning</div>
}
@if (!string.IsNullOrEmpty(saveError))
{
    <div class="alert alert-danger">@saveError</div>
}

<div class="mobile-panel">
    <label class="form-label">Venue</label>
    <SfDropDownList TValue="int?" TItem="VenueDto" DataSource="@venues" @bind-Value="selectedVenueId"
                    Placeholder="Where are you?" AllowFiltering="true"
                    FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
        <DropDownListFieldSettings Value="Id" Text="VenueName" />
    </SfDropDownList>

    @if (!usingOfflineCatalog)
    {
        <button type="button" class="btn btn-link btn-sm ps-0 mt-2" @onclick="ToggleNewVenue">
            @(showNewVenue ? "Hide new venue" : "+ New venue")
        </button>
        @if (showNewVenue)
        {
            <div class="border-top pt-3 mt-2">
                <label class="form-label">Venue name</label>
                <input class="form-control mb-2" @bind="newVenueName" />
                <button type="button" class="btn btn-outline-primary w-100" @onclick="SaveNewVenueAsync">
                    Add venue
                </button>
            </div>
        }
    }
    else if (venues.Count == 0)
    {
        <p class="small text-muted mt-2 mb-0">Venue list isn't cached yet. Open Log while online once.</p>
    }
</div>

<div class="mobile-panel">
    <label class="form-label">Date</label>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <InputDate class="form-control flex-grow-1" @bind-Value="performedOn" style="min-width: 10rem;" />
        @if (performedOn.Date != DateTime.Today)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="UseToday">
                Use today
            </button>
        }
    </div>

    <label class="form-label mt-3">Key</label>
    <SfDropDownList TValue="int?" TItem="PerformanceKeyOption" DataSource="@keyOptions"
                    Value="ActiveKeyChangeSemitones" ValueChanged="OnKeyChangedAsync">
        <DropDownListFieldSettings Value="Semitones" Text="Label" />
    </SfDropDownList>
</div>

@if (ShowCoPerformersEditor)
{
    <CoPerformersEditor PrimarySingerId="SingerId ?? 0" @bind-OtherPerformers="localOtherPerformers" />
}

@if (ShowHostMessagePanel)
{
    <HostMessagePanel Title="@Title" ArtistName="@ArtistName"
                      KeyChangeSemitones="ActiveKeyChangeSemitones" ShowKeyPicker="false"
                      CoPerformerNames="@coPerformerNames" />
}

<button type="button" class="btn btn-primary btn-lg w-100 mobile-primary-action"
        disabled="@(!CanSave)" @onclick="SavePerformanceAsync">
    @(SaveButtonText)
</button>

@code {
    [Parameter, EditorRequired]
    public int SongId { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string ArtistName { get; set; } = string.Empty;

    [Parameter]
    public int? SingerId { get; set; }

    [Parameter]
    public string SaveButtonText { get; set; } = "Save performance";

    [Parameter]
    public EventCallback<string?> OnPerformanceSaved { get; set; }

    [Parameter]
    public List<CoPerformerInputDto>? OtherPerformers { get; set; }

    [Parameter]
    public bool ShowCoPerformersEditor { get; set; } = true;

    [Parameter]
    public bool ShowHostMessagePanel { get; set; } = true;

    [Parameter]
    public int? KeyChangeSemitones { get; set; }

    [Parameter]
    public EventCallback<int?> KeyChangeSemitonesChanged { get; set; }

    private List<VenueDto> venues = [];
    private List<SingerDto> singers = [];
    private IReadOnlyList<PerformanceKeyOption> keyOptions = PerformanceKeyOption.Choices;
    private int? selectedVenueId;
    private DateTime performedOn = DateTime.Today;
    private string? saveMessage;
    private string? saveWarning;
    private string? saveError;
    private bool showNewVenue;
    private string newVenueName = string.Empty;
    private bool defaultsLoaded;
    private bool usingOfflineCatalog;
    private bool venuesLoaded;
    private List<CoPerformerInputDto> localOtherPerformers = [];
    private int? formKeyChangeSemitones;

    private bool KeyIsParentBound => KeyChangeSemitonesChanged.HasDelegate;

    private int? ActiveKeyChangeSemitones => KeyIsParentBound ? KeyChangeSemitones : formKeyChangeSemitones;

    private IReadOnlyList<CoPerformerInputDto> ActiveOtherPerformers =>
        ShowCoPerformersEditor ? localOtherPerformers : (OtherPerformers ?? []);

    private IReadOnlyList<string> coPerformerNames =>
        CoPerformerFormatting.GetDisplayNames(ActiveOtherPerformers.ToList(), singers);

    private bool CanSave => selectedVenueId is not null && SingerId is not null;

    protected override async Task OnParametersSetAsync()
    {
        if (!venuesLoaded)
        {
            var venueResult = await CatalogLoader.LoadVenuesAsync();
            venues = venueResult.Venues.ToList();
            usingOfflineCatalog = venueResult.FromCache;
            venuesLoaded = true;
            try
            {
                singers = await Api.GetSingersAsync();
            }
            catch (Exception ex) when (ApiTransientFailure.IsTransient(ex) || ex is HttpRequestException)
            {
                usingOfflineCatalog = true;
            }
        }

        if (!defaultsLoaded || SongId != _loadedSongId)
        {
            await LoadDefaultsAsync();
        }
    }

    private int _loadedSongId;

    private async Task LoadDefaultsAsync()
    {
        defaultsLoaded = true;
        _loadedSongId = SongId;
        saveMessage = null;
        saveWarning = null;
        saveError = null;
        if (ShowCoPerformersEditor)
        {
            localOtherPerformers = [];
        }

        var stored = await LogStore.GetFormDefaultsAsync();
        SongPerformanceSummaryDto? summary = null;
        try
        {
            var result = await Api.GetMySongSummaryAsync(SongId);
            summary = result.Succeeded ? result.Summary : null;
        }
        catch (Exception ex) when (ApiTransientFailure.IsTransient(ex) || ex is HttpRequestException)
        {
            usingOfflineCatalog = true;
        }

        performedOn = DateTime.Today;

        var recentKeyForSong = (await LogStore.GetRecentLogsAsync())
            .FirstOrDefault(r => r.SongId == SongId)
            ?.KeyChangeSemitones;
        var key = LogKeyChangeDefaults.ForSong(summary, recentKeyForSong);
        if (KeyIsParentBound)
        {
            await KeyChangeSemitonesChanged.InvokeAsync(key);
        }
        else
        {
            formKeyChangeSemitones = key;
        }

        if (stored?.VenueId is int storedVenueId && venues.Any(v => v.Id == storedVenueId))
        {
            selectedVenueId = storedVenueId;
        }
        else if (!string.IsNullOrWhiteSpace(summary?.LastVenueName))
        {
            selectedVenueId = venues.FirstOrDefault(v =>
                v.VenueName.Equals(summary.LastVenueName, StringComparison.OrdinalIgnoreCase))?.Id;
        }
        else
        {
            selectedVenueId = null;
        }
    }

    private async Task SavePerformanceAsync()
    {
        saveMessage = null;
        saveWarning = null;
        saveError = null;

        if (!CanSave)
        {
            saveError = SingerId is null ? "Link your singer profile first." : "Pick a venue.";
            return;
        }

        try
        {
            var dto = new PerformanceDto
            {
                Singer = SingerId,
                Song = SongId,
                Venue = selectedVenueId,
                PerformedOn = performedOn,
                KeyChangeSemitones = ActiveKeyChangeSemitones == 0 ? null : ActiveKeyChangeSemitones,
                OtherPerformers = ActiveOtherPerformers.ToList()
            };

            var result = await Api.TryCreatePerformanceAsync(dto);
            var venueName = venues.FirstOrDefault(v => v.Id == selectedVenueId)?.VenueName ?? string.Empty;

            if (result.Succeeded)
            {
                await SaveLocallyAsync(venueName, queuedOffline: false);
                saveMessage = "Performance saved.";
                await OnPerformanceSaved.InvokeAsync(saveMessage);
                return;
            }

            if (result.IsTransient)
            {
                await SaveLocallyAsync(venueName, queuedOffline: true);
                saveWarning = "Saved on this device. Will sync when you're back online.";
                await OnPerformanceSaved.InvokeAsync(saveWarning);
                return;
            }

            saveError = result.ErrorMessage ?? "Could not save performance.";
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
    }

    private async Task SaveLocallyAsync(string venueName, bool queuedOffline)
    {
        await LogStore.SaveFormDefaultsAsync(new LogFormDefaults(selectedVenueId));
        await LogStore.AddRecentLogAsync(new RecentLoggedPerformance(
            SongId, Title, ArtistName, venueName, performedOn, ActiveKeyChangeSemitones, DateTime.Now));

        if (queuedOffline && SingerId is int singerId && selectedVenueId is int venueId)
        {
            await LogStore.EnqueuePendingPerformanceAsync(new PendingPerformanceEntry(
                Guid.NewGuid(),
                singerId,
                SongId,
                venueId,
                performedOn,
                ActiveKeyChangeSemitones == 0 ? null : ActiveKeyChangeSemitones,
                Title,
                ArtistName,
                venueName,
                DateTime.Now,
                ActiveOtherPerformers.ToList()));
        }
    }

    private Task OnKeyChangedAsync(int? value)
    {
        if (KeyIsParentBound)
        {
            return KeyChangeSemitonesChanged.InvokeAsync(value);
        }

        formKeyChangeSemitones = value;
        return Task.CompletedTask;
    }

    private async Task SaveNewVenueAsync()
    {
        saveError = null;
        if (string.IsNullOrWhiteSpace(newVenueName))
        {
            saveError = "Venue name is required.";
            return;
        }

        try
        {
            await Api.CreateVenueAsync(new VenueDto { VenueName = newVenueName.Trim() });
            venues = await Api.GetVenuesAsync();
            var created = venues.FirstOrDefault(v =>
                v.VenueName.Equals(newVenueName.Trim(), StringComparison.OrdinalIgnoreCase));
            if (created is not null)
            {
                selectedVenueId = created.Id;
            }

            newVenueName = string.Empty;
            showNewVenue = false;
            saveMessage = "Venue added.";
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
    }

    private void ToggleNewVenue() => showNewVenue = !showNewVenue;

    private void UseToday() => performedOn = DateTime.Today;
}
