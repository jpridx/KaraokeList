@* Shared stats markup for Home teaser and /my-stats page. *@

@if (Stats is { TotalPerformances: > 0 })
{
    <section class="singer-stats-section mobile-panel @CssClass" aria-label="Your karaoke stats">
        @if (ShowHeader)
        {
            <header class="singer-stats-header">
                <h2 class="@HeaderClass mb-1">@HeaderText</h2>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="text-muted small mb-0">@Subtitle</p>
                }
            </header>
        }

        <dl class="singer-stats-grid mt-3 mb-0">
            <div class="singer-stats-item">
                <dt>Performances</dt>
                <dd>@Stats.TotalPerformances.ToString("N0")</dd>
            </div>
            <div class="singer-stats-item">
                <dt>Songs logged</dt>
                <dd>@Stats.UniqueSongs.ToString("N0")</dd>
            </div>
            <div class="singer-stats-item">
                <dt>This month</dt>
                <dd>@Stats.PerformancesThisMonth.ToString("N0")</dd>
            </div>
            <div class="singer-stats-item">
                <dt>This year</dt>
                <dd>@Stats.PerformancesThisYear.ToString("N0")</dd>
            </div>
        </dl>

        @if (Stats.LastPerformedOn is DateTime lastPerformed)
        {
            <p class="singer-stats-last small text-muted mb-0 mt-3">
                Last sang @FormatLastPerformance(lastPerformed, Stats.DaysSinceLastPerformance, Stats.LastVenueName)
            </p>
        }

        @if (Stats.TopVenues.Count > 0)
        {
            <div class="singer-stats-block mt-3">
                <p class="singer-stats-block-title small text-muted mb-1">Top venues</p>
                <ul class="singer-stats-rank-list mb-0">
                    @foreach (var venue in Stats.TopVenues)
                    {
                        <li>
                            <span class="singer-stats-rank-name">@venue.VenueName</span>
                            <span class="singer-stats-rank-count">@venue.PerformanceCount</span>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Stats.TopSongs.Count > 0)
        {
            <div class="singer-stats-block mt-3">
                <p class="singer-stats-block-title small text-muted mb-1">Most performed songs</p>
                <ul class="singer-stats-rank-list mb-0">
                    @foreach (var song in Stats.TopSongs)
                    {
                        <li>
                            <a class="singer-stats-rank-link" href="@($"my-songs/{song.SongId}")">
                                @song.Title@if (!string.IsNullOrWhiteSpace(song.ArtistName)) { <text> — @song.ArtistName</text> }
                            </a>
                            <span class="singer-stats-rank-count">@song.PerformanceCount</span>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Stats.TopArtists.Count > 0)
        {
            <div class="singer-stats-block mt-3">
                <p class="singer-stats-block-title small text-muted mb-1">Most performed artists</p>
                <ul class="singer-stats-rank-list mb-0">
                    @foreach (var artist in Stats.TopArtists)
                    {
                        <li>
                            <span class="singer-stats-rank-name">@artist.ArtistName</span>
                            <span class="singer-stats-rank-count">@artist.PerformanceCount</span>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Stats.NewRepertoireSongs.Count > 0)
        {
            <div class="singer-stats-block mt-3">
                <p class="singer-stats-block-title small text-muted mb-1">
                    New to your repertoire (last @Stats.NewRepertoireDays days)
                </p>
                <ul class="singer-stats-rank-list mb-0">
                    @foreach (var song in Stats.NewRepertoireSongs)
                    {
                        <li>
                            <a class="singer-stats-rank-link" href="@($"my-songs/{song.SongId}")">
                                @song.Title@if (!string.IsNullOrWhiteSpace(song.ArtistName)) { <text> — @song.ArtistName</text> }
                            </a>
                            <span class="singer-stats-rank-meta">@song.FirstPerformedOn.ToString("MMM d")</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public SingerStatsDto Stats { get; set; } = null!;

    [Parameter]
    public bool ShowHeader { get; set; } = true;

    [Parameter]
    public string HeaderText { get; set; } = "Your stats";

    [Parameter]
    public string HeaderClass { get; set; } = "h5";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    private static string FormatLastPerformance(DateTime date, int? daysSince, string? venueName)
    {
        var when = daysSince switch
        {
            0 => "today",
            1 => "yesterday",
            int d => $"{d} days ago",
            _ => date.ToString("MMM d, yyyy")
        };

        return string.IsNullOrWhiteSpace(venueName)
            ? $"{when} ({date:M/d/yyyy})"
            : $"{when} at {venueName} ({date:M/d/yyyy})";
    }
}
