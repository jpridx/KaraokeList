@inject ILocalStaleSongsProvider Provider
@inject IPerformanceCacheCoordinator PerformanceCache
@inject NavigationManager NavigationManager
@inject ILogger<StaleSongsSection> Logger
@implements IDisposable
@using KaraokeList.Web.Services

@if (!loading && songs.Count > 0)
{
    <section class="stale-songs-section mobile-panel mt-3" aria-label="Haven't sung in a while">
        <header class="stale-songs-header">
            <h2 class="h5 mb-1">Haven't sung in a while</h2>
            <p class="text-muted small mb-0">
                Random picks from your repertoire — not performed in the last @staleAfterDays days, or never logged.
                <a class="ms-1" href="account/preferences">Settings</a>
            </p>
        </header>

        <SongLinkList Items="@linkItems" ListClass="recent-log-list mt-3 mb-0" />
        <button type="button" class="btn btn-outline-primary btn-sm mt-3" @onclick="RefreshSuggestionsAsync">
            Refresh suggestions
        </button>
    </section>
}

@code {
    private bool loading = true;
    private int staleAfterDays = TicklerSettingsLimits.DefaultStaleAfterDays;
    private List<StaleSongDto> songs = [];
    private readonly DateTime localToday = DateTime.Today;

    private IReadOnlyList<SongLinkItem> linkItems =>
        songs.Select(song =>
        {
            var meta = song.LastPerformedOn is DateTime lastPerformed
                ? $"Last {lastPerformed:MMM d, yyyy} · {PerformanceRelativeDate.FormatDaysSince(PerformanceRelativeDate.DaysSince(lastPerformed, localToday) ?? 0)}{(song.PerformanceCount > 1 ? $" · {song.PerformanceCount} times" : string.Empty)}"
                : "Never performed";

            return new SongLinkItem(
                song.SongId,
                $"{song.Title} — {song.ArtistName}",
                meta);
        }).ToList();

    protected override async Task OnInitializedAsync()
    {
        PerformanceCache.RecentLogsChanged += OnCacheChanged;
        PerformanceCache.RepertoireStatsChanged += OnCacheChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        await LoadSuggestionsAsync();
        loading = false;
    }

    private void OnCacheChanged() => _ = ReloadSuggestionsAsync();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(e.Location);
        if (string.IsNullOrEmpty(relativePath) || relativePath == "/")
        {
            _ = ReloadSuggestionsAsync();
        }
    }

    private async Task RefreshSuggestionsAsync() => await LoadSuggestionsAsync(new Random());

    private async Task ReloadSuggestionsAsync()
    {
        try
        {
            await LoadSuggestionsAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to reload stale song suggestions.");
        }
    }

    private async Task LoadSuggestionsAsync(Random? random = null)
    {
        var result = await Provider.ComputeAsync(random: random);
        if (result.Response is not null && result.Response.Songs.Count > 0)
        {
            staleAfterDays = result.Response.StaleAfterDays;
            songs = result.Response.Songs;
        }
        else
        {
            songs = [];
        }
    }

    public void Dispose()
    {
        PerformanceCache.RecentLogsChanged -= OnCacheChanged;
        PerformanceCache.RepertoireStatsChanged -= OnCacheChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
