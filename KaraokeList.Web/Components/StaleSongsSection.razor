@inject IStaleSongsLoader Loader

@if (!loading && songs.Count > 0)
{
    <section class="stale-songs-section mobile-panel mt-3" aria-label="Haven't sung in a while">
        <header class="stale-songs-header">
            <h2 class="h5 mb-1">Haven't sung in a while</h2>
            <p class="text-muted small mb-0">
                Random picks from your repertoire — not performed in the last @staleAfterDays days, or never logged.
                <a class="ms-1" href="account/preferences">Settings</a>
            </p>
        </header>

        <OfflineCacheNotice UsingOffline="@fromCache" HasCachedData="true" CachedAt="@cachedAt" ResourceName="suggestions" />
        <SongLinkList Items="@linkItems" ListClass="recent-log-list mt-3 mb-0" />
    </section>
}

@code {
    private bool loading = true;
    private bool fromCache;
    private DateTime? cachedAt;
    private int staleAfterDays = TicklerSettingsLimits.DefaultStaleAfterDays;
    private List<StaleSongDto> songs = [];
    private readonly DateTime localToday = DateTime.Today;

    private IReadOnlyList<SongLinkItem> linkItems =>
        songs.Select(song =>
        {
            var meta = song.LastPerformedOn is DateTime lastPerformed
                ? $"Last {lastPerformed:MMM d, yyyy} · {PerformanceRelativeDate.FormatDaysSince(PerformanceRelativeDate.DaysSince(lastPerformed, localToday) ?? 0)}{(song.PerformanceCount > 1 ? $" · {song.PerformanceCount} times" : string.Empty)}"
                : "Never performed";

            return new SongLinkItem(
                song.SongId,
                $"{song.Title} — {song.ArtistName}",
                meta);
        }).ToList();

    protected override async Task OnInitializedAsync()
    {
        var result = await Loader.LoadAsync();
        if (result.Succeeded && result.Response is not null)
        {
            staleAfterDays = result.Response.StaleAfterDays;
            songs = result.Response.Songs;
            fromCache = result.FromCache;
            cachedAt = result.CachedAtUtc;
        }

        loading = false;
    }

}
