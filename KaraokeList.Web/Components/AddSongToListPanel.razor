@using KaraokeList.Shared
@inject IKaraokeApiClient Api

<div class="add-song-to-list-panel">
    @if (!isExpanded)
    {
        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@IsOffline" @onclick="Expand">
            + Add song
        </button>
    }
    else
    {
        <div class="mobile-panel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">Song</label>
                <button type="button" class="btn btn-link btn-sm p-0" disabled="@isBusy" @onclick="Collapse">Cancel</button>
            </div>

            @if (CatalogItems.Count == 0)
            {
                <p class="text-muted small mb-0">No songs in the catalog yet. Use + New song below.</p>
            }
            else
            {
                <CatalogSongPicker Items="@CatalogItems"
                                   SelectedSongId="@selectedSongId"
                                   SelectedSongIdChanged="HandleSelectedSongIdChangedAsync"
                                   Enabled="@(!showNewSong && !isBusy && !UsingOfflineCatalog)" />
                <p class="small text-muted mt-1 mb-0">@CatalogItems.Count songs · ★ = on My repertoire · 🎯 = working up</p>
            }

            @if (!UsingOfflineCatalog)
            {
                @if (!showNewSong)
                {
                    <button type="button" class="btn btn-link btn-sm ps-0 mt-2" disabled="@isBusy" @onclick="OpenNewSongPanel">
                        + New song
                    </button>
                }
                else
                {
                    <AddSongPanel OnSongAdded="OnNewSongCreatedAsync"
                                  OnCancelled="CloseNewSongPanel" />
                }
            }

            @if (selectedSongId is not null)
            {
                <fieldset class="mt-3 mb-0" disabled="@(isBusy || UsingOfflineCatalog)">
                    <legend class="form-label fs-6 mb-2">Add to lists</legend>
                    @foreach (var kind in AllListKinds)
                    {
                        var checkboxId = $"add-song-list-{kind}";
                        var alreadyOn = IsAlreadyOnList(kind);
                        var disabled = alreadyOn || IsListCheckboxDisabled(kind);
                        var isChecked = alreadyOn || selectedLists.Contains(kind);
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@checkboxId"
                                   checked="@isChecked" disabled="@disabled"
                                   @onchange="e => ToggleListSelection(kind, e.Value)" />
                            <label class="form-check-label" for="@checkboxId">
                                @SingerListKindNames.DisplayName(kind)
                                @if (alreadyOn)
                                {
                                    <span class="text-muted"> (already on list)</span>
                                }
                            </label>
                        </div>
                    }
                </fieldset>
            }

            @if (!string.IsNullOrEmpty(localError))
            {
                <p class="small text-danger mt-2 mb-0">@localError</p>
            }

            @if (pendingCollisions.Count > 0)
            {
                <TitleArtistDuplicateConfirm Collisions="@pendingCollisions"
                                             Disabled="@isBusy"
                                             OnCancel="CancelDuplicateConfirmAsync"
                                             OnConfirm="ConfirmDuplicateAddAsync" />
            }
            else if (selectedSongId is not null)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="button" class="btn btn-primary btn-sm" disabled="@(!CanConfirm)"
                            @onclick="ConfirmAddAsync">
                        @(isBusy ? "Adding…" : "Add to selected lists")
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly SingerListKind[] AllListKinds =
    [
        SingerListKind.MyRepertoire,
        SingerListKind.WantToSing,
        SingerListKind.WorkingUp
    ];

    [Parameter, EditorRequired]
    public IReadOnlyList<LogSongPickItem> CatalogItems { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<SingerListDto> SingerLists { get; set; } = [];

    [Parameter, EditorRequired]
    public SingerListKind DefaultListKind { get; set; }

    [Parameter]
    public bool UsingOfflineCatalog { get; set; }

    [Parameter]
    public EventCallback<SongAddedToListEventArgs> OnSongAdded { get; set; }

    [Parameter]
    public EventCallback<SongAddedEventArgs> OnCatalogUpdated { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private bool isExpanded;
    private bool showNewSong;
    private int? selectedSongId;
    private string? localError;
    private bool isBusy;
    private readonly HashSet<SingerListKind> selectedLists = [];
    private readonly HashSet<SingerListKind> alreadyOnLists = [];
    private List<(SingerListKind Kind, TitleArtistCollisionDto Collision)> pendingCollisions = [];
    private List<SingerListKind>? pendingTargetLists;

    private bool IsOffline => Disabled || UsingOfflineCatalog;

    public void Expand()
    {
        if (IsOffline)
        {
            return;
        }

        localError = null;
        isExpanded = true;
    }

    private void Collapse()
    {
        if (isBusy)
        {
            return;
        }

        Reset();
    }

    private void OpenNewSongPanel()
    {
        localError = null;
        showNewSong = true;
    }

    private void CloseNewSongPanel() => showNewSong = false;

    private async Task HandleSelectedSongIdChangedAsync(int? songId)
    {
        selectedSongId = songId;
        localError = null;
        await ResetListSelectionAsync();
    }

    private async Task OnNewSongCreatedAsync(SongAddedEventArgs args)
    {
        showNewSong = false;
        localError = null;

        if (OnCatalogUpdated.HasDelegate)
        {
            await OnCatalogUpdated.InvokeAsync(args);
        }

        selectedSongId = args.SongId;
        await ResetListSelectionAsync();
    }

    private async Task ResetListSelectionAsync()
    {
        selectedLists.Clear();
        alreadyOnLists.Clear();

        if (selectedSongId is not int songId)
        {
            return;
        }

        var membership = new HashSet<SingerListKind>();

        var pickItem = CatalogItems.FirstOrDefault(s => s.Id == songId);
        if (pickItem?.InRepertoire == true)
        {
            membership.Add(SingerListKind.MyRepertoire);
        }

        if (pickItem?.InWorkingUp == true)
        {
            membership.Add(SingerListKind.WorkingUp);
        }

        if (!UsingOfflineCatalog)
        {
            var membershipResult = await Api.GetSongListMembershipAsync(songId);
            if (selectedSongId != songId)
            {
                return;
            }

            if (membershipResult.Succeeded)
            {
                foreach (var kind in membershipResult.Lists)
                {
                    membership.Add(kind);
                }
            }
        }

        if (selectedSongId != songId)
        {
            return;
        }

        foreach (var kind in membership)
        {
            alreadyOnLists.Add(kind);
        }

        if (!alreadyOnLists.Contains(DefaultListKind) && !IsListCheckboxDisabled(DefaultListKind))
        {
            selectedLists.Add(DefaultListKind);
        }
    }

    private bool IsAlreadyOnList(SingerListKind kind) => alreadyOnLists.Contains(kind);

    private bool IsListCheckboxDisabled(SingerListKind kind) => kind switch
    {
        SingerListKind.WantToSing => alreadyOnLists.Contains(SingerListKind.MyRepertoire),
        _ => false
    };

    private bool CanConfirm =>
        selectedSongId is not null
        && selectedLists.Except(alreadyOnLists).Any()
        && !isBusy
        && !UsingOfflineCatalog;

    private void ToggleListSelection(SingerListKind kind, object? checkedValue)
    {
        if (IsAlreadyOnList(kind) || IsListCheckboxDisabled(kind))
        {
            return;
        }

        var isChecked = checkedValue is bool value && value;
        if (isChecked)
        {
            selectedLists.Add(kind);
        }
        else
        {
            selectedLists.Remove(kind);
        }
    }

    private async Task ConfirmAddAsync()
    {
        if (selectedSongId is not int songId || !CanConfirm)
        {
            return;
        }

        isBusy = true;
        localError = null;
        pendingCollisions = [];
        pendingTargetLists = null;

        var targets = selectedLists.Except(alreadyOnLists).ToList();
        try
        {
            var collisionCheck = await SingerListActions.CheckTitleArtistCollisionsAsync(
                Api, SingerLists, songId, targets);
            if (!collisionCheck.Succeeded)
            {
                localError = collisionCheck.ErrorMessage;
                return;
            }

            if (collisionCheck.HasCollisions)
            {
                pendingCollisions = collisionCheck.Collisions;
                pendingTargetLists = targets;
                return;
            }

            await ExecuteAddAsync(songId, targets, allowTitleArtistDuplicate: false);
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task CancelDuplicateConfirmAsync()
    {
        pendingCollisions = [];
        pendingTargetLists = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmDuplicateAddAsync()
    {
        if (selectedSongId is not int songId || pendingTargetLists is not { Count: > 0 })
        {
            return;
        }

        isBusy = true;
        localError = null;

        try
        {
            await ExecuteAddAsync(songId, pendingTargetLists, allowTitleArtistDuplicate: true);
        }
        finally
        {
            isBusy = false;
            pendingCollisions = [];
            pendingTargetLists = null;
        }
    }

    private async Task ExecuteAddAsync(int songId, IReadOnlyList<SingerListKind> targets, bool allowTitleArtistDuplicate)
    {
        var added = new List<SingerListKind>();
        var failures = new List<string>();

        foreach (var kind in targets)
        {
            var result = await SingerListActions.AddSongAsync(
                Api, SingerLists, kind, songId, allowTitleArtistDuplicate);
            if (result.Succeeded)
            {
                added.Add(kind);
            }
            else
            {
                failures.Add($"{SingerListKindNames.DisplayName(kind)}: {result.ErrorMessage}");
            }
        }

        if (added.Count == 0)
        {
            localError = failures.Count > 0
                ? string.Join(" ", failures)
                : "Could not add song to any list.";
            return;
        }

        var title = CatalogItems.FirstOrDefault(s => s.Id == songId)?.Title ?? "Song";
        var listNames = string.Join(", ", added.Select(SingerListKindNames.DisplayName));
        var message = failures.Count > 0
            ? $"\"{title}\" added to {listNames}. {string.Join(" ", failures)}"
            : $"\"{title}\" added to {listNames}.";

        await OnSongAdded.InvokeAsync(new SongAddedToListEventArgs(message, songId, added));
        Reset();
    }

    private void Reset()
    {
        isExpanded = false;
        showNewSong = false;
        selectedSongId = null;
        localError = null;
        selectedLists.Clear();
        alreadyOnLists.Clear();
        pendingCollisions = [];
        pendingTargetLists = null;
    }
}
