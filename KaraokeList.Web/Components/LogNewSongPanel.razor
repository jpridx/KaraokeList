@inject IKaraokeApiClient Api

<div class="log-new-song-panel border-top pt-3 mt-2">
    <label class="form-label">Title</label>
    <input class="form-control mb-2" @bind="title" />

    <label class="form-label">Artist</label>
    <SfAutoComplete TValue="string" TItem="ArtistLookupDto" DataSource="@ArtistLookups"
                    @bind-Value="artistName" Placeholder="Search or type artist name..."
                    AllowCustom="true" ShowClearButton="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
        <AutoCompleteFieldSettings Value="Name" Text="Name" />
    </SfAutoComplete>

    @if (LogArtistPicker.NeedsNewArtist(artistName, ArtistLookups))
    {
        <div class="alert alert-info small py-2 px-3 mt-2 mb-0" role="status">
            <strong>@artistName.Trim()</strong> isn't in the catalog yet.
            Add the artist first — your song title stays filled in.
        </div>
        <button type="button" class="btn btn-outline-primary w-100 mt-2" disabled="@isBusy"
                @onclick="AddArtistAsync">
            Add artist "@artistName.Trim()"
        </button>
    }
    else if (!string.IsNullOrWhiteSpace(artistName) && LogArtistPicker.ResolveArtistId(artistName, ArtistLookups) is not null)
    {
        <p class="small text-muted mt-2 mb-0">Artist selected.</p>
    }

    <label class="form-label mt-3">Genre (optional)</label>
    <SfDropDownList TValue="int?" TItem="GenreDto" DataSource="@Genres" @bind-Value="genreId"
                    Placeholder="Select genre" AllowFiltering="true"
                    FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
        <DropDownListFieldSettings Value="Id" Text="GenreName" />
    </SfDropDownList>

    @if (!string.IsNullOrEmpty(localError))
    {
        <div class="alert alert-danger small mt-3 mb-0">@localError</div>
    }

    <div class="d-flex gap-2 mt-3">
        <button type="button" class="btn btn-outline-secondary flex-fill" disabled="@isBusy" @onclick="CancelAsync">
            Cancel
        </button>
        <button type="button" class="btn btn-outline-primary flex-fill" disabled="@(!CanAddSong || isBusy)"
                @onclick="AddSongAsync">
            Add song
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ArtistLookupDto> ArtistLookups { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<ArtistLookupDto>> ArtistLookupsChanged { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<GenreDto> Genres { get; set; } = [];

    [Parameter]
    public EventCallback<LogNewSongAddedEventArgs> OnSongAdded { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private string title = string.Empty;
    private string artistName = string.Empty;
    private int? genreId;
    private string? localError;
    private bool isBusy;

    private bool CanAddSong =>
        !string.IsNullOrWhiteSpace(title)
        && LogArtistPicker.ResolveArtistId(artistName, ArtistLookups) is not null;

    private async Task AddArtistAsync()
    {
        localError = null;
        var trimmedName = artistName.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            localError = "Artist name is required.";
            return;
        }

        isBusy = true;
        try
        {
            await Api.CreateArtistAsync(new ArtistDto { Name = trimmedName });
            var refreshed = await Api.GetArtistLookupsAsync();
            await ArtistLookupsChanged.InvokeAsync(refreshed);
            artistName = trimmedName;
        }
        catch (Exception ex)
        {
            localError = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task AddSongAsync()
    {
        localError = null;
        var trimmedTitle = title.Trim();
        var trimmedArtist = artistName.Trim();
        var artistId = LogArtistPicker.ResolveArtistId(trimmedArtist, ArtistLookups);

        if (string.IsNullOrWhiteSpace(trimmedTitle))
        {
            localError = "Song title is required.";
            return;
        }

        if (artistId is null)
        {
            localError = LogArtistPicker.NeedsNewArtist(trimmedArtist, ArtistLookups)
                ? $"Add artist \"{trimmedArtist}\" first, then tap Add song."
                : "Artist is required.";
            return;
        }

        isBusy = true;
        try
        {
            await Api.CreateSongAsync(new SongDto
            {
                Title = trimmedTitle,
                Artist = artistId,
                Genre = genreId
            });

            await OnSongAdded.InvokeAsync(new LogNewSongAddedEventArgs(trimmedTitle, trimmedArtist));
        }
        catch (Exception ex)
        {
            localError = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task CancelAsync() => OnCancelled.InvokeAsync();
}
