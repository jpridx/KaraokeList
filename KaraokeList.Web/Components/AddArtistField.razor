@inject IKaraokeApiClient Api
@inject ILogCatalogLoader CatalogLoader

<SfAutoComplete TValue="string" TItem="ArtistLookupDto" DataSource="@ArtistLookups"
                @bind-Value="_name" @bind-Value:after="PropagateValueAsync"
                Placeholder="Search or type artist name..."
                AllowCustom="true" ShowClearButton="true"
                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
    <AutoCompleteFieldSettings Value="Name" Text="Name" />
</SfAutoComplete>

@if (ShowGuidance && string.IsNullOrWhiteSpace(_name))
{
    <p class="form-text mb-0 mt-2">
        Type the artist name. Pick from the list, or tap <strong>Add artist</strong> below if they're new to the catalog.
    </p>
}

@if (LogArtistPicker.NeedsNewArtist(_name, ArtistLookups))
{
    <div class="alert alert-info small py-2 px-3 mt-2 mb-0" role="status">
        <strong>@_name.Trim()</strong> isn't in the catalog yet.
        Tap <strong>Add artist</strong> below — your song title stays filled in.
    </div>
    @if (!string.IsNullOrEmpty(_localError))
    {
        <div class="alert alert-danger small mt-2 mb-0">@_localError</div>
    }
    <button type="button" class="btn btn-outline-primary w-100 mt-2"
            disabled="@(_isBusy || Disabled)" @onclick="AddArtistAsync">
        Add artist "@_name.Trim()"
    </button>
}
else if (!string.IsNullOrWhiteSpace(_name) && LogArtistPicker.ResolveArtistId(_name, ArtistLookups) is not null)
{
    <p class="small text-muted mt-2 mb-0">Artist selected.</p>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ArtistLookupDto> ArtistLookups { get; set; } = [];

    [Parameter, EditorRequired]
    public string ArtistName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ArtistNameChanged { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<ArtistLookupDto>> ArtistLookupsChanged { get; set; }

    /// <summary>Fired after a new artist is created so the parent can retain the catalog id.</summary>
    [Parameter]
    public EventCallback<ArtistConfirmedEventArgs> OnArtistConfirmed { get; set; }

    /// <summary>When true, disables the "Add artist" button (e.g. parent is saving).</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>When false, hides the empty-field guidance (e.g. secondary artist rows).</summary>
    [Parameter]
    public bool ShowGuidance { get; set; } = true;

    private string _name = string.Empty;
    private bool _isBusy;
    private bool _suppressValuePropagation;
    private string? _localError;

    protected override void OnParametersSet()
    {
        if (_name != ArtistName)
            _name = ArtistName;
    }

    private Task PropagateValueAsync()
    {
        if (_suppressValuePropagation)
        {
            return Task.CompletedTask;
        }

        return ArtistNameChanged.InvokeAsync(_name);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_suppressValuePropagation)
        {
            return;
        }

        _suppressValuePropagation = false;

        // SfAutoComplete can clear its bound value when DataSource refreshes; restore sync.
        if (!string.IsNullOrWhiteSpace(ArtistName) && _name != ArtistName)
        {
            _name = ArtistName;
            StateHasChanged();
        }
        else if (!string.IsNullOrWhiteSpace(_name) && _name != ArtistName)
        {
            await ArtistNameChanged.InvokeAsync(_name);
        }
    }

    private async Task AddArtistAsync()
    {
        _localError = null;
        var trimmedName = _name.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            _localError = "Artist name is required.";
            return;
        }

        _isBusy = true;
        try
        {
            await Api.CreateArtistAsync(new ArtistDto { Name = trimmedName });
            var refreshed = await CatalogLoader.LoadLookupsAsync();
            _suppressValuePropagation = true;
            _name = trimmedName;
            // Propagate the confirmed name first so that when the lookup change
            // triggers a parent re-render, ArtistName is already correct and
            // OnParametersSet does not reset _name back to the old value.
            await ArtistNameChanged.InvokeAsync(trimmedName);
            await ArtistLookupsChanged.InvokeAsync(refreshed.Artists);

            if (LogArtistPicker.ResolveArtistId(trimmedName, refreshed.Artists) is int artistId)
            {
                await OnArtistConfirmed.InvokeAsync(new ArtistConfirmedEventArgs(trimmedName, artistId));
            }
        }
        catch (Exception ex)
        {
            _localError = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
