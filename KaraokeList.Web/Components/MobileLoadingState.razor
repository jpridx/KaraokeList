@if (IsLoading)
{
    <p class="@CssClass">@Message</p>
}
else if (ChildContent is not null)
{
    @ChildContent
}

@code {
    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string Message { get; set; } = "Loading...";

    [Parameter]
    public string CssClass { get; set; } = "mt-3 text-muted small";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
