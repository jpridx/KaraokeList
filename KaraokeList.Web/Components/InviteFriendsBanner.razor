@inject IKaraokeApiClient Api
@inject NavigationManager Navigation

@if (!loading && content.CanShareInvite)
{
    <div class="alert alert-info invite-friends-banner mb-3" role="status">
        <p class="small mb-0">Invite a friend to join KaraokeList.</p>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <InviteSharePanel Layout="InviteSharePanelLayout.Banner"
                              RegisterUrl="@content.RegisterUrl"
                              ShareMessage="@content.ShareMessage" />
        </div>
    </div>
}
else if (!loading && content.ShowOpenRegistrationNotice)
{
    <div class="alert alert-info invite-friends-banner mb-3" role="status">
        <p class="small mb-0">
            Registration is open.
            <a href="register">Share the register page</a> with friends who want to join.
        </p>
    </div>
}

@code {
    private InviteShareContent content = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        content = await InviteShareLoader.LoadAsync(Api, Navigation.BaseUri);
        loading = false;
    }
}
