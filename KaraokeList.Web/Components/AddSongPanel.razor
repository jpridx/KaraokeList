@inject IKaraokeApiClient Api

<div class="log-new-song-panel border-top pt-3 mt-2">
    @if (isLoading)
    {
        <p class="text-muted small">Loading…</p>
    }
    else
    {
        <label class="form-label">Title</label>
        <input class="form-control mb-2" @bind="title" />

        <label class="form-label">Artist</label>
        <AddArtistField ArtistLookups="artistLookups" @bind-ArtistName="artistName"
                        @bind-ArtistName:after="SyncArtistFromNameAsync"
                        ArtistLookupsChanged="OnArtistLookupsRefreshed"
                        OnArtistConfirmed="OnArtistConfirmedAsync" Disabled="isBusy" />

        <label class="form-label mt-3">Genre (optional)</label>
        <AddGenreField Genres="genres" @bind-GenreName="genreName"
                       @bind-GenreName:after="SyncGenreFromNameAsync"
                       GenresChanged="OnGenresRefreshed"
                       OnGenreConfirmed="OnGenreConfirmedAsync" Disabled="isBusy" />

        @if (!string.IsNullOrEmpty(localError))
        {
            <div class="alert alert-danger small mt-3 mb-0">@localError</div>
        }

        <div class="d-flex gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary flex-fill" disabled="@isBusy" @onclick="CancelAsync">
                Cancel
            </button>
            <button type="button" class="btn btn-outline-primary flex-fill" disabled="@(!CanAddSong || isBusy)"
                    @onclick="AddSongAsync">
                Add song
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<SongAddedEventArgs> OnSongAdded { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private IReadOnlyList<ArtistLookupDto> artistLookups = [];
    private IReadOnlyList<GenreDto> genres = [];
    private string title = string.Empty;
    private string artistName = string.Empty;
    private string genreName = string.Empty;
    private int? confirmedArtistId;
    private int? confirmedGenreId;
    private string? localError;
    private bool isBusy;
    private bool isLoading = true;

    private bool CanAddSong =>
        !string.IsNullOrWhiteSpace(title)
        && ResolveArtistId() is not null
        && !NeedsNewGenre();

    private int? ResolveArtistId() =>
        confirmedArtistId ?? LogArtistPicker.ResolveArtistId(artistName, artistLookups);

    private int? ResolveGenreId() =>
        confirmedGenreId ?? LogGenrePicker.ResolveGenreId(genreName, genres);

    private bool NeedsNewGenre() =>
        !string.IsNullOrWhiteSpace(genreName)
        && ResolveGenreId() is null;

    protected override async Task OnInitializedAsync()
    {
        artistLookups = await Api.GetArtistLookupsAsync();
        genres = await Api.GetGenresAsync();
        isLoading = false;
    }

    private void OnArtistLookupsRefreshed(IReadOnlyList<ArtistLookupDto> refreshed)
    {
        artistLookups = refreshed;
        confirmedArtistId ??= LogArtistPicker.ResolveArtistId(artistName, refreshed);
    }

    private void OnGenresRefreshed(IReadOnlyList<GenreDto> refreshed)
    {
        genres = refreshed;
        confirmedGenreId ??= LogGenrePicker.ResolveGenreId(genreName, refreshed);
    }

    private Task SyncArtistFromNameAsync()
    {
        confirmedArtistId = LogArtistPicker.ResolveArtistId(artistName, artistLookups);
        return Task.CompletedTask;
    }

    private Task SyncGenreFromNameAsync()
    {
        confirmedGenreId = LogGenrePicker.ResolveGenreId(genreName, genres);
        return Task.CompletedTask;
    }

    private Task OnArtistConfirmedAsync(ArtistConfirmedEventArgs args)
    {
        artistName = args.Name;
        confirmedArtistId = args.Id;
        return Task.CompletedTask;
    }

    private Task OnGenreConfirmedAsync(GenreConfirmedEventArgs args)
    {
        genreName = args.Name;
        confirmedGenreId = args.Id;
        return Task.CompletedTask;
    }

    private async Task AddSongAsync()
    {
        localError = null;
        var trimmedTitle = title.Trim();
        var trimmedArtist = artistName.Trim();
        var trimmedGenre = genreName.Trim();
        var artistId = confirmedArtistId ?? LogArtistPicker.ResolveArtistId(trimmedArtist, artistLookups);
        var resolvedGenreId = confirmedGenreId ?? LogGenrePicker.ResolveGenreId(trimmedGenre, genres);

        if (string.IsNullOrWhiteSpace(trimmedTitle))
        {
            localError = "Song title is required.";
            return;
        }

        if (artistId is null)
        {
            localError = LogArtistPicker.NeedsNewArtist(trimmedArtist, artistLookups)
                ? $"Add artist \"{trimmedArtist}\" first, then tap Add song."
                : "Artist is required.";
            return;
        }

        if (NeedsNewGenre())
        {
            localError = $"Add genre \"{trimmedGenre}\" first, then tap Add song.";
            return;
        }

        isBusy = true;
        try
        {
            await Api.CreateSongAsync(new SongDto
            {
                Title = trimmedTitle,
                Artist = artistId,
                Genre = resolvedGenreId
            });

            await OnSongAdded.InvokeAsync(new SongAddedEventArgs(trimmedTitle, trimmedArtist));
        }
        catch (Exception ex)
        {
            localError = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task CancelAsync() => OnCancelled.InvokeAsync();
}
