@inject IKaraokeApiClient Api
@inject ILogCatalogLoader CatalogLoader

<div class="log-new-song-panel border-top pt-3 mt-2">
    @if (isLoading)
    {
        <p class="text-muted small">Loading…</p>
    }
    else
    {
        <label class="form-label">Title</label>
        <input class="form-control mb-2" @bind="title" />

        <label class="form-label">Artist</label>
        <SongArtistsEditor ArtistNames="@artistNames"
                           ArtistNamesChanged="OnArtistNamesChangedAsync"
                           ArtistLookups="@artistLookups"
                           Disabled="@isBusy" />

        <CanonicalNameCheck Title="@title" TitleChanged="OnTitleChangedAsync"
                            ArtistName="@PrimaryArtistName" ArtistNameChanged="OnArtistNameChangedAsync"
                            OnCanonicalApplied="OnCanonicalAppliedAsync"
                            Disabled="@isBusy" />

        <label class="form-label mt-3">Genre (optional)</label>
        <AddGenreField Genres="@genres" @bind-GenreName="genreName"
                       @bind-GenreName:after="SyncGenreFromNameAsync"
                       GenresChanged="OnGenresRefreshed"
                       OnGenreConfirmed="OnGenreConfirmedAsync" Disabled="@isBusy"
                       Title="@title" Artist="@PrimaryArtistName" />

        @if (!string.IsNullOrEmpty(localError))
        {
            <div class="alert alert-danger small mt-3 mb-0">@localError</div>
        }

        <div class="d-flex gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary flex-fill" disabled="@isBusy" @onclick="CancelAsync">
                Cancel
            </button>
            <button type="button" class="btn btn-outline-primary flex-fill" disabled="@(!CanAddSong || isBusy)"
                    @onclick="AddSongAsync">
                Add song
            </button>
        </div>
        @if (!CanAddSong && !isBusy && !string.IsNullOrEmpty(AddSongHint))
        {
            <p class="form-text mb-0 mt-2">@AddSongHint</p>
        }
    }
</div>

@code {
    [Parameter]
    public EventCallback<SongAddedEventArgs> OnSongAdded { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private IReadOnlyList<ArtistLookupDto> artistLookups = [];
    private IReadOnlyList<GenreDto> genres = [];
    private string title = string.Empty;
    private List<string> artistNames = [string.Empty];
    private string genreName = string.Empty;
    private int? confirmedGenreId;
    private string? artistCreditDisplay;
    private string? recordingMbid;
    private string? localError;
    private bool isBusy;
    private bool isLoading = true;

    private string PrimaryArtistName => artistNames.FirstOrDefault(name => !string.IsNullOrWhiteSpace(name))?.Trim() ?? string.Empty;

    private bool CanAddSong =>
        !string.IsNullOrWhiteSpace(title)
        && ResolveArtistCredits().Count > 0
        && !NeedsNewGenre();

    private string? AddSongHint
    {
        get
        {
            if (string.IsNullOrWhiteSpace(title.Trim()))
            {
                return "Enter a song title first.";
            }

            if (string.IsNullOrWhiteSpace(PrimaryArtistName))
            {
                return "Type at least one artist name and pick from the list.";
            }

            if (ResolveArtistCredits().Count == 0)
            {
                return "Each artist must match an existing catalog artist before adding the song.";
            }

            if (NeedsNewGenre())
            {
                return $"Tap Add genre \"{genreName.Trim()}\" above, then Add song.";
            }

            return null;
        }
    }

    private List<SongArtistDto> ResolveArtistCredits()
    {
        var credits = new List<SongArtistDto>();
        foreach (var name in artistNames.Where(name => !string.IsNullOrWhiteSpace(name)))
        {
            var artistId = LogArtistPicker.ResolveArtistId(name, artistLookups);
            if (artistId is null)
            {
                return [];
            }

            credits.Add(new SongArtistDto
            {
                ArtistId = artistId.Value,
                DisplayOrder = credits.Count,
                Name = name.Trim()
            });
        }

        return credits;
    }

    private int? ResolveGenreId() =>
        confirmedGenreId ?? LogGenrePicker.ResolveGenreId(genreName, genres);

    private bool NeedsNewGenre() =>
        !string.IsNullOrWhiteSpace(genreName)
        && ResolveGenreId() is null;

    protected override async Task OnInitializedAsync()
    {
        var cached = await CatalogLoader.TryGetCachedLookupsAsync();
        if (cached is not null)
        {
            artistLookups = cached.Artists;
            genres = cached.Genres;
            isLoading = false;
            _ = RefreshLookupsInBackgroundAsync();
            return;
        }

        await LoadLookupsAsync();
    }

    private async Task RefreshLookupsInBackgroundAsync()
    {
        try
        {
            if (!await CatalogLoader.NeedsRefreshAsync())
            {
                return;
            }

            var refreshed = await CatalogLoader.LoadLookupsAsync();
            artistLookups = refreshed.Artists;
            genres = refreshed.Genres;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Background refresh failures are silent.
        }
    }

    private async Task LoadLookupsAsync()
    {
        isLoading = true;
        try
        {
            var result = await CatalogLoader.LoadLookupsAsync();
            artistLookups = result.Artists;
            genres = result.Genres;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task OnArtistNamesChangedAsync(List<string> names)
    {
        artistNames = names.Count == 0 ? [string.Empty] : names;
        return Task.CompletedTask;
    }

    private Task OnGenresRefreshed(IReadOnlyList<GenreDto> refreshed)
    {
        genres = refreshed;
        confirmedGenreId ??= LogGenrePicker.ResolveGenreId(genreName, refreshed);
        return Task.CompletedTask;
    }

    private Task SyncGenreFromNameAsync()
    {
        confirmedGenreId = LogGenrePicker.ResolveGenreId(genreName, genres);
        return Task.CompletedTask;
    }

    private Task OnGenreConfirmedAsync(GenreConfirmedEventArgs args)
    {
        genreName = args.Name;
        confirmedGenreId = args.Id;
        return Task.CompletedTask;
    }

    private Task OnTitleChangedAsync(string value)
    {
        title = value;
        return Task.CompletedTask;
    }

    private Task OnArtistNameChangedAsync(string value)
    {
        if (artistNames.Count == 0)
        {
            artistNames.Add(value);
        }
        else
        {
            artistNames[0] = value;
        }

        return Task.CompletedTask;
    }

    private Task OnCanonicalAppliedAsync(CanonicalAppliedEventArgs args)
    {
        title = args.Title;
        recordingMbid = args.RecordingMbid;
        artistCreditDisplay = args.ArtistCreditDisplay;
        artistNames = args.ArtistNames?.ToList() ?? [args.ArtistName];
        return Task.CompletedTask;
    }

    private async Task AddSongAsync()
    {
        localError = null;
        var trimmedTitle = title.Trim();
        var trimmedGenre = genreName.Trim();
        var artistCredits = ResolveArtistCredits();
        var resolvedGenreId = confirmedGenreId ?? LogGenrePicker.ResolveGenreId(trimmedGenre, genres);

        if (string.IsNullOrWhiteSpace(trimmedTitle))
        {
            localError = "Song title is required.";
            return;
        }

        if (artistCredits.Count == 0)
        {
            localError = "Each artist must exist in the catalog before adding the song.";
            return;
        }

        if (NeedsNewGenre())
        {
            localError = $"Add genre \"{trimmedGenre}\" first, then tap Add song.";
            return;
        }

        isBusy = true;
        try
        {
            var created = await Api.CreateSongAsync(new SongDto
            {
                Title = trimmedTitle,
                Genre = resolvedGenreId,
                RecordingMbid = recordingMbid,
                ArtistCreditDisplay = artistCreditDisplay,
                Artists = artistCredits
            });

            var artistDisplay = SongArtistFormatting.FormatDisplay(
                artistCreditDisplay,
                artistCredits.Select(a => a.Name));
            var snapshot = await CatalogLoader.PatchCachedSongAsync(created.Id, trimmedTitle, artistDisplay);
            await OnSongAdded.InvokeAsync(new SongAddedEventArgs(created.Id, trimmedTitle, artistDisplay, snapshot));
        }
        catch (Exception ex)
        {
            localError = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task CancelAsync() => OnCancelled.InvokeAsync();
}
