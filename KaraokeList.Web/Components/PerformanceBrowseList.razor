@inject IKaraokeApiClient Api
@inject NavigationManager Navigation

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success py-2 small">@statusMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger py-2 small">@errorMessage</div>
}

<ul class="performance-browse-list">
    @foreach (var entry in Entries)
    {
        <li class="performance-browse-item">
            @if (editingId == entry.Id)
            {
                <PerformanceEditForm SingerId="SingerId"
                                     Venues="venues"
                                     KeyOptions="keyOptions"
                                     @bind-PerformedOn="editPerformedOn"
                                     @bind-VenueId="editVenueId"
                                     @bind-KeyChangeSemitones="editKeyChangeSemitones"
                                     @bind-OtherPerformers="editOtherPerformers"
                                     IsSaving="isSaving"
                                     OnSave="() => SaveEditAsync(entry)"
                                     OnCancel="CancelEdit">
                    <HeaderContent>
                        <p class="performance-browse-song mb-2">
                            @ShowHostMessageFormatting.Format(
                                entry.Title,
                                entry.ArtistName,
                                editKeyChangeSemitones,
                                editCoPerformerNames)
                        </p>
                    </HeaderContent>
                </PerformanceEditForm>
            }
            else if (deleteConfirmId == entry.Id)
            {
                <p class="performance-browse-song mb-2">
                    @ShowHostMessageFormatting.Format(
                        entry.Title,
                        entry.ArtistName,
                        entry.KeyChangeSemitones,
                        entry.OtherPerformers.Select(p => p.Name).ToList())
                </p>
                <p class="small mb-2">Delete this performance?</p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger btn-sm flex-fill" disabled="@isSaving"
                            @onclick="() => ConfirmDeleteAsync(entry.Id)">Delete</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" disabled="@isSaving"
                            @onclick="CancelDelete">Cancel</button>
                </div>
            }
            else
            {
                <div class="performance-browse-row">
                    <button type="button" class="performance-browse-main" @onclick="() => GoToSongAsync(entry.SongId)">
                        <span class="performance-browse-song">
                            @ShowHostMessageFormatting.Format(
                                entry.Title,
                                entry.ArtistName,
                                entry.KeyChangeSemitones,
                                entry.OtherPerformers.Select(p => p.Name).ToList())
                        </span>
                        <span class="performance-browse-meta">
                            @entry.PerformedOn.ToString("d") · @entry.VenueName · @KeyChangeFormatting.Describe(entry.KeyChangeSemitones)
                        </span>
                    </button>
                    <div class="performance-browse-actions">
                        <a class="btn btn-link btn-sm p-0" href="@($"log?songId={entry.SongId}")">Log</a>
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => BeginEdit(entry)">Edit</button>
                        <button type="button" class="btn btn-link btn-sm p-0 text-danger" @onclick="() => BeginDelete(entry.Id)">Delete</button>
                    </div>
                </div>
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public int SingerId { get; set; }

    [Parameter]
    public IReadOnlyList<MyPerformanceEntryDto> Entries { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<VenueDto> venues = [];
    private List<SingerDto> singers = [];
    private IReadOnlyList<PerformanceKeyOption> keyOptions = PerformanceKeyOption.Choices;
    private int? editingId;
    private int? deleteConfirmId;
    private DateTime editPerformedOn = DateTime.Today;
    private int? editVenueId;
    private int? editKeyChangeSemitones;
    private List<CoPerformerInputDto> editOtherPerformers = [];
    private bool isSaving;
    private string? statusMessage;
    private string? errorMessage;

    private IReadOnlyList<string> editCoPerformerNames =>
        CoPerformerFormatting.GetDisplayNames(editOtherPerformers, singers);

    protected override async Task OnInitializedAsync()
    {
        venues = await Api.GetVenuesAsync();
        singers = await Api.GetSingersAsync();
    }

    private void GoToSongAsync(int songId) => Navigation.NavigateTo($"my-songs/{songId}");

    private void BeginEdit(MyPerformanceEntryDto entry)
    {
        deleteConfirmId = null;
        statusMessage = null;
        errorMessage = null;
        editingId = entry.Id;
        editPerformedOn = entry.PerformedOn;
        editVenueId = entry.VenueId;
        editKeyChangeSemitones = entry.KeyChangeSemitones;
        editOtherPerformers = PerformanceEditOperations.ToCoPerformerInputs(entry.OtherPerformers);
    }

    private void CancelEdit() => editingId = null;

    private void BeginDelete(int performanceId)
    {
        editingId = null;
        statusMessage = null;
        errorMessage = null;
        deleteConfirmId = performanceId;
    }

    private void CancelDelete() => deleteConfirmId = null;

    private async Task SaveEditAsync(MyPerformanceEntryDto entry)
    {
        if (editVenueId is null)
        {
            errorMessage = "Pick a venue.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;

        var result = await PerformanceEditOperations.UpdateAsync(
            Api,
            entry.Id,
            SingerId,
            entry.SongId,
            editPerformedOn,
            editVenueId,
            editKeyChangeSemitones,
            editOtherPerformers);

        if (result.Succeeded)
        {
            editingId = null;
            statusMessage = "Performance updated.";
            await OnChanged.InvokeAsync();
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        isSaving = false;
    }

    private async Task ConfirmDeleteAsync(int performanceId)
    {
        isSaving = true;
        errorMessage = null;
        statusMessage = null;

        var result = await PerformanceEditOperations.DeleteAsync(Api, performanceId);
        if (result.Succeeded)
        {
            deleteConfirmId = null;
            statusMessage = "Performance deleted.";
            await OnChanged.InvokeAsync();
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        isSaving = false;
    }
}
