@inject IKaraokeApiClient Api

@if (CanCheck)
{
    <button type="button" class="btn btn-link btn-sm p-0 mt-2 text-decoration-none"
            disabled="@(_isBusy || Disabled)"
            @onclick="CheckAsync">
        @if (_isBusy)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            <span>Checking MusicBrainz…</span>
        }
        else
        {
            <span>🎵 Check canonical names</span>
        }
    </button>
}

@if (_error is not null)
{
    <p class="form-text text-danger mb-0 mt-1">@_error</p>
}

@if (_match is not null)
{
    <div class="alert @(_namesMatch ? "alert-success" : "alert-info") small py-2 px-3 mt-2 mb-0" role="status">
        @if (_namesMatch)
        {
            <span>Names match MusicBrainz@(_match.Score > 0 ? $" ({_match.Score}% confidence)" : "").</span>
            <div class="mt-1">@_match.Title — @_match.ArtistCreditDisplay</div>
            @if (!string.IsNullOrWhiteSpace(_match.Disambiguation))
            {
                <div class="text-muted">@_match.Disambiguation</div>
            }
        }
        else
        {
            <div>
                <strong>MusicBrainz suggests:</strong>
                <div class="mt-1">@_match.Title — @_match.ArtistCreditDisplay</div>
                @if (!string.IsNullOrWhiteSpace(_match.Disambiguation))
                {
                    <div class="text-muted">@_match.Disambiguation</div>
                }
            </div>
        }
        @if (ShowApplyButton)
        {
            <button type="button" class="btn btn-outline-primary btn-sm mt-2"
                    disabled="@(_isBusy || Disabled)" @onclick="() => ApplyMatchAsync(_match)">
                @(_namesMatch ? "Apply MBID, genre & year" : "Use canonical names")
            </button>
        }
        @RenderMatchMetadata(_match)
        @if (_olderAlternativeYear is int olderYear)
        {
            <div class="mt-1 text-muted">Older version available in alternatives (@olderYear).</div>
        }
    </div>

    @if (_alternatives.Count > 0)
    {
        <details class="small mt-2">
            <summary class="text-muted">@_alternatives.Count other match@(_alternatives.Count == 1 ? "" : "es"), oldest first</summary>
            <ul class="list-unstyled mb-0 mt-2">
                @foreach (var alternative in _alternatives)
                {
                    <li class="border rounded p-2 mb-2">
                        <div>@alternative.Title — @alternative.ArtistCreditDisplay</div>
                        @if (!string.IsNullOrWhiteSpace(alternative.Disambiguation))
                        {
                            <div class="text-muted">@alternative.Disambiguation</div>
                        }
                        @RenderMatchMetadata(alternative)
                        @if (ShowApplyButton)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm mt-2"
                                    disabled="@(_isBusy || Disabled)" @onclick="() => ApplyMatchAsync(alternative)">
                                Use this match
                            </button>
                        }
                    </li>
                }
            </ul>
        </details>
    }
}

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> TitleChanged { get; set; }

    [Parameter, EditorRequired]
    public string ArtistName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ArtistNameChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ShowApplyButton { get; set; } = true;

    [Parameter]
    public bool AutoCheck { get; set; }

    /// <summary>Fired when canonical names are applied, including optional MBIDs, year, and genre.</summary>
    [Parameter]
    public EventCallback<CanonicalAppliedEventArgs> OnCanonicalApplied { get; set; }

    private CanonicalMatchDto? _match;
    private List<CanonicalMatchDto> _alternatives = [];
    private bool _namesMatch;
    private int? _olderAlternativeYear;
    private bool _isBusy;
    private string? _error;
    private string _lastCheckedKey = string.Empty;

    private bool CanCheck =>
        !string.IsNullOrWhiteSpace(Title) && !string.IsNullOrWhiteSpace(ArtistName);

    protected override async Task OnParametersSetAsync()
    {
        if (!AutoCheck || !CanCheck)
        {
            return;
        }

        var key = $"{Title.Trim().ToLowerInvariant()}|{ArtistName.Trim().ToLowerInvariant()}";
        if (key == _lastCheckedKey)
        {
            return;
        }

        await CheckAsync();
    }

    private async Task CheckAsync()
    {
        _error = null;
        _match = null;
        _alternatives = [];
        _olderAlternativeYear = null;
        _isBusy = true;
        try
        {
            var response = await Api.LookupCanonicalAsync(new CanonicalLookupRequest
            {
                Title = Title.Trim(),
                Artist = ArtistName.Trim()
            });

            _match = response?.Match.Found == true ? response.Match : null;
            _alternatives = response?.Alternatives ?? [];
            if (_match is null)
            {
                _error = "No MusicBrainz match found — names will be saved as entered.";
                _lastCheckedKey = string.Empty;
                return;
            }

            _namesMatch = MusicBrainzSearchHelper.NamesMatchCatalog(
                Title.Trim(),
                ArtistName.Trim(),
                _match);
            _olderAlternativeYear = _alternatives
                .Where(a => a.Year is int year && (_match.Year is null || year < _match.Year))
                .Select(a => a.Year)
                .Min();
            _lastCheckedKey = $"{Title.Trim().ToLowerInvariant()}|{ArtistName.Trim().ToLowerInvariant()}";
        }
        catch
        {
            _error = "Could not reach MusicBrainz — names will be saved as entered.";
            _lastCheckedKey = string.Empty;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ApplyMatchAsync(CanonicalMatchDto match)
    {
        _match = match;
        var catalogTitle = Title.Trim();
        var catalogArtist = ArtistName.Trim();
        var artistEquivalent = MusicBrainzSearchHelper.ArtistMatchesSearch(catalogArtist, match.ArtistCreditDisplay);
        var titleEquivalent = MusicBrainzSearchHelper.TitleMatchesSearch(catalogTitle, match.Title);

        if (!titleEquivalent)
        {
            await TitleChanged.InvokeAsync(match.Title);
        }

        if (!artistEquivalent)
        {
            await ArtistNameChanged.InvokeAsync(match.ArtistName);
        }

        await OnCanonicalApplied.InvokeAsync(new CanonicalAppliedEventArgs(
            titleEquivalent ? catalogTitle : match.Title,
            artistEquivalent ? catalogArtist : match.ArtistName,
            match.RecordingMbid,
            match.ArtistMbid,
            artistEquivalent ? catalogArtist : match.ArtistCreditDisplay,
            artistEquivalent ? null : match.ArtistCredits.Select(c => c.Name).ToList(),
            match.Year,
            match.SuggestedGenreName));
        _namesMatch = true;
    }

    private RenderFragment RenderMatchMetadata(CanonicalMatchDto match) => builder =>
    {
        if (match.Year is not int && string.IsNullOrWhiteSpace(match.SuggestedGenreName))
        {
            return;
        }

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mt-1 text-muted");
        if (match.Year is int year)
        {
            builder.AddContent(2, $"Year: {year}");
        }

        if (!string.IsNullOrWhiteSpace(match.SuggestedGenreName))
        {
            builder.AddContent(3, match.Year is int ? $" Genre: {match.SuggestedGenreName}" : $"Genre: {match.SuggestedGenreName}");
        }

        builder.CloseElement();
    };
}
