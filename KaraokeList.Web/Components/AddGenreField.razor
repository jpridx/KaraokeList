@inject IKaraokeApiClient Api
@inject ILogCatalogLoader CatalogLoader

<SfAutoComplete TValue="string" TItem="GenreDto" DataSource="@Genres"
                @bind-Value="_name" @bind-Value:after="PropagateValueAsync"
                Placeholder="Search or type genre..."
                AllowCustom="true" ShowClearButton="true"
                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
    <AutoCompleteFieldSettings Value="GenreName" Text="GenreName" />
</SfAutoComplete>

@if (string.IsNullOrWhiteSpace(_name) && CanSuggest)
{
    <button type="button" class="btn btn-link btn-sm p-0 mt-2 text-decoration-none"
            disabled="@(_isBusy || _isSuggesting || Disabled)"
            @onclick="SuggestGenreAsync">
        @if (_isSuggesting)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            <span>Suggesting…</span>
        }
        else
        {
            <span>✨ Suggest genre</span>
        }
    </button>
}

@if (_suggestError is not null)
{
    <p class="form-text text-danger mb-0 mt-1">@_suggestError</p>
}

@if (string.IsNullOrWhiteSpace(_name) && !CanSuggest)
{
    <p class="form-text mb-0 mt-2">
        Optional. Type a genre, pick from the list, or tap <strong>Add genre</strong> if it's new.
    </p>
}

@if (LogGenrePicker.NeedsNewGenre(_name, Genres))
{
    <div class="alert alert-info small py-2 px-3 mt-2 mb-0" role="status">
        <strong>@_name.Trim()</strong> isn't in the catalog yet.
        Add the genre first — your song details stay filled in.
    </div>
    @if (!string.IsNullOrEmpty(_localError))
    {
        <div class="alert alert-danger small mt-2 mb-0">@_localError</div>
    }
    <button type="button" class="btn btn-outline-primary w-100 mt-2"
            disabled="@(_isBusy || Disabled)" @onclick="AddGenreAsync">
        Add genre "@_name.Trim()"
    </button>
}
else if (!string.IsNullOrWhiteSpace(_name) && LogGenrePicker.ResolveGenreId(_name, Genres) is not null)
{
    <p class="small text-muted mt-2 mb-0">Genre selected.</p>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<GenreDto> Genres { get; set; } = [];

    [Parameter, EditorRequired]
    public string GenreName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> GenreNameChanged { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<GenreDto>> GenresChanged { get; set; }

    /// <summary>Fired after a new genre is created so the parent can retain the catalog id.</summary>
    [Parameter]
    public EventCallback<GenreConfirmedEventArgs> OnGenreConfirmed { get; set; }

    /// <summary>When true, disables the "Add genre" button (e.g. parent is saving).</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Song title — enables the AI suggest button when both Title and Artist are provided.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Artist name — enables the AI suggest button when both Title and Artist are provided.</summary>
    [Parameter]
    public string Artist { get; set; } = string.Empty;

    private string _name = string.Empty;
    private bool _isBusy;
    private bool _isSuggesting;
    private bool _suppressValuePropagation;
    private string? _localError;
    private string? _suggestError;

    private bool CanSuggest =>
        !string.IsNullOrWhiteSpace(Title) && !string.IsNullOrWhiteSpace(Artist);

    protected override void OnParametersSet()
    {
        if (_name != GenreName)
            _name = GenreName;
    }

    private Task PropagateValueAsync()
    {
        if (_suppressValuePropagation)
        {
            return Task.CompletedTask;
        }

        return GenreNameChanged.InvokeAsync(_name);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_suppressValuePropagation)
        {
            return;
        }

        _suppressValuePropagation = false;

        if (!string.IsNullOrWhiteSpace(GenreName) && _name != GenreName)
        {
            _name = GenreName;
            StateHasChanged();
        }
        else if (!string.IsNullOrWhiteSpace(_name) && _name != GenreName)
        {
            await GenreNameChanged.InvokeAsync(_name);
        }
    }

    private async Task SuggestGenreAsync()
    {
        _suggestError = null;
        _isSuggesting = true;
        try
        {
            var suggestion = await Api.SuggestGenreAsync(new GenreSuggestionRequest
            {
                Title = Title.Trim(),
                Artist = Artist.Trim()
            });

            if (suggestion?.GenreName is not null)
            {
                _suppressValuePropagation = true;
                _name = suggestion.GenreName;
                await GenreNameChanged.InvokeAsync(_name);
            }
            else
            {
                _suggestError = "No suggestion available — pick a genre manually.";
            }
        }
        catch
        {
            _suggestError = "Could not reach the suggestion service — pick a genre manually.";
        }
        finally
        {
            _isSuggesting = false;
        }
    }

    private async Task AddGenreAsync()
    {
        _localError = null;
        var trimmedName = _name.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            _localError = "Genre name is required.";
            return;
        }

        _isBusy = true;
        try
        {
            await Api.CreateGenreAsync(new GenreDto { GenreName = trimmedName });
            var refreshed = await CatalogLoader.LoadLookupsAsync();
            _suppressValuePropagation = true;
            _name = trimmedName;
            // Propagate the confirmed name first so that when the lookup change
            // triggers a parent re-render, GenreName is already correct and
            // OnParametersSet does not reset _name back to the old value.
            await GenreNameChanged.InvokeAsync(trimmedName);
            await GenresChanged.InvokeAsync(refreshed.Genres);

            if (LogGenrePicker.ResolveGenreId(trimmedName, refreshed.Genres) is int genreId)
            {
                await OnGenreConfirmed.InvokeAsync(new GenreConfirmedEventArgs(trimmedName, genreId));
            }
        }
        catch (Exception ex)
        {
            _localError = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
