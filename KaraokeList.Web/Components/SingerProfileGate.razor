@inject ISingerProfileResolver ProfileResolver

@if (isResolving)
{
    <MobileLoadingState IsLoading="true" Message="Loading…" CssClass="text-muted small" />
}
else if (needsSingerLink)
{
    <SingerLinkPanel Visible="true" OnLinked="HandleLinkedAsync" />
}
else if (singerId is int id && ChildContent is not null)
{
    <CascadingValue Value="id" Name="SingerId">
        @ChildContent(id)
    </CascadingValue>
}

@code {
    [Parameter]
    public RenderFragment<int>? ChildContent { get; set; }

    [Parameter]
    public EventCallback<int?> OnLinked { get; set; }

    [Parameter]
    public EventCallback<int> OnResolved { get; set; }

    private bool isResolving = true;
    private bool needsSingerLink;
    private int? singerId;

    protected override async Task OnInitializedAsync() => await ResolveAsync();

    public async Task ResolveAsync()
    {
        isResolving = true;

        var result = await ProfileResolver.ResolveAsync();
        singerId = result.SingerId;
        needsSingerLink = singerId is null;
        isResolving = false;

        if (singerId is int id)
        {
            // Do not await page data loads here — cached catalog/lists should render
            // immediately while API calls continue in the child page.
            _ = InvokeOnResolvedAsync(id);

            if (result.UsedCachedSingerId)
            {
                _ = RefreshProfileInBackgroundAsync();
            }
        }
    }

    /// <summary>
    /// Forces the link panel when the API rejects the current profile (e.g. stale JWT claim).
    /// </summary>
    public void RequireSingerLink()
    {
        singerId = null;
        needsSingerLink = true;
    }

    private async Task HandleLinkedAsync(int? linkedSingerId)
    {
        singerId = linkedSingerId;
        needsSingerLink = linkedSingerId is null;
        await OnLinked.InvokeAsync(linkedSingerId);

        if (linkedSingerId is int id)
        {
            _ = InvokeOnResolvedAsync(id);
        }
    }

    private async Task InvokeOnResolvedAsync(int id)
    {
        try
        {
            await OnResolved.InvokeAsync(id);
        }
        catch
        {
            // Page load failures are surfaced by the child page.
        }
    }

    private async Task RefreshProfileInBackgroundAsync()
    {
        try
        {
            await ProfileResolver.RefreshFromApiAsync();
        }
        catch
        {
            // Background refresh failures are silent.
        }
    }
}
