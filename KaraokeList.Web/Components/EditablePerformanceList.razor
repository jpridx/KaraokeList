@inject IKaraokeApiClient Api
@inject NavigationManager Navigation
@inject IPerformanceCacheCoordinator PerformanceCache

@if (!string.IsNullOrEmpty(statusMessage) || !string.IsNullOrEmpty(errorMessage))
{
    <StatusAlerts SuccessMessage="@statusMessage" ErrorMessage="@errorMessage" Small="true" />
}

<ul class="@ListClass">
    @foreach (var entry in Entries)
    {
        <li class="@ItemClass">
            @if (editingId == entry.Id)
            {
                <PerformanceEditForm SingerId="@SingerId"
                                     Venues="@venues"
                                     KeyOptions="@keyOptions"
                                     @bind-PerformedOn="editPerformedOn"
                                     @bind-VenueId="editVenueId"
                                     @bind-KeyChangeSemitones="editKeyChangeSemitones"
                                     @bind-OtherPerformers="editOtherPerformers"
                                     IsSaving="@isSaving"
                                     OnSave="() => SaveEditAsync(entry)"
                                     OnCancel="CancelEdit">
                    <HeaderContent>
                        @if (Variant == EditablePerformanceListVariant.Browse)
                        {
                            <p class="performance-browse-song mb-2">@FormatSongLabel(entry, editKeyChangeSemitones, editCoPerformerNames)</p>
                        }
                    </HeaderContent>
                </PerformanceEditForm>
            }
            else if (deleteConfirmId == entry.Id)
            {
                @if (Variant == EditablePerformanceListVariant.Browse)
                {
                    <p class="performance-browse-song mb-2">@FormatSongLabel(entry, entry.KeyChangeSemitones, CoPerformerNames(entry))</p>
                }
                <p class="small mb-2">Delete this performance?</p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger btn-sm flex-fill" disabled="@isSaving"
                            @onclick="() => ConfirmDeleteAsync(entry.Id)">Delete</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" disabled="@isSaving"
                            @onclick="CancelDelete">Cancel</button>
                </div>
            }
            else if (Variant == EditablePerformanceListVariant.Browse)
            {
                <div class="performance-browse-row">
                    <button type="button" class="performance-browse-main" @onclick="() => GoToSongAsync(entry.SongId)">
                        <span class="performance-browse-song">@FormatSongLabel(entry, entry.KeyChangeSemitones, CoPerformerNames(entry))</span>
                        <span class="performance-browse-meta">@FormatMeta(entry)</span>
                    </button>
                    <div class="performance-browse-actions">
                        <a class="btn btn-link btn-sm p-0" href="@($"log?songId={entry.SongId}")">Log</a>
                        @if (AllowMutations)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => BeginEdit(entry)">Edit</button>
                            <button type="button" class="btn btn-link btn-sm p-0 text-danger" @onclick="() => BeginDelete(entry.Id)">Delete</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="history-row">
                    <div class="history-row-main">
                        <span class="history-date">@entry.PerformedOn.ToString("d")</span>
                        <span class="history-venue">@entry.VenueName</span>
                        <span class="history-key">@KeyChangeFormatting.Describe(entry.KeyChangeSemitones)</span>
                        @if (entry.OtherPerformers.Count > 0)
                        {
                            <span class="history-co-performers small text-muted">
                                with @string.Join(" & ", entry.OtherPerformers.Select(p => p.Name))
                            </span>
                        }
                    </div>
                    <div class="history-row-actions">
                        @if (AllowMutations)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => BeginEdit(entry)">Edit</button>
                            <button type="button" class="btn btn-link btn-sm p-0 text-danger" @onclick="() => BeginDelete(entry.Id)">Delete</button>
                        }
                    </div>
                </div>
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public int SingerId { get; set; }

    [Parameter]
    public EditablePerformanceListVariant Variant { get; set; } = EditablePerformanceListVariant.Browse;

    [Parameter]
    public IReadOnlyList<EditablePerformanceEntry> Entries { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public bool AllowMutations { get; set; } = true;

    private List<VenueDto> venues = [];
    private List<SingerDto> singers = [];
    private IReadOnlyList<PerformanceKeyOption> keyOptions = PerformanceKeyOption.Choices;
    private int? editingId;
    private int? deleteConfirmId;
    private PerformanceEditSnapshot? editBeforeSnapshot;
    private DateTime editPerformedOn = DateTime.Today;
    private int? editVenueId;
    private int? editKeyChangeSemitones;
    private List<CoPerformerInputDto> editOtherPerformers = [];
    private bool isSaving;
    private string? statusMessage;
    private string? errorMessage;

    private string ListClass => Variant == EditablePerformanceListVariant.Browse
        ? "performance-browse-list"
        : "history-list";

    private string ItemClass => Variant == EditablePerformanceListVariant.Browse
        ? "performance-browse-item"
        : "history-list-item";

    private IReadOnlyList<string> editCoPerformerNames =>
        CoPerformerFormatting.GetDisplayNames(editOtherPerformers, singers);

    protected override async Task OnInitializedAsync()
    {
        venues = await Api.GetVenuesAsync();
        if (Variant == EditablePerformanceListVariant.Browse)
        {
            singers = await Api.GetSingersAsync();
        }
    }

    private static IReadOnlyList<string> CoPerformerNames(EditablePerformanceEntry entry) =>
        entry.OtherPerformers.Select(p => p.Name).ToList();

    private static string FormatSongLabel(
        EditablePerformanceEntry entry,
        int? keyChangeSemitones,
        IReadOnlyList<string> coPerformerNames) =>
        ShowHostMessageFormatting.Format(
            entry.Title ?? string.Empty,
            entry.ArtistName ?? string.Empty,
            keyChangeSemitones,
            coPerformerNames);

    private static string FormatMeta(EditablePerformanceEntry entry) =>
        $"{entry.PerformedOn:d} · {entry.VenueName} · {KeyChangeFormatting.Describe(entry.KeyChangeSemitones)}";

    private void GoToSongAsync(int songId) => Navigation.NavigateTo($"my-songs/{songId}");

    private void BeginEdit(EditablePerformanceEntry entry)
    {
        deleteConfirmId = null;
        statusMessage = null;
        errorMessage = null;
        editingId = entry.Id;
        editBeforeSnapshot = ToSnapshot(entry);
        editPerformedOn = entry.PerformedOn;
        editVenueId = entry.VenueId;
        editKeyChangeSemitones = entry.KeyChangeSemitones;
        editOtherPerformers = PerformanceEditOperations.ToCoPerformerInputs(entry.OtherPerformers);
    }

    private void CancelEdit()
    {
        editingId = null;
        editBeforeSnapshot = null;
    }

    private void BeginDelete(int performanceId)
    {
        editingId = null;
        statusMessage = null;
        errorMessage = null;
        deleteConfirmId = performanceId;
    }

    private void CancelDelete() => deleteConfirmId = null;

    private async Task SaveEditAsync(EditablePerformanceEntry entry)
    {
        isSaving = true;
        errorMessage = null;
        statusMessage = null;

        var result = await PerformanceEditOperations.UpdateAsync(
            Api,
            entry.Id,
            SingerId,
            entry.SongId,
            editPerformedOn,
            editVenueId,
            editKeyChangeSemitones,
            editOtherPerformers);

        if (result.Succeeded)
        {
            if (editBeforeSnapshot is not null)
            {
                await PerformanceCache.PatchAfterUpdateAsync(
                    editBeforeSnapshot,
                    BuildAfterSnapshot(entry, editBeforeSnapshot));
            }

            editingId = null;
            editBeforeSnapshot = null;
            statusMessage = "Performance updated.";
            await OnChanged.InvokeAsync();
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        isSaving = false;
    }

    private async Task ConfirmDeleteAsync(int performanceId)
    {
        isSaving = true;
        errorMessage = null;
        statusMessage = null;

        var result = await PerformanceEditOperations.DeleteAsync(Api, performanceId);
        if (result.Succeeded)
        {
            var deletedEntry = Entries.FirstOrDefault(e => e.Id == performanceId);
            if (deletedEntry is not null)
            {
                await PerformanceCache.PatchAfterDeleteAsync(ToSnapshot(deletedEntry));
            }

            deleteConfirmId = null;
            statusMessage = "Performance deleted.";
            await OnChanged.InvokeAsync();
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        isSaving = false;
    }

    private static PerformanceEditSnapshot ToSnapshot(EditablePerformanceEntry entry) =>
        new(
            entry.Id,
            entry.SongId,
            entry.Title ?? string.Empty,
            entry.ArtistName ?? string.Empty,
            entry.ArtistName,
            entry.PerformedOn,
            entry.VenueId,
            entry.VenueName,
            entry.KeyChangeSemitones);

    private PerformanceEditSnapshot BuildAfterSnapshot(
        EditablePerformanceEntry entry,
        PerformanceEditSnapshot before)
    {
        var venueName = venues.FirstOrDefault(v => v.Id == editVenueId)?.VenueName
            ?? before.VenueName;

        return before with
        {
            PerformedOn = editPerformedOn,
            VenueId = editVenueId,
            VenueName = venueName,
            KeyChangeSemitones = editKeyChangeSemitones
        };
    }
}
