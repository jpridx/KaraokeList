@inject ILogPerformanceLocalStore LogStore
@inject ILogCatalogLoader CatalogLoader
@inject IMyPerformancesLoader PerformancesLoader
@using KaraokeList.Shared

<section class="tonight-dashboard mobile-panel">
    <header class="tonight-dashboard-header">
        <h2 class="h5 mb-1">Tonight</h2>
        <p class="text-muted small mb-0">@DateTime.Today.ToString("dddd, MMMM d")</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(defaultVenueName))
    {
        <p class="tonight-default-venue small mb-0 mt-3">
            Default venue: <strong>@defaultVenueName</strong>
        </p>
    }

    @if (recentLogs.Count > 0)
    {
        <RecentLogList Items="@recentLogs" Heading="Recently logged" HeadingClass="h6 mt-3 mb-2"
                       MaxItems="@LogPerformanceLocalStore.MaxRecentLogs" UseLinks="true" />
        <div class="tonight-actions mt-3">
            <a class="btn btn-primary btn-lg w-100 mb-2" href="log">Log performance</a>
            <a class="btn btn-outline-primary w-100" href="my-songs">My Songs</a>
        </div>
    }
    else
    {
        <NoPerformancesEmptyState ActionText="Log your first song"
                                  ActionButtonClass="btn btn-primary btn-lg w-100 mb-2"
                                  CssClass="mt-3"
                                  MessageClass="text-muted small mb-3" />
        <div class="tonight-actions">
            <a class="btn btn-outline-primary w-100" href="my-songs">My Songs</a>
        </div>
    }
</section>

@code {
    private string? defaultVenueName;
    private IReadOnlyList<RecentLoggedPerformance> recentLogs = [];

    private sealed record PerformancesHydrationSource(
        IReadOnlyList<MyPerformanceEntryDto> Performances,
        DateTime HydratedAtLocal);

    protected override async Task OnInitializedAsync()
    {
        // Load from localStorage immediately — no API call needed for the core content.
        var defaults = await LogStore.GetFormDefaultsAsync();
        recentLogs = await LogStore.GetRecentLogsAsync();

        if (defaults?.VenueId is int venueId)
        {
            // Resolve the venue name in the background so the dashboard renders instantly.
            _ = LoadVenueNameAsync(venueId);
        }

        _ = RefreshRecentLogsIfNeededAsync();
    }

    private async Task RefreshRecentLogsIfNeededAsync()
    {
        try
        {
            var localLogs = await LogStore.GetRecentLogsAsync();
            var newestLoggedAt = localLogs.Count > 0 ? localLogs.Max(l => l.LoggedAt) : (DateTime?)null;
            if (RecentLogsRefreshPolicy.ShouldUseLocalRecentLogs(newestLoggedAt))
            {
                return;
            }

            var pending = await LogStore.GetPendingPerformancesAsync();
            var source = await GetPerformancesForHydrationAsync();
            if (source is null || source.Performances.Count == 0)
            {
                return;
            }

            var merged = RecentLogsHydrator.Merge(
                source.Performances,
                localLogs,
                pending,
                hydratedAt: source.HydratedAtLocal);
            if (merged.Count == 0)
            {
                return;
            }

            await LogStore.ReplaceRecentLogsAsync(merged);
            recentLogs = merged;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Non-fatal; stale local recent logs remain until the next successful refresh.
        }
    }

    private async Task<PerformancesHydrationSource?> GetPerformancesForHydrationAsync()
    {
        var cached = await PerformancesLoader.TryGetCachedAsync();
        if (cached is not null
            && cached.Performances.Count > 0
            && cached.CachedAtUtc is DateTime cachedAtUtc
            && DateTime.UtcNow - cachedAtUtc < CatalogCachePolicy.RefreshThreshold)
        {
            return new PerformancesHydrationSource(cached.Performances, ToLocalTime(cachedAtUtc));
        }

        var loaded = await PerformancesLoader.LoadAsync();
        if (loaded.Performances.Count > 0)
        {
            var hydratedAtUtc = loaded.CachedAtUtc ?? DateTime.UtcNow;
            return new PerformancesHydrationSource(loaded.Performances, ToLocalTime(hydratedAtUtc));
        }

        if (cached is not null && cached.Performances.Count > 0 && cached.CachedAtUtc is DateTime staleCachedAtUtc)
        {
            return new PerformancesHydrationSource(cached.Performances, ToLocalTime(staleCachedAtUtc));
        }

        return null;
    }

    private static DateTime ToLocalTime(DateTime timestamp) =>
        timestamp.Kind == DateTimeKind.Utc ? timestamp.ToLocalTime() : timestamp;

    private async Task LoadVenueNameAsync(int venueId)
    {
        try
        {
            var venueResult = await CatalogLoader.LoadVenuesAsync();
            defaultVenueName = venueResult.Venues.FirstOrDefault(v => v.Id == venueId)?.VenueName;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Non-fatal; dashboard works fine without the venue name label.
        }
    }
}
