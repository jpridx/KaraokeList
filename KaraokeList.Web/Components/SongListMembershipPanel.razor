@using KaraokeList.Shared

<section class="mobile-panel song-list-membership-panel">
    <h2 class="h6 mb-2">Lists</h2>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <p class="small text-success mb-2">@statusMessage</p>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="small text-danger mb-2">@errorMessage</p>
    }

    @if (membership.Count == 0)
    {
        <p class="small text-muted mb-2">Not on any list yet.</p>
    }
    else
    {
        <div class="genre-chips mb-2">
            @foreach (var kind in membership.OrderBy(k => k))
            {
                <span class="genre-chip active">@SingerListKindNames.DisplayName(kind)</span>
            }
        </div>
    }

    @if (pendingCollisions.Count > 0)
    {
        <TitleArtistDuplicateConfirm Collisions="@pendingCollisions"
                                     Disabled="@isBusy"
                                     OnCancel="CancelDuplicateConfirmAsync"
                                     OnConfirm="ConfirmDuplicateAddAsync" />
    }

    <div class="d-flex flex-wrap gap-2">
        @if (CanAddToWantToSing)
        {
            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@isBusy"
                    @onclick="() => AddToListAsync(SingerListKind.WantToSing)">
                Add to want to sing
            </button>
        }
        @if (CanAddToWorkingUp)
        {
            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@isBusy"
                    @onclick="() => AddToListAsync(SingerListKind.WorkingUp)">
                Add to working up
            </button>
        }
        @if (membership.Contains(SingerListKind.WantToSing))
        {
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@isBusy"
                    @onclick="() => RemoveFromListAsync(SingerListKind.WantToSing)">
                Remove from want to sing
            </button>
        }
        @if (membership.Contains(SingerListKind.WorkingUp))
        {
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@isBusy"
                    @onclick="() => RemoveFromListAsync(SingerListKind.WorkingUp)">
                Remove from working up
            </button>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public int SongId { get; set; }

    [Parameter]
    public int PerformanceCount { get; set; }

    [Parameter]
    public RepertoireSongDto? SongMeta { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnMembershipChanged { get; set; }

    [Inject]
    private IKaraokeApiClient Api { get; set; } = default!;

    [Inject]
    private IMySongsLoader MySongsLoader { get; set; } = default!;

    private readonly HashSet<SingerListKind> membership = [];
    private List<SingerListDto> singerLists = [];
    private bool isBusy;
    private string? statusMessage;
    private string? errorMessage;
    private List<(SingerListKind Kind, TitleArtistCollisionDto Collision)> pendingCollisions = [];
    private SingerListKind? pendingAddKind;
    private int? pendingSongId;

    private void ClearPendingDuplicateConfirm()
    {
        pendingCollisions = [];
        pendingAddKind = null;
        pendingSongId = null;
    }

    private bool CanAddToWantToSing =>
        !membership.Contains(SingerListKind.WantToSing)
        && !membership.Contains(SingerListKind.MyRepertoire)
        && PerformanceCount == 0;

    private bool CanAddToWorkingUp => !membership.Contains(SingerListKind.WorkingUp);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        statusMessage = null;
        errorMessage = null;
        ClearPendingDuplicateConfirm();

        var listsResult = await SingerListResolver.LoadListsAsync(Api);
        if (!listsResult.Succeeded)
        {
            errorMessage = listsResult.ErrorMessage;
            return;
        }

        singerLists = listsResult.Lists;

        var membershipResult = await Api.GetSongListMembershipAsync(SongId);
        if (!membershipResult.Succeeded)
        {
            errorMessage = membershipResult.ErrorMessage;
            return;
        }

        membership.Clear();
        foreach (var kind in membershipResult.Lists)
        {
            membership.Add(kind);
        }
    }

    private async Task AddToListAsync(SingerListKind kind)
    {
        isBusy = true;
        errorMessage = null;
        statusMessage = null;
        ClearPendingDuplicateConfirm();

        try
        {
            var collisionCheck = await SingerListActions.CheckTitleArtistCollisionsAsync(
                Api, singerLists, SongId, [kind]);
            if (!collisionCheck.Succeeded)
            {
                errorMessage = collisionCheck.ErrorMessage;
                return;
            }

            if (collisionCheck.HasCollisions)
            {
                pendingCollisions = collisionCheck.Collisions;
                pendingAddKind = kind;
                pendingSongId = SongId;
                return;
            }

            await ExecuteAddAsync(kind, allowTitleArtistDuplicate: false);
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task CancelDuplicateConfirmAsync()
    {
        ClearPendingDuplicateConfirm();
        return Task.CompletedTask;
    }

    private async Task ConfirmDuplicateAddAsync()
    {
        if (pendingAddKind is not SingerListKind kind
            || pendingSongId != SongId)
        {
            ClearPendingDuplicateConfirm();
            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            await ExecuteAddAsync(kind, allowTitleArtistDuplicate: true);
        }
        finally
        {
            isBusy = false;
            ClearPendingDuplicateConfirm();
        }
    }

    private async Task ExecuteAddAsync(SingerListKind kind, bool allowTitleArtistDuplicate)
    {
        var result = await SingerListActions.AddSongAsync(
            Api, singerLists, kind, SongId, allowTitleArtistDuplicate);
        if (!result.Succeeded)
        {
            errorMessage = result.ErrorMessage;
            return;
        }

        statusMessage = result.SuccessMessage;
        membership.Add(kind);
        await PatchCachedListBestEffortAsync(kind, added: true);
        await OnMembershipChanged.InvokeAsync();

        try
        {
            await LoadAsync();
        }
        catch
        {
            // Membership refresh is best-effort after the cache patch.
        }
    }

    private async Task RemoveFromListAsync(SingerListKind kind)
    {
        isBusy = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            var result = await SingerListActions.RemoveSongAsync(Api, singerLists, kind, SongId);
            if (!result.Succeeded)
            {
                errorMessage = result.ErrorMessage;
                return;
            }

            statusMessage = result.SuccessMessage;
            membership.Remove(kind);
            await PatchCachedListBestEffortAsync(kind, added: false);
            await OnMembershipChanged.InvokeAsync();

            try
            {
                await LoadAsync();
            }
            catch
            {
                // Membership refresh is best-effort after the cache patch.
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PatchCachedListBestEffortAsync(SingerListKind kind, bool added)
    {
        try
        {
            if (added)
            {
                var song = SongMeta ?? new RepertoireSongDto { SongId = SongId };
                await MySongsLoader.AddSongToCachedListAsync(kind, song);
            }
            else
            {
                await MySongsLoader.RemoveSongFromCachedListAsync(kind, SongId);
            }
        }
        catch
        {
            // Cache patching is best-effort after a successful API mutation.
        }
    }
}
