@inject IKaraokeApiClient Api

<details class="mobile-panel song-about-details mt-2">
    <summary class="history-details-summary" @onclick="OnSummaryClickedAsync">About this song</summary>
    <div class="song-about-body mt-2">
        @if (_isLoading)
        {
            <p class="small text-muted mb-0">Loading…</p>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <p class="small text-danger mb-0">@_error</p>
        }
        else if (_about is not null)
        {
            @if (HasAnyDetails(_about))
            {
                <dl class="song-about-facts small mb-0">
                    @if (!string.IsNullOrWhiteSpace(_about.ArtistDisplay))
                    {
                        <dt class="text-muted">Artists</dt>
                        <dd class="mb-2">@_about.ArtistDisplay</dd>
                    }
                    @if (_about.Year is int year)
                    {
                        <dt class="text-muted">Released</dt>
                        <dd class="mb-2">@year</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(_about.GenreName))
                    {
                        <dt class="text-muted">Genre</dt>
                        <dd class="mb-2">@_about.GenreName</dd>
                    }
                    @if (_about.Enrichment is not null)
                    {
                        @if (!string.IsNullOrWhiteSpace(_about.Enrichment.NotableRelease))
                        {
                            <dt class="text-muted">From</dt>
                            <dd class="mb-2">@_about.Enrichment.NotableRelease</dd>
                        }
                        @if (_about.Enrichment.StyleTags.Count > 0)
                        {
                            <dt class="text-muted">Style</dt>
                            <dd class="mb-2">
                                @foreach (var tag in _about.Enrichment.StyleTags)
                                {
                                    <span class="badge text-bg-secondary me-1 mb-1">@tag</span>
                                }
                            </dd>
                        }
                        @if (_about.Enrichment.DurationMs is int durationMs)
                        {
                            <dt class="text-muted">Length</dt>
                            <dd class="mb-2">@FormatDuration(durationMs)</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(_about.Enrichment.VersionNote))
                        {
                            <dt class="text-muted">Note</dt>
                            <dd class="mb-2">@_about.Enrichment.VersionNote</dd>
                        }
                    }
                </dl>
                @if (_about.Enrichment is not null
                     && !string.IsNullOrWhiteSpace(_about.Enrichment.ExternalUrl))
                {
                    <p class="small text-muted mb-0 mt-2">
                        Source: <a href="@_about.Enrichment.ExternalUrl" target="_blank" rel="noopener noreferrer">MusicBrainz</a>
                    </p>
                }
            }
            else
            {
                <p class="small text-muted mb-0">No extra details yet.</p>
            }
        }
        else if (_hasExpanded)
        {
            <p class="small text-muted mb-0">No extra details yet.</p>
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired]
    public int SongId { get; set; }

    private SongAboutDto? _about;
    private bool _isLoading;
    private bool _hasExpanded;
    private bool _hasLoaded;
    private string? _error;

    private static bool HasAnyDetails(SongAboutDto about) =>
        !string.IsNullOrWhiteSpace(about.ArtistDisplay)
        || about.Year is int
        || !string.IsNullOrWhiteSpace(about.GenreName)
        || about.Enrichment is not null;

    private static string FormatDuration(int durationMs)
    {
        var totalSeconds = durationMs / 1000;
        var minutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;
        return $"{minutes}:{seconds:D2}";
    }

    private async Task OnSummaryClickedAsync()
    {
        if (_hasLoaded)
        {
            return;
        }

        _hasExpanded = true;
        await LoadAboutAsync();
    }

    private async Task LoadAboutAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var result = await Api.GetSongAboutAsync(SongId, enrich: true);
            if (result.Succeeded && result.About is not null)
            {
                _about = result.About;
            }
            else
            {
                _error = result.ErrorMessage ?? "Could not load song details.";
            }
        }
        catch
        {
            _error = "Could not load song details.";
        }
        finally
        {
            _isLoading = false;
            _hasLoaded = true;
        }
    }
}
