@if (Items.Count > 0)
{
    @if (!string.IsNullOrEmpty(Heading))
    {
        <h2 class="@HeadingClass">@Heading</h2>
    }
    <ul class="@ListClass">
        @foreach (var item in DisplayItems)
        {
            <li>
                <a class="recent-log-item text-decoration-none" href="@($"log?songId={item.SongId}")">
                    <span class="recent-log-title">@item.Title</span>
                    <span class="recent-log-meta">@item.Meta</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    [Parameter]
    public IReadOnlyList<SongLinkItem> Items { get; set; } = [];

    [Parameter]
    public string? Heading { get; set; }

    [Parameter]
    public string HeadingClass { get; set; } = "h6 mb-2";

    [Parameter]
    public string ListClass { get; set; } = "recent-log-list";

    [Parameter]
    public int? MaxItems { get; set; }

    private IEnumerable<SongLinkItem> DisplayItems =>
        MaxItems is int limit ? Items.Take(limit) : Items;
}
