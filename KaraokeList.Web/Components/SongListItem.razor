<button type="button" class="song-list-item" @onclick="() => OnClick.InvokeAsync(Song)">
    <div class="song-list-item-main">
        <div class="song-list-item-title">@Song.Title</div>
        <div class="song-list-item-artist">@Song.ArtistName</div>
    </div>
    <div class="song-list-item-meta">
        @if (!string.IsNullOrWhiteSpace(Song.GenreName))
        {
            <span class="song-list-item-genre">@Song.GenreName</span>
        }
        <span class="song-list-item-date">@Song.LastPerformedOn.ToString("d")</span>
        <span class="song-list-item-count">@Song.PerformanceCount×</span>
    </div>
</button>

@code {
    [Parameter, EditorRequired]
    public RepertoireSongDto Song { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<RepertoireSongDto> OnClick { get; set; }
}
