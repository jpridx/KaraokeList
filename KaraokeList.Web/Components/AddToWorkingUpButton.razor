@inject IKaraokeApiClient Api
@using KaraokeList.Shared

@if (Visible)
{
    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" disabled="@isAdding"
            @onclick="AddAsync">
        Add to working up
    </button>
    @if (pendingCollisions.Count > 0)
    {
        <TitleArtistDuplicateConfirm Collisions="@pendingCollisions"
                                     Disabled="@isAdding"
                                     OnCancel="CancelDuplicateConfirmAsync"
                                     OnConfirm="ConfirmDuplicateAddAsync" />
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <p class="small text-success mt-1 mb-0">@successMessage</p>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="small text-danger mt-1 mb-0">@errorMessage</p>
    }
}

@code {
    [Parameter, EditorRequired]
    public int SongId { get; set; }

    [Parameter]
    public IReadOnlyList<SingerListDto> SingerLists { get; set; } = [];

    [Parameter]
    public bool AlreadyOnWorkingUp { get; set; }

    [Parameter]
    public EventCallback OnAdded { get; set; }

    private bool isAdding;
    private string? successMessage;
    private string? errorMessage;
    private List<(SingerListKind Kind, TitleArtistCollisionDto Collision)> pendingCollisions = [];

    private bool Visible => !AlreadyOnWorkingUp && SingerLists.Count > 0;

    protected override void OnParametersSet()
    {
        if (AlreadyOnWorkingUp)
        {
            successMessage = null;
            errorMessage = null;
        }
    }

    private async Task AddAsync()
    {
        isAdding = true;
        errorMessage = null;
        successMessage = null;
        pendingCollisions = [];

        var collisionCheck = await SingerListActions.CheckTitleArtistCollisionsAsync(
            Api,
            SingerLists,
            SongId,
            [SingerListKind.WorkingUp]);
        if (!collisionCheck.Succeeded)
        {
            errorMessage = collisionCheck.ErrorMessage;
            isAdding = false;
            return;
        }

        if (collisionCheck.HasCollisions)
        {
            pendingCollisions = collisionCheck.Collisions;
            isAdding = false;
            return;
        }

        await ExecuteAddAsync(allowTitleArtistDuplicate: false);
    }

    private Task CancelDuplicateConfirmAsync()
    {
        pendingCollisions = [];
        return Task.CompletedTask;
    }

    private async Task ConfirmDuplicateAddAsync()
    {
        isAdding = true;
        errorMessage = null;
        pendingCollisions = [];

        await ExecuteAddAsync(allowTitleArtistDuplicate: true);
    }

    private async Task ExecuteAddAsync(bool allowTitleArtistDuplicate)
    {
        var result = await SingerListActions.AddSongAsync(
            Api,
            SingerLists,
            SingerListKind.WorkingUp,
            SongId,
            allowTitleArtistDuplicate);

        if (result.Succeeded)
        {
            successMessage = result.SuccessMessage;
            await OnAdded.InvokeAsync();
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        isAdding = false;
    }
}
