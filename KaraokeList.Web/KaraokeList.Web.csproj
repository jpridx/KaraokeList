<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <UserSecretsId>karaokelist-web-local</UserSecretsId>
    <LaunchProfile>https</LaunchProfile>
    <Version>2.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="34.1.29" />
    <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="34.1.29" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KaraokeList.Shared\KaraokeList.Shared.csproj" />
  </ItemGroup>

  <!-- Generated at build; added to Compile by SyncfusionLicense.targets. -->
  <ItemGroup>
    <Compile Remove="SyncfusionLicenseKey.g.cs" />
  </ItemGroup>

  <Import Project="SyncfusionLicense.targets" />

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
