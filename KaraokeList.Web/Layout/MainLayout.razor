@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject JwtAuthenticationStateProvider AuthProvider

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4 justify-content-between">
            <span class="text-muted d-none d-md-inline">KaraokeList</span>
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <span class="text-muted small">@context.User.Identity?.Name</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Sign out</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="ms-auto">
                        <a class="btn btn-sm btn-outline-primary me-2" href="login">Sign in</a>
                        <a class="btn btn-sm btn-primary" href="register">Register</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthProvider.MarkUserAsLoggedOutAsync();
        NavigationManager.NavigateTo("/login");
    }
}
