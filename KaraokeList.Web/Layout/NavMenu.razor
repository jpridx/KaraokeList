@implements IDisposable
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">KaraokeList</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="songs">Songs</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="artists">Artists</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="genres">Genres</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="singers">Singers</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="singer-songs">Singer Songs</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="venues">Venues</NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <span class="nav-link">@context.User.Identity?.Name</span>
                </div>
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link" @onclick="LogoutAsync">Logout</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">Register</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Login</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [Inject]
    private JwtAuthenticationStateProvider AuthProvider { get; set; } = default!;

    private void ToggleNavMenu()
    {
    }

    private async Task LogoutAsync()
    {
        await AuthProvider.MarkUserAsLoggedOutAsync();
        NavigationManager.NavigateTo("/login");
    }

    public void Dispose()
    {
    }
}
